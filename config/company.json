{
  "timezone": "Asia/Taipei",
  "healthCheck": {
    "timeoutMs": 15000,
    "slowResponseMs": 4000,
    "retryAttempts": 3,
    "retryBackoffMs": 1000,
    "userAgent": "FableCompany-HealthCheck/3.0 (+https://funnytools.win)"
  },
  "reporting": {
    "vaultDir": "D:/Fable company/Company Vault",
    "dataDir": "D:/Fable company/data",
    "notifyDiscord": false
  },
  "sites": [
    {
      "id": "funnytools",
      "name": "FunnyTools",
      "baseUrl": "https://funnytools.win",
      "githubRepo": "btcson66-rgb/funnytools-win",
      "localRepo": "D:/funnytools",
      "deployment": {
        "provider": "github-pages",
        "environment": "github-pages",
        "workflowFile": "deploy.yml",
        "deployJobName": "deploy",
        "sourceScope": {
          "mode": "all-main"
        },
        "graceMinutes": 45
      },
      "primaryPath": "/",
      "sitemapPath": "/sitemap.xml",
      "samplePageCount": 6,
      "sampleUrls": [
        "/",
        "/tools/t-score-calculator/",
        "/tools/grade-average/",
        "/tools/teacher-exam-score-converter/",
        "/tools/random-name-picker/",
        "/tools/z-score-calculator/",
        "/support/"
      ],
      "monitorHttpsRedirect": true,
      "sitemapDropAlertPercent": 10,
      "expectations": {
        "expectAdsense": true,
        "expectAdsTxt": true,
        "expectAnalytics": true
      },
      "services": [
        {
          "id": "conversion-api",
          "type": "json-health",
          "url": "https://api.funnytools.win/health",
          "expectStatus": 200,
          "expectJson": {
            "ok": true
          }
        }
      ]
    },
    {
      "id": "roomfeng",
      "name": "RoomFeng",
      "baseUrl": "https://roomfeng.win",
      "githubRepo": "btcson66-rgb/room-layout-fengshui-planner",
      "deployment": {
        "provider": "cloudflare-pages",
        "projectName": "roomfeng-win",
        "productionBranch": "main",
        "workflowFile": "deploy-cloudflare-pages.yml",
        "deployJobName": "deploy",
        "deployStepName": "Deploy to Cloudflare Pages",
        "sourceScope": {
          "mode": "all-main"
        },
        "graceMinutes": 45,
        "cloudflareAccountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
        "cloudflareApiTokenEnv": "CLOUDFLARE_API_TOKEN"
      },
      "primaryPath": "/",
      "sitemapPath": "/sitemap-index.xml",
      "samplePageCount": 6,
      "sampleUrls": [
        "/"
      ],
      "expectations": {
        "expectAdsense": false,
        "expectAdsTxt": true,
        "expectAnalytics": true
      }
    },
    {
      "id": "worthcalc",
      "name": "WorthCalc",
      "baseUrl": "https://worthcalc.win",
      "githubRepo": "btcson66-rgb/worthcalc",
      "deployment": {
        "provider": "github-pages",
        "environment": "github-pages",
        "workflowFile": "deploy-worthcalc.yml",
        "deployJobName": "deploy",
        "sourceScope": {
          "mode": "paths",
          "basis": "workflow-path-filter",
          "pathPrefixes": [
            "sites/worth-it-tools/"
          ],
          "exactPaths": [
            ".github/workflows/deploy-worthcalc.yml"
          ]
        },
        "graceMinutes": 45
      },
      "primaryPath": "/en/",
      "sitemapPath": "/sitemap-index.xml",
      "samplePageCount": 6,
      "sampleUrls": [
        "/en/"
      ],
      "expectations": {
        "expectAdsense": false,
        "expectAdsTxt": false,
        "expectAnalytics": true
      }
    },
    {
      "id": "familyboard",
      "name": "FamilyBoard",
      "baseUrl": "https://familyboard.win",
      "githubRepo": "btcson66-rgb/familyboard",
      "deployment": {
        "provider": "github-pages",
        "environment": "github-pages",
        "workflowFile": "deploy.yml",
        "deployJobName": "deploy",
        "sourceScope": {
          "mode": "all-main"
        },
        "graceMinutes": 45
      },
      "primaryPath": "/",
      "sitemapPath": "/sitemap-index.xml",
      "samplePageCount": 6,
      "sampleUrls": [
        "/",
        "/zh-tw/"
      ],
      "expectations": {
        "expectAdsense": false,
        "expectAdsTxt": false,
        "expectAnalytics": true
      },
      "contractProbes": [
        {
          "id": "private-app-en",
          "path": "/app/",
          "expectStatus": 200,
          "expectNoindex": true,
          "expectAnalytics": false,
          "expectAdsense": false,
          "forbidPatterns": [
            "googletagmanager.com/gtag/js",
            "adsbygoogle",
            "pagead2.googlesyndication.com",
            "doubleclick.net"
          ]
        },
        {
          "id": "private-app-zh",
          "path": "/zh-tw/app/",
          "expectStatus": 200,
          "expectNoindex": true,
          "expectAnalytics": false,
          "expectAdsense": false,
          "forbidPatterns": [
            "googletagmanager.com/gtag/js",
            "adsbygoogle",
            "pagead2.googlesyndication.com",
            "doubleclick.net"
          ]
        }
      ]
    }
  ]
}
