---
import { expansionRouteByKey } from '../../i18n/expansionRoutes';

interface Props {
  currentKey: string;
}

const { currentKey } = Astro.props;
const currentRoute = expansionRouteByKey(currentKey);
const languageLinks = [
  { code: 'zh', label: '繁中', path: currentRoute?.paths.zh },
  { code: 'en', label: 'English', path: currentRoute?.paths.en },
  { code: 'es', label: 'Español', path: currentRoute?.paths.es },
  { code: 'fr', label: 'Français', path: currentRoute?.paths.fr },
].filter((item) => item.path);
---

<header class="site-nav" data-site-header>
  <div class="nav-inner">
    <a class="brand" href="/fr/" aria-label="FunnyTools en français">FunnyTools</a>
    <nav class="nav-links" aria-label="Navigation principale">
      <a href="/fr/">Accueil</a>
      <a href="/fr/outils/calcul-moyenne-notes/">Calculer une moyenne</a>
      <a href="/fr/outils/fusionner-pdf/">Fusionner des PDF</a>
    </nav>
    <span class="language-switches" aria-label="Changer de langue">
      {languageLinks.map((item) => (
        <a
          class="lang-switch"
          href={item.path}
          hreflang={item.code === 'zh' ? 'zh-TW' : item.code}
          lang={item.code === 'zh' ? 'zh-Hant' : item.code}
          aria-current={item.code === 'fr' ? 'page' : undefined}
          data-language-switch
          data-target-lang={item.code}
        >
          {item.label}
        </a>
      ))}
    </span>
    <button class="theme-toggle" type="button" aria-label="Changer de thème" aria-pressed="false" data-theme-toggle>
      <svg class="theme-icon theme-icon--moon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.2 15.6A8.5 8.5 0 0 1 8.4 3.8 8.5 8.5 0 1 0 20.2 15.6Z" /></svg>
      <svg class="theme-icon theme-icon--sun" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.5" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
    <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation-fr" aria-label="Ouvrir le menu" data-menu-toggle>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
    <nav id="mobile-navigation-fr" class="mobile-navigation" aria-label="Navigation mobile" aria-hidden="true" data-mobile-nav hidden>
      <a href="/fr/">Accueil</a>
      <a href="/fr/outils/calcul-moyenne-notes/">Calculer une moyenne</a>
      <a href="/fr/outils/fusionner-pdf/">Fusionner des PDF</a>
      <span class="mobile-languages">
        {languageLinks.map((item) => (
          <a class="lang-switch" href={item.path} hreflang={item.code === 'zh' ? 'zh-TW' : item.code} lang={item.code === 'zh' ? 'zh-Hant' : item.code} data-language-switch data-target-lang={item.code}>
            {item.label}
          </a>
        ))}
      </span>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const themeToggle = document.querySelector('[data-theme-toggle]');
    themeToggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
    themeToggle?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      themeToggle.setAttribute('aria-pressed', String(next === 'dark'));
      try { localStorage.setItem('theme', next); } catch {}
    });
    const toggle = document.querySelector('[data-menu-toggle]');
    const menu = document.querySelector('[data-mobile-nav]');
    const setMenuOpen = (open) => {
      if (!(menu instanceof HTMLElement) || !toggle) return;
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      menu.setAttribute('aria-hidden', String(!open));
    };
    toggle?.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
  })();
</script>

<style>
  .language-switches,
  .mobile-languages {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .language-switches [aria-current="page"] {
    border-color: var(--brand);
    color: var(--brand);
  }
  .mobile-languages {
    flex-wrap: wrap;
    padding-top: 8px;
  }
  @media (max-width: 1100px) {
    .nav-inner > .language-switches {
      display: none;
    }
  }
</style>
