---
import { type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { localePath } from '../lib/url';

interface Props {
  lang: Locale;
  segments?: string[];
}

const { lang, segments = [] } = Astro.props;
const ui = t(lang);
const otherLang: Locale = lang === 'zh' ? 'en' : 'zh';
const languageLinks = [{
  code: otherLang,
  label: otherLang === 'zh' ? '繁中' : 'English',
  path: localePath(otherLang, ...segments),
}];
---

<span class="language-switches">
  {languageLinks.map((item) => (
    <a
      class="lang-switch"
      href={item.path}
      hreflang={item.code === 'zh' ? 'zh-TW' : item.code}
      lang={item.code === 'zh' ? 'zh-Hant' : item.code}
      aria-label={ui.languageSwitch}
      data-language-switch
      data-target-lang={item.code}
    >
      {item.label}
    </a>
  ))}
</span>

<style>
  .language-switches {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
</style>
