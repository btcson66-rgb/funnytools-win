---
import { type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { localePath } from '../lib/url';
import { expansionRouteByPath } from '../i18n/expansionRoutes';

interface Props {
  lang: Locale;
  segments?: string[];
}

const { lang, segments = [] } = Astro.props;
const ui = t(lang);
const expansionRoute = expansionRouteByPath(Astro.url.pathname);
const otherLang: Locale = lang === 'zh' ? 'en' : 'zh';
const languageLinks = expansionRoute
  ? [
      { code: 'zh', label: '繁中', path: expansionRoute.paths.zh },
      { code: 'en', label: 'English', path: expansionRoute.paths.en },
      { code: 'es', label: 'Español', path: expansionRoute.paths.es },
      { code: 'fr', label: 'Français', path: expansionRoute.paths.fr },
    ].filter((item) => item.path && item.code !== lang)
  : [{
      code: otherLang,
      label: otherLang === 'zh' ? '繁中' : 'English',
      path: localePath(otherLang, ...segments),
    }];
---

<span class="language-switches">
  {languageLinks.map((item) => (
    <a
      class="lang-switch"
      href={item.path}
      hreflang={item.code === 'zh' ? 'zh-TW' : item.code}
      lang={item.code === 'zh' ? 'zh-Hant' : item.code}
      aria-label={ui.languageSwitch}
      data-language-switch
      data-target-lang={item.code}
    >
      {item.label}
    </a>
  ))}
</span>

<style>
  .language-switches {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
</style>
