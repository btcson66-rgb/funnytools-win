---
interface Props {
  id?: string;
  adSlot?: string;
}

const { id, adSlot } = Astro.props;
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT ?? import.meta.env.PUBLIC_ADSENSE_ID;
const enabled = Boolean(client && adSlot);
---

{
  enabled && (
    <div class="ad-slot" aria-label="Advertisement" id={id}>
      <ins
        class="adsbygoogle"
        data-ad-client={client}
        data-ad-slot={adSlot}
        data-ad-format="auto"
        data-full-width-responsive="true"
      />
    </div>
  )
}

<script>
  // AdSense fills an <ins> only after one adsbygoogle.push({}) per unit.
  // Astro hoists and dedupes this script, so it runs once per page.
  //
  // Guard against double-initialization: Google Auto Ads can independently
  // discover and claim a manually placed ins.adsbygoogle element before (or
  // after) this script runs. When AdSense claims an <ins>, it marks it with
  // `data-adsbygoogle-status` immediately and/or injects a child element
  // (e.g. an iframe) into it. `data-ad-status` is a *different* attribute
  // that only appears later, once the fill outcome (filled/unfilled) is
  // known — checking it here is too slow to catch the claim and lets this
  // script push() again for an <ins> AdSense already owns, which throws:
  //   "All 'ins' elements in the DOM with class=adsbygoogle already have
  //   ads in them."
  // Checking both signals right before each push covers both orderings
  // (Auto Ads claims first, or this script runs first).
  const w = window as unknown as { adsbygoogle?: unknown[] };
  document.querySelectorAll('ins.adsbygoogle').forEach((ins) => {
    const alreadyClaimed = ins.hasAttribute('data-adsbygoogle-status') || ins.childElementCount > 0;
    if (alreadyClaimed) return;
    (w.adsbygoogle = w.adsbygoogle || []).push({});
  });
</script>

<style>
  /* Reserve vertical space so responsive ads don't push content down (CLS). */
  .ad-slot {
    min-height: 120px;
    display: grid;
    align-items: center;
    border-radius: 12px;
    background: color-mix(in srgb, var(--line) 25%, transparent);
  }

  .ad-slot :global(.adsbygoogle) {
    display: block;
    width: 100%;
  }

  @media (min-width: 768px) {
    .ad-slot {
      min-height: 280px;
    }
  }
</style>
