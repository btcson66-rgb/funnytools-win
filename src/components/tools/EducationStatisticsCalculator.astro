---
interface Props {
  labels: Record<string, string>;
  slug: string;
}

const { labels, slug } = Astro.props;
const simpleFields: Record<string, { key: string; value: string; step?: string }[]> = {
  'percentile-rank-calculator': [
    { key: 'below', value: '24', step: '1' }, { key: 'equal', value: '1', step: '1' }, { key: 'total', value: '40', step: '1' },
  ],
  'z-score-calculator': [
    { key: 'score', value: '82' }, { key: 'mean', value: '70' }, { key: 'sd', value: '10' }, { key: 'z', value: '' },
  ],
  't-score-calculator': [
    { key: 'score', value: '82' }, { key: 'mean', value: '70' }, { key: 'sd', value: '10' }, { key: 'z', value: '' },
  ],
  'class-rank-percentile-calculator': [
    { key: 'rank', value: '6', step: '1' }, { key: 'total', value: '40', step: '1' }, { key: 'tied', value: '1', step: '1' },
  ],
  'normalized-score-converter': [
    { key: 'score', value: '82' }, { key: 'mean', value: '70' }, { key: 'sd', value: '10' },
    { key: 'targetMean', value: '50' }, { key: 'targetSd', value: '10' },
  ],
};
const fields = simpleFields[slug] ?? [];
---

<section class="tool-widget card education-stat-tool" data-stat-tool data-slug={slug} data-labels={JSON.stringify(labels)}>
  {fields.length > 0 && (
    <div class="form-grid stat-form-grid">
      {fields.map((field) => (
        <label>
          <span>{labels[field.key]}</span>
          <input data-field={field.key} type="number" inputmode="decimal" step={field.step ?? 'any'} value={field.value} />
        </label>
      ))}
    </div>
  )}

  {slug === 'weighted-average-calculator' && <div class="stat-rows" data-rows></div>}

  {slug === 'teacher-exam-score-converter' && (
    <div class="exam-grid">
      {[
        ['written', 'writtenWeight', '78', '40'],
        ['teaching', 'teachingWeight', '85', '30'],
        ['interview', 'interviewWeight', '82', '30'],
      ].map(([score, weight, scoreValue, weightValue]) => (
        <fieldset>
          <legend>{labels[score]}</legend>
          <label><span>{labels[score]}</span><input data-field={score} type="number" step="any" value={scoreValue} /></label>
          <label><span>{labels[weight]}</span><input data-field={weight} type="number" min="0" step="any" value={weightValue} /></label>
        </fieldset>
      ))}
    </div>
  )}

  {slug === 'cronbach-alpha-calculator' && (
    <label class="textarea-label">
      <span>{labels.data}</span>
      <textarea data-field="data" rows="8">4,3,4,5
3,3,4,4
5,4,5,5
2,3,2,3
4,4,3,4</textarea>
    </label>
  )}

  {slug === 'independent-samples-t-test-calculator' && labels.method && (
    <label class="ttest-method">
      <span>{labels.method}</span>
      <select data-field="method">
        <option value="welch" selected>{labels.methodWelch}</option>
        <option value="student">{labels.methodStudent}</option>
      </select>
    </label>
  )}

  {slug === 'independent-samples-t-test-calculator' && (
    <div class="ttest-grid">
      {['1', '2'].map((group, index) => (
        <fieldset>
          <legend>{labels[`group${group}`]}</legend>
          <label><span>{labels.n}</span><input data-field={`n${group}`} type="number" min="2" step="1" value={index === 0 ? '30' : '32'} /></label>
          <label><span>{labels.mean}</span><input data-field={`mean${group}`} type="number" step="any" value={index === 0 ? '78.4' : '73.1'} /></label>
          <label><span>{labels.sd}</span><input data-field={`sd${group}`} type="number" min="0" step="any" value={index === 0 ? '8.2' : '9.5'} /></label>
        </fieldset>
      ))}
    </div>
  )}

  <div class="actions stat-actions">
    {slug === 'weighted-average-calculator' && <button class="btn ghost" type="button" data-add>{labels.add}</button>}
    {slug === 'teacher-exam-score-converter' && <button class="btn ghost" type="button" data-preset="hs">{labels.presetHs}</button>}
    {slug === 'teacher-exam-score-converter' && <button class="btn ghost" type="button" data-preset="tp">{labels.presetTaipei}</button>}
    <button class="btn" type="button" data-calculate>{labels.calculate}</button>
    {slug === 'teacher-exam-score-converter' && <button class="btn ghost" type="button" data-normalize>{labels.autoNormalize}</button>}
    {slug === 'teacher-exam-score-converter' && <button class="btn ghost" type="button" data-copy>{labels.copyResult}</button>}
  </div>

  <p class="form-error" data-error role="alert" hidden></p>
  {slug === 'teacher-exam-score-converter' && <p class="form-error" data-warning role="status" hidden></p>}
  <div class="resultbox stat-results" data-results aria-live="polite" hidden></div>
  {slug === 'teacher-exam-score-converter' && <span class="toast" role="status" aria-live="polite" hidden>{labels.copied}</span>}
</section>

<style>
  .stat-form-grid { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  .stat-actions { margin-top: 18px; }
  .stat-rows { display: grid; gap: 10px; }
  /* Rows are created by the script, so the scoped selector needs :global(). */
  .stat-rows :global(.stat-row) { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; }
  /* Keep the field captions only on the first row (still available to screen readers) so a 5-row default fits above the fold. */
  .stat-rows :global(.stat-row:not(:first-child) label > span) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .exam-grid, .ttest-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .ttest-grid { grid-template-columns: repeat(2, 1fr); }
  fieldset { display: grid; gap: 12px; margin: 0; padding: 16px; border: 1px solid var(--line); border-radius: 14px; }
  legend { padding: 0 6px; color: var(--ink); font-weight: 900; }
  .stat-results { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
  .stat-result-item { display: grid; gap: 6px; }
  .stat-result-item span { color: var(--muted); font-size: .9rem; font-weight: 800; }
  .stat-result-item strong { color: var(--ink); font-size: 1.35rem; font-variant-numeric: tabular-nums; }
  .stat-result-item.stat-wide { grid-column: 1 / -1; }
  .stat-result-item.stat-wide strong { font-size: 1.05rem; font-weight: 700; line-height: 1.5; overflow-wrap: anywhere; }
  .ttest-method { display: grid; gap: 6px; margin-bottom: 14px; max-width: 420px; }
  .ttest-method select { min-height: 44px; }
  @media (max-width: 760px) {
    .exam-grid, .ttest-grid { grid-template-columns: 1fr; }
    .stat-rows :global(.stat-row) { grid-template-columns: 1fr 1fr; }
    .stat-rows :global(.stat-row .btn) { grid-column: 1 / -1; }
  }
</style>

<script>
  import { formatApaP, independentTTest, normalCdf, percentileRankMidpoint, rankPercentile, roundHalfUp, tScoreFrom, weightedMean } from '../../lib/educationStats';

  document.querySelectorAll('[data-stat-tool]').forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const slug = root.dataset.slug || '';
    const labels = JSON.parse(root.dataset.labels || '{}');
    const error = root.querySelector('[data-error]');
    const results = root.querySelector('[data-results]');
    const warning = root.querySelector('[data-warning]');
    const toast = root.querySelector('.toast');
    const rows = root.querySelector('[data-rows]');
    let latestText = '';

    const field = (key) => {
      const input = root.querySelector(`[data-field="${key}"]`);
      return input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement || input instanceof HTMLSelectElement ? input : null;
    };
    const number = (key) => {
      const raw = field(key)?.value.trim() ?? '';
      return raw === '' ? Number.NaN : Number(raw);
    };
    const finite = (...values) => values.every(Number.isFinite);
    const format = (value, digits = 3) => Number(value).toFixed(digits).replace(/\.0+$|(?<=\.\d*[1-9])0+$/g, '');
    const showError = () => {
      if (error instanceof HTMLElement) { error.textContent = labels.invalid; error.hidden = false; }
      if (results instanceof HTMLElement) results.hidden = true;
      if (warning instanceof HTMLElement) warning.hidden = true;
      latestText = '';
    };
    const invalidate = () => {
      if (results instanceof HTMLElement) {
        results.hidden = true;
        results.innerHTML = '';
      }
      if (error instanceof HTMLElement) error.hidden = true;
      if (warning instanceof HTMLElement) warning.hidden = true;
      latestText = '';
    };
    const show = (items) => {
      if (!(results instanceof HTMLElement)) return;
      results.innerHTML = items.map(([label, value, wide]) => `<div class="stat-result-item${wide ? ' stat-wide' : ''}"><span>${label}</span><strong>${value}</strong></div>`).join('');
      results.hidden = false;
      if (error instanceof HTMLElement) error.hidden = true;
      latestText = items.map(([label, value]) => `${label}: ${value}`).join('\n');
    };
    const showTeacher = (items, breakdown) => {
      if (!(results instanceof HTMLElement)) return;
      results.innerHTML = `${items.map(([label, value]) => `<div class="stat-result-item"><span>${label}</span><strong>${value}</strong></div>`).join('')}<div class="stat-result-item stat-breakdown"><span>${labels.breakdown || 'Breakdown'}</span><strong>${breakdown}</strong></div>`;
      results.hidden = false;
      if (error instanceof HTMLElement) error.hidden = true;
      latestText = `${items.map(([label, value]) => `${label}: ${value}`).join('\n')}\n${labels.breakdown || 'Breakdown'}: ${breakdown}`;
    };

    const addWeightedRow = (value = '', weight = '') => {
      if (!(rows instanceof HTMLElement)) return;
      const row = document.createElement('div');
      row.className = 'stat-row';
      row.innerHTML = `<label><span>${labels.value}</span><input data-value type="number" step="any" value="${value}"></label><label><span>${labels.weight}</span><input data-weight type="number" min="0" step="any" value="${weight}"></label><button class="btn ghost" type="button" data-remove>${labels.remove}</button>`;
      row.querySelector('[data-remove]')?.addEventListener('click', () => {
        row.remove();
        invalidate();
      });
      rows.append(row);
    };

    const calculate = () => {
      if (slug === 'percentile-rank-calculator') {
        const below = number('below'), equal = number('equal'), total = number('total');
        const pr = percentileRankMidpoint(below, equal, total);
        if (pr === null) return showError();
        const items = [[labels.result, format(pr, 2)]];
        if (labels.belowPercent) items.push([labels.belowPercent, `${format(100 * below / total, 2)}%`]);
        if (labels.tiedPercent) items.push([labels.tiedPercent, `${format(100 * equal / total, 2)}%`]);
        if (labels.abovePercent) items.push([labels.abovePercent, `${format(100 * (total - below - equal) / total, 2)}%`]);
        return show(items);
      }
      if (slug === 'z-score-calculator') {
        const zRaw = field('z')?.value.trim() ?? '';
        const result = zRaw !== ''
          ? tScoreFrom({ z: number('z') })
          : tScoreFrom({ score: number('score'), mean: number('mean'), sd: number('sd') });
        if (!result) return showError();
        const items = [[labels.result, format(result.z, 3)]];
        if (labels.distanceFromMean) items.push([labels.distanceFromMean, `${format(Math.abs(result.z), 3)} ${labels.sdUnit || ''}`.trim()]);
        if (labels.relativePosition) {
          const position = result.z > 0 ? labels.aboveMean : result.z < 0 ? labels.belowMean : labels.atMean;
          if (position) items.push([labels.relativePosition, position]);
        }
        if (labels.cumulative) items.push([labels.cumulative, `${format(result.normalPr, 2)}%`]);
        if (labels.upperTail) items.push([labels.upperTail, `${format(100 * normalCdf(-result.z), 2)}%`]);
        if (labels.tEquivalent) items.push([labels.tEquivalent, format(result.t, 2)]);
        return show(items);
      }
      if (slug === 't-score-calculator') {
        const zRaw = field('z')?.value.trim() ?? '';
        const result = zRaw !== ''
          ? tScoreFrom({ z: number('z') })
          : tScoreFrom({ score: number('score'), mean: number('mean'), sd: number('sd') });
        if (!result) return showError();
        const items = [[labels.zEquivalent, format(result.z, 3)], [labels.result, format(result.t, 2)]];
        if (labels.approxPr) items.push([labels.approxPr, format(result.normalPr, 2)]);
        if (labels.relativePosition) {
          const position = result.z > 0 ? labels.aboveMean : result.z < 0 ? labels.belowMean : labels.atMean;
          if (position) items.push([labels.relativePosition, position]);
        }
        return show(items);
      }
      if (slug === 'class-rank-percentile-calculator') {
        const rank = number('rank'), total = number('total');
        const tiedRaw = field('tied')?.value.trim() ?? '';
        const tied = tiedRaw === '' ? 1 : Number(tiedRaw);
        const result = rankPercentile(rank, total, tied);
        if (!result) return showError();
        const items = [[labels.result, format(result.pr, 2)], [labels.top, `${format(result.topPercent, 2)}%`]];
        if (labels.peopleAhead) items.push([labels.peopleAhead, String(result.ahead)]);
        if (labels.peopleBehind) items.push([labels.peopleBehind, String(result.behind)]);
        return show(items);
      }
      if (slug === 'normalized-score-converter') {
        const score = number('score'), mean = number('mean'), sd = number('sd'), targetMean = number('targetMean'), targetSd = number('targetSd');
        if (!finite(score, mean, sd, targetMean, targetSd) || sd <= 0 || targetSd <= 0) return showError();
        const z = (score - mean) / sd;
        const items = [[labels.zResult, format(z, 3)], [labels.result, format(targetMean + z * targetSd, 3)]];
        if (labels.originalOffset) items.push([labels.originalOffset, format(score - mean, 3)]);
        if (labels.targetOffset) items.push([labels.targetOffset, format(z * targetSd, 3)]);
        if (labels.scaleFactor) items.push([labels.scaleFactor, format(targetSd / sd, 4)]);
        return show(items);
      }
      if (slug === 'weighted-average-calculator') {
        const parsed = Array.from(root.querySelectorAll('.stat-row')).map((row) => {
          const valueInput = row.querySelector('[data-value]');
          const weightInput = row.querySelector('[data-weight]');
          const valueRaw = valueInput instanceof HTMLInputElement ? valueInput.value.trim() : '';
          const weightRaw = weightInput instanceof HTMLInputElement ? weightInput.value.trim() : '';
          if (!valueRaw && !weightRaw) return null;
          if (!valueRaw || !weightRaw) return { invalid: true, value: NaN, weight: NaN };
          const value = Number(valueRaw);
          const weight = Number(weightRaw);
          return { invalid: !Number.isFinite(value) || !Number.isFinite(weight) || weight <= 0, value, weight };
        });
        if (parsed.some((row) => row?.invalid)) return showError();
        const valid = parsed.filter((row) => row !== null);
        if (!valid.length) return showError();
        const summary = weightedMean(valid.map((row) => ({ value: row.value, weight: row.weight })));
        if (!summary) return showError();
        const items = [[labels.weightTotal, format(summary.weightTotal, 3)], [labels.weightedSum, format(summary.weightedSum, 3)], [labels.result, format(summary.mean, 3)]];
        if (labels.rounded1) items.push([labels.rounded1, roundHalfUp(summary.mean, 1).toFixed(1)]);
        if (labels.simpleMean) items.push([labels.simpleMean, format(summary.simpleMean, 3)]);
        return show(items);
      }
      if (slug === 'teacher-exam-score-converter') {
        const scoreKeys = ['written', 'teaching', 'interview'];
        const values = scoreKeys.map((key) => ({ score: number(key), weight: number(`${key}Weight`) }));
        if (values.some(({ score, weight }) => !finite(score, weight) || weight < 0) || !values.some(({ weight }) => weight > 0)) return showError();
        const weightTotal = values.reduce((sum, row) => sum + row.weight, 0);
        const total = values.reduce((sum, row) => sum + row.score * row.weight, 0) / weightTotal;
        if (warning instanceof HTMLElement) {
          warning.textContent = Math.abs(weightTotal - 100) > 0.0001 ? (labels.weightWarning || `Weights total ${format(weightTotal, 2)}%, not 100%.`) : '';
          warning.hidden = Math.abs(weightTotal - 100) <= 0.0001;
        }
        const weightedParts = scoreKeys.map((key, index) => `${labels[key]} ${format(values[index].score, 2)} × ${format(values[index].weight, 2)}%`).join(' + ');
        const teacherItems = [[labels.weightTotal, `${format(weightTotal, 2)}%`], [labels.result, format(total, 3)]];
        if (labels.rounded2) teacherItems.push([labels.rounded2, roundHalfUp(total, 2).toFixed(2)]);
        return showTeacher(teacherItems, `${weightedParts} ÷ ${format(weightTotal, 2)}`);
      }
      if (slug === 'cronbach-alpha-calculator') {
        const raw = field('data')?.value.trim() || '';
        const parseRow = (line) => {
          const trimmed = line.trim();
          if (trimmed.includes(';')) return trimmed.split(';').map((cell) => Number(cell.trim().replace(',', '.')));
          if (trimmed.includes('\t')) return trimmed.split('\t').map((cell) => Number(cell.trim().replace(',', '.')));
          if (/\s/.test(trimmed)) return trimmed.split(/\s+/).map((cell) => Number(cell.replace(',', '.')));
          return trimmed.split(',').map((cell) => Number(cell.trim()));
        };
        const matrix = raw.split(/\r?\n/).filter((line) => line.trim()).map(parseRow);
        const columnCount = matrix[0]?.length || 0;
        if (matrix.length < 2 || columnCount < 2 || matrix.some((row) => row.length !== columnCount || row.some((value) => !Number.isFinite(value)))) return showError();
        const variance = (values) => {
          const mean = values.reduce((sum, value) => sum + value, 0) / values.length;
          return values.reduce((sum, value) => sum + (value - mean) ** 2, 0) / (values.length - 1);
        };
        const itemVarianceSum = Array.from({ length: columnCount }, (_, column) => variance(matrix.map((row) => row[column]))).reduce((a, b) => a + b, 0);
        const totals = matrix.map((row) => row.reduce((a, b) => a + b, 0));
        const totalVariance = variance(totals);
        if (!(totalVariance > 0)) return showError();
        const alpha = columnCount / (columnCount - 1) * (1 - itemVarianceSum / totalVariance);
        const items = [[labels.respondents, String(matrix.length)], [labels.items, String(columnCount)], [labels.result, format(alpha, 3)]];
        if (labels.totalMean) items.push([labels.totalMean, format(totals.reduce((sum, value) => sum + value, 0) / totals.length, 3)]);
        if (labels.totalSd) items.push([labels.totalSd, format(Math.sqrt(totalVariance), 3)]);
        return show(items);
      }
      if (slug === 'independent-samples-t-test-calculator') {
        const n1 = number('n1'), n2 = number('n2'), mean1 = number('mean1'), mean2 = number('mean2'), sd1 = number('sd1'), sd2 = number('sd2');
        const method = field('method')?.value === 'student' ? 'student' : 'welch';
        const r = independentTTest({ n1, mean1, sd1, n2, mean2, sd2 }, method);
        if (!r) return showError();
        const pText = r.p < 0.001 ? '< .001' : r.p >= 0.9995 ? '> .999' : format(r.p, 3).replace(/^0/, '');
        const items = [[labels.difference, format(r.difference, 3)], [labels.result, format(r.t, 3)], [labels.df, format(r.df, 2)], [labels.p, pText]];
        if (labels.standardError) items.push([labels.standardError, format(r.standardError, 3)]);
        if (labels.confidenceInterval) items.push([labels.confidenceInterval, `[${format(r.ciLower, 3)}, ${format(r.ciUpper, 3)}]`]);
        if (labels.hedgesG && Number.isFinite(r.hedgesG)) items.push([labels.hedgesG, format(r.hedgesG, 3)]);
        if (labels.apaLine) {
          const prefix = method === 'welch' ? 'Welch t' : 't';
          const df = Number.isInteger(r.df) ? String(r.df) : r.df.toFixed(2);
          items.push([labels.apaLine, `${prefix}(${df}) = ${r.t.toFixed(2)}, ${formatApaP(r.p)}, 95% CI [${r.ciLower.toFixed(2)}, ${r.ciUpper.toFixed(2)}], g = ${r.hedgesG.toFixed(2)}`, true]);
        }
        return show(items);
      }
    };

    root.querySelector('[data-calculate]')?.addEventListener('click', calculate);
    root.addEventListener('input', invalidate);
    root.querySelector('[data-add]')?.addEventListener('click', () => {
      addWeightedRow();
      invalidate();
    });
    root.querySelectorAll('[data-preset]').forEach((button) => button.addEventListener('click', () => {
      // hs = Ministry-commissioned senior-high Chinese (written 40 / demo 30 / oral 30); tp = Taipei second stage (demo 60 / oral 40, written not counted)
      const presets = {
        hs: { writtenWeight: '40', teachingWeight: '30', interviewWeight: '30' },
        tp: { writtenWeight: '0', teachingWeight: '60', interviewWeight: '40' },
      };
      const chosen = presets[button instanceof HTMLElement ? button.dataset.preset || '' : ''];
      if (!chosen) return;
      Object.entries(chosen).forEach(([key, value]) => {
        const input = field(key);
        if (input) input.value = value;
      });
      calculate();
    }));
    root.querySelector('[data-normalize]')?.addEventListener('click', () => {
      const weightKeys = ['writtenWeight', 'teachingWeight', 'interviewWeight'];
      const weights = weightKeys.map((key) => number(key));
      const weightTotal = weights.reduce((sum, value) => sum + value, 0);
      if (!finite(...weights) || weightTotal <= 0) return showError();
      weightKeys.forEach((key, index) => {
        const input = field(key);
        if (input) input.value = format(weights[index] / weightTotal * 100, 4);
      });
      calculate();
    });
    root.querySelector('[data-copy]')?.addEventListener('click', async () => {
      if (!latestText) return;
      try {
        await navigator.clipboard.writeText(latestText);
        if (toast instanceof HTMLElement) {
          toast.hidden = false;
          window.setTimeout(() => { toast.hidden = true; }, 1500);
        }
      } catch {
        window.prompt(labels.copyResult || labels.calculate, latestText);
      }
    });
    if (slug === 'weighted-average-calculator') {
      // Defaults are worked example 1 on the page: 5 senior-high courses (score, credits).
      [['78', '4'], ['85', '4'], ['72', '4'], ['90', '3'], ['95', '2']].forEach(([value, weight]) => addWeightedRow(value, weight));
    }
    calculate();
  });
</script>
