---
interface Props {
  labels: Record<string, string>;
}

const { labels } = Astro.props;
---

<section class="tool-widget card" data-business-days-tool data-labels={JSON.stringify(labels)}>
  <div class="form-grid">
    <label>
      <span>{labels.startDate}</span>
      <input data-start type="date" />
    </label>
    <label>
      <span>{labels.endDate}</span>
      <input data-end type="date" />
    </label>
    <label class="check inline-toggle">
      <input data-include-end type="checkbox" checked />
      <span>{labels.includeEndDate}</span>
    </label>
  </div>
  <div class="option-row">
    <label class="check">
      <input data-skip-weekends type="checkbox" checked />
      <span>{labels.skipWeekends}</span>
    </label>
  </div>
  <div class="form-grid preset-row">
    <label>
      <span>{labels.holidayPreset}</span>
      <select data-holiday-preset>
        <option value="">{labels.presetNone}</option>
        <option value="tw2026">{labels.presetTw2026}</option>
      </select>
    </label>
  </div>
  <label class="textarea-label compact-textarea">
    <span>{labels.holidays}</span>
    <textarea data-holidays rows="4" placeholder={labels.holidayPlaceholder}></textarea>
  </label>
  <div class="actions">
    <button class="btn go" type="button" data-calculate>{labels.calculate}</button>
    <button class="btn" type="button" data-copy>{labels.copyResult}</button>
    <button class="btn ghost" type="button" data-reset>{labels.reset}</button>
  </div>
  <p class="form-error" data-error role="alert" hidden></p>
  <p class="note" data-warning role="status" aria-live="polite" hidden></p>
  <div class="stats-grid business-stats" aria-live="polite">
    <div><span>{labels.businessDays}</span><strong data-business>0</strong></div>
    <div><span>{labels.totalCalendarDays}</span><strong data-total>0</strong></div>
    <div><span>{labels.weekendDays}</span><strong data-weekends>0</strong></div>
    <div><span>{labels.holidayDays}</span><strong data-holidays-count>0</strong></div>
    <div class="wide-stat"><span>{labels.countedRange}</span><strong data-range>-</strong></div>
  </div>
  <span class="toast" role="status" aria-live="polite" hidden>{labels.copied}</span>
</section>

<style>
  .inline-toggle {
    align-self: end;
    min-height: 48px;
  }

  .preset-row {
    grid-template-columns: minmax(220px, 320px);
    margin-bottom: 12px;
  }

  .compact-textarea textarea {
    min-height: 118px;
  }

  .business-stats {
    margin-top: 18px;
  }

  .wide-stat {
    grid-column: span 2;
  }

  .business-stats strong {
    font-size: 1.25rem;
  }

  @media (max-width: 760px) {
    .wide-stat {
      grid-column: auto;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-business-days-tool]').forEach((root) => {
    const labels = JSON.parse(root.getAttribute('data-labels') || '{}');
    const startInput = root.querySelector('[data-start]');
    const endInput = root.querySelector('[data-end]');
    const includeEndInput = root.querySelector('[data-include-end]');
    const skipWeekendsInput = root.querySelector('[data-skip-weekends]');
    const holidaysInput = root.querySelector('[data-holidays]');
    const presetInput = root.querySelector('[data-holiday-preset]');
    const error = root.querySelector('[data-error]');
    const warning = root.querySelector('[data-warning]');

    // 台灣 2026（民國115年）國定假日與補假之平日（不含一般週末）。
    // 來源：行政院人事行政總處核定之 115 年政府行政機關辦公日曆表。
    const holidayPresets = {
      tw2026: [
        '2026-01-01', // 元旦
        '2026-02-16', '2026-02-17', '2026-02-18', '2026-02-19', '2026-02-20', // 農曆春節
        '2026-02-27', // 和平紀念日（2/28 週六）補假
        '2026-04-03', // 兒童節（4/4 週六）補假
        '2026-04-06', // 清明節（4/5 週日）補假
        '2026-05-01', // 勞動節
        '2026-06-19', // 端午節
        '2026-09-25', // 中秋節
        '2026-09-28', // 教師節
        '2026-10-09', // 國慶日（10/10 週六）補假
        '2026-10-26', // 臺灣光復節（10/25 週日）補假
        '2026-12-25', // 行憲紀念日
      ],
    };
    const toast = root.querySelector('.toast');
    const outputs = {
      business: root.querySelector('[data-business]'),
      total: root.querySelector('[data-total]'),
      weekends: root.querySelector('[data-weekends]'),
      holidays: root.querySelector('[data-holidays-count]'),
      range: root.querySelector('[data-range]'),
    };
    let latestText = '';

    const DAY_MS = 86400000;

    function utcDate(year, monthIndex, day) {
      const date = new Date(0);
      date.setUTCHours(0, 0, 0, 0);
      date.setUTCFullYear(year, monthIndex, day);
      return date;
    }

    function dateOnly(value) {
      const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || '');
      if (!match) return null;
      const year = Number(match[1]);
      const month = Number(match[2]);
      const day = Number(match[3]);
      const date = utcDate(year, month - 1, day);
      if (
        date.getUTCFullYear() !== year
        || date.getUTCMonth() !== month - 1
        || date.getUTCDate() !== day
      ) return null;
      return date;
    }

    function dateString(date) {
      return date.toISOString().slice(0, 10);
    }

    function todayString() {
      const today = new Date();
      return [
        String(today.getFullYear()).padStart(4, '0'),
        String(today.getMonth() + 1).padStart(2, '0'),
        String(today.getDate()).padStart(2, '0'),
      ].join('-');
    }

    function addDays(date, days) {
      const next = new Date(date);
      next.setUTCDate(next.getUTCDate() + days);
      return next;
    }

    function setError(message) {
      error.textContent = message;
      error.hidden = !message;
    }

    function setWarning(message) {
      warning.textContent = message;
      warning.hidden = !message;
    }

    function clearResults() {
      outputs.business.textContent = '0';
      outputs.total.textContent = '0';
      outputs.weekends.textContent = '0';
      outputs.holidays.textContent = '0';
      outputs.range.textContent = '-';
      latestText = '';
    }

    function holidayValues(value) {
      const dates = new Set();
      let invalidCount = 0;
      value
        .split(/\r\n|\r|\n/)
        .map((line) => line.trim())
        .filter(Boolean)
        .forEach((line) => {
          if (!dateOnly(line)) invalidCount += 1;
          else dates.add(line);
        });
      return { dates, invalidCount };
    }

    function daysText(value) {
      return `${value} ${value === 1 ? (labels.daySingular || labels.days) : labels.days}`;
    }

    function calculate() {
      const rawStart = dateOnly(startInput.value);
      const rawEnd = dateOnly(endInput.value);
      if (!rawStart || !rawEnd) {
        clearResults();
        setError(labels.invalidDate);
        setWarning('');
        return;
      }
      let start = rawStart;
      let end = rawEnd;
      if (start > end) [start, end] = [end, start];
      const endExclusive = includeEndInput.checked ? addDays(end, 1) : end;
      const totalDays = Math.max(0, Math.round((endExclusive.getTime() - start.getTime()) / DAY_MS));
      const { dates: holidays, invalidCount } = holidayValues(holidaysInput.value);
      const skipWeekends = skipWeekendsInput.checked;
      let weekendDays = 0;
      let holidayDays = 0;
      let businessDays = 0;

      for (let index = 0; index < totalDays; index += 1) {
        const current = addDays(start, index);
        const isWeekend = current.getUTCDay() === 0 || current.getUTCDay() === 6;
        const isHoliday = holidays.has(dateString(current));
        if (isWeekend) weekendDays += 1;
        if (isHoliday && !(skipWeekends && isWeekend)) holidayDays += 1;
        if (!(skipWeekends && isWeekend) && !isHoliday) businessDays += 1;
      }

      outputs.business.textContent = daysText(businessDays);
      outputs.total.textContent = daysText(totalDays);
      outputs.weekends.textContent = daysText(weekendDays);
      outputs.holidays.textContent = daysText(holidayDays);
      outputs.range.textContent = `${dateString(start)} - ${dateString(end)}`;
      latestText = [
        `${labels.countedRange}: ${dateString(start)} - ${dateString(end)}`,
        `${labels.businessDays}: ${daysText(businessDays)}`,
        `${labels.totalCalendarDays}: ${daysText(totalDays)}`,
        `${labels.weekendDays}: ${daysText(weekendDays)}`,
        `${labels.holidayDays}: ${daysText(holidayDays)}`,
      ].join('\n');
      setError('');
      setWarning(
        invalidCount > 0
          ? (
            invalidCount === 1
              ? (labels.holidayWarningSingular || labels.holidayWarning || '')
              : (labels.holidayWarning || '')
          ).replace('{count}', String(invalidCount))
          : '',
      );
    }

    function reset() {
      const today = dateOnly(todayString());
      startInput.value = dateString(today);
      endInput.value = dateString(addDays(today, 14));
      includeEndInput.checked = true;
      skipWeekendsInput.checked = true;
      holidaysInput.value = '';
      calculate();
    }

    function showToast() {
      toast.hidden = false;
      window.setTimeout(() => {
        toast.hidden = true;
      }, 1500);
    }

    root.querySelector('[data-calculate]')?.addEventListener('click', calculate);
    root.querySelector('[data-reset]')?.addEventListener('click', reset);
    root.querySelector('[data-copy]')?.addEventListener('click', async () => {
      if (!latestText) calculate();
      if (!latestText) return;
      try {
        await navigator.clipboard.writeText(latestText);
        showToast();
      } catch {
        window.prompt(labels.copyResult, latestText);
      }
    });
    [startInput, endInput, includeEndInput, skipWeekendsInput, holidaysInput].forEach((input) => input.addEventListener('input', calculate));
    [includeEndInput, skipWeekendsInput].forEach((input) => input.addEventListener('change', calculate));
    presetInput?.addEventListener('change', () => {
      const preset = holidayPresets[presetInput.value];
      if (!preset) return;
      const existing = Array.from(holidayValues(holidaysInput.value).dates);
      const merged = Array.from(new Set([...existing, ...preset])).sort();
      holidaysInput.value = merged.join('\n');
      presetInput.value = '';
      calculate();
    });

    reset();
  });
</script>

