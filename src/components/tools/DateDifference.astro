---
interface Props {
  labels: Record<string, string>;
}

const { labels } = Astro.props;
---

<section class="tool-widget card" data-date-difference-tool data-labels={JSON.stringify(labels)}>
  <div class="form-grid">
    <label>
      <span>{labels.startDate}</span>
      <input data-start type="date" />
    </label>
    <label>
      <span>{labels.endDate}</span>
      <input data-end type="date" />
    </label>
    <label class="check inline-toggle">
      <input data-include-end type="checkbox" />
      <span>{labels.includeEnd}</span>
    </label>
  </div>
  <div class="actions">
    <button class="btn go" type="button" data-calculate>{labels.calculate}</button>
    <button class="btn ghost" type="button" data-copy>{labels.copyResult}</button>
  </div>
  <p class="form-error" data-error role="alert" hidden></p>
  <div class="stats-grid date-results" aria-live="polite">
    <div><span>{labels.totalDays}</span><strong data-total>0</strong></div>
    <div><span>{labels.weeks}</span><strong data-weeks>0</strong></div>
    <div><span>{labels.months}</span><strong data-months>0</strong></div>
    <div><span>{labels.breakdown}</span><strong data-breakdown>0</strong></div>
    <div><span>{labels.weekdays}</span><strong data-weekdays>0</strong></div>
    <div><span>{labels.weekends}</span><strong data-weekends>0</strong></div>
  </div>
  <span class="toast" role="status" aria-live="polite" hidden>{labels.copied}</span>
</section>

<style>
  .inline-toggle {
    align-self: end;
    min-height: 48px;
  }

  .date-results {
    margin-top: 18px;
  }

  .date-results strong {
    font-size: 1.25rem;
  }
</style>

<script>
  document.querySelectorAll('[data-date-difference-tool]').forEach((root) => {
    const labels = JSON.parse(root.getAttribute('data-labels') || '{}');
    const startInput = root.querySelector('[data-start]');
    const endInput = root.querySelector('[data-end]');
    const includeEndInput = root.querySelector('[data-include-end]');
    const error = root.querySelector('[data-error]');
    const toast = root.querySelector('.toast');
    const outputs = {
      total: root.querySelector('[data-total]'),
      weeks: root.querySelector('[data-weeks]'),
      months: root.querySelector('[data-months]'),
      breakdown: root.querySelector('[data-breakdown]'),
      weekdays: root.querySelector('[data-weekdays]'),
      weekends: root.querySelector('[data-weekends]'),
    };
    let latestText = '';

    const DAY_MS = 86400000;

    function utcDate(year, monthIndex, day) {
      const date = new Date(0);
      date.setUTCHours(0, 0, 0, 0);
      date.setUTCFullYear(year, monthIndex, day);
      return date;
    }

    function dateOnly(value) {
      const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || '');
      if (!match) return null;
      const year = Number(match[1]);
      const month = Number(match[2]);
      const day = Number(match[3]);
      const date = utcDate(year, month - 1, day);
      if (
        date.getUTCFullYear() !== year
        || date.getUTCMonth() !== month - 1
        || date.getUTCDate() !== day
      ) return null;
      return date;
    }

    function dateString(date) {
      return date.toISOString().slice(0, 10);
    }

    function todayString() {
      const today = new Date();
      return [
        String(today.getFullYear()).padStart(4, '0'),
        String(today.getMonth() + 1).padStart(2, '0'),
        String(today.getDate()).padStart(2, '0'),
      ].join('-');
    }

    function addDays(date, days) {
      const copy = new Date(date);
      copy.setUTCDate(copy.getUTCDate() + days);
      return copy;
    }

    function addMonths(date, months) {
      const targetIndex = date.getUTCFullYear() * 12 + date.getUTCMonth() + months;
      const targetYear = Math.floor(targetIndex / 12);
      const targetMonth = ((targetIndex % 12) + 12) % 12;
      const lastDay = utcDate(targetYear, targetMonth + 1, 0).getUTCDate();
      return utcDate(targetYear, targetMonth, Math.min(date.getUTCDate(), lastDay));
    }

    function dayDifference(start, end) {
      return Math.round((end.getTime() - start.getTime()) / DAY_MS);
    }

    function unit(value, singularKey, pluralKey) {
      const label = value === 1 ? labels[singularKey] : labels[pluralKey];
      return `${value} ${label || labels[pluralKey]}`;
    }

    function decimal(value) {
      return new Intl.NumberFormat(
        document.documentElement.lang || 'en',
        { minimumFractionDigits: 1, maximumFractionDigits: 1 },
      ).format(value);
    }

    function setError(message) {
      error.textContent = message;
      error.hidden = !message;
    }

    function clearResults() {
      Object.values(outputs).forEach((output) => {
        output.textContent = '0';
      });
      latestText = '';
    }

    function calendarBreakdown(start, endExclusive) {
      let totalMonths = Math.max(
        0,
        (endExclusive.getUTCFullYear() - start.getUTCFullYear()) * 12
          + endExclusive.getUTCMonth()
          - start.getUTCMonth(),
      );
      while (totalMonths > 0 && addMonths(start, totalMonths) > endExclusive) {
        totalMonths -= 1;
      }
      while (addMonths(start, totalMonths + 1) <= endExclusive) {
        totalMonths += 1;
      }
      const cursor = addMonths(start, totalMonths);
      return {
        years: Math.floor(totalMonths / 12),
        months: totalMonths % 12,
        days: dayDifference(cursor, endExclusive),
      };
    }

    function weekdayWeekendCounts(start, totalDays) {
      let weekdays = 0;
      let weekends = 0;
      for (let index = 0; index < totalDays; index += 1) {
        const day = addDays(start, index).getUTCDay();
        if (day === 0 || day === 6) weekends += 1;
        else weekdays += 1;
      }
      return { weekdays, weekends };
    }

    function calculate() {
      const rawStart = dateOnly(startInput.value);
      const rawEnd = dateOnly(endInput.value);
      if (!rawStart || !rawEnd) {
        clearResults();
        setError(labels.invalidDate);
        return;
      }
      let start = rawStart;
      let end = rawEnd;
      if (start > end) [start, end] = [end, start];

      const includeEnd = includeEndInput.checked;
      const endExclusive = includeEnd ? addDays(end, 1) : end;
      const totalDays = Math.max(0, dayDifference(start, endExclusive));
      const wholeWeeks = Math.floor(totalDays / 7);
      const remainingDays = totalDays % 7;
      const approxMonths = totalDays / 30.4375;
      const breakdown = calendarBreakdown(start, endExclusive);
      const counts = weekdayWeekendCounts(start, totalDays);
      const approximateMonths = decimal(approxMonths);

      outputs.total.textContent = unit(totalDays, 'daySingular', 'dayPlural');
      outputs.weeks.textContent = `${unit(wholeWeeks, 'weekSingular', 'weekPlural')} ${unit(remainingDays, 'daySingular', 'dayPlural')}`;
      outputs.months.textContent = `${labels.approximate} ${approximateMonths} ${labels.monthPlural || labels.months}`;
      outputs.breakdown.textContent = `${unit(breakdown.years, 'yearSingular', 'yearPlural')} ${unit(breakdown.months, 'monthSingular', 'monthPlural')} ${unit(breakdown.days, 'daySingular', 'dayPlural')}`;
      outputs.weekdays.textContent = unit(counts.weekdays, 'daySingular', 'dayPlural');
      outputs.weekends.textContent = unit(counts.weekends, 'daySingular', 'dayPlural');
      latestText = [
        `${labels.startDate}: ${startInput.value}`,
        `${labels.endDate}: ${endInput.value}`,
        `${labels.totalDays}: ${unit(totalDays, 'daySingular', 'dayPlural')}`,
        `${labels.weeks}: ${unit(wholeWeeks, 'weekSingular', 'weekPlural')} ${unit(remainingDays, 'daySingular', 'dayPlural')}`,
        `${labels.months}: ${labels.approximate} ${approximateMonths} ${labels.monthPlural || labels.months}`,
        `${labels.breakdown}: ${unit(breakdown.years, 'yearSingular', 'yearPlural')} ${unit(breakdown.months, 'monthSingular', 'monthPlural')} ${unit(breakdown.days, 'daySingular', 'dayPlural')}`,
        `${labels.weekdays}: ${counts.weekdays}`,
        `${labels.weekends}: ${counts.weekends}`,
      ].join('\n');
      setError('');
    }

    root.querySelector('[data-calculate]')?.addEventListener('click', calculate);
    root.querySelector('[data-copy]')?.addEventListener('click', async () => {
      if (!latestText) calculate();
      if (!latestText) return;
      try {
        await navigator.clipboard.writeText(latestText);
        toast.hidden = false;
        window.setTimeout(() => {
          toast.hidden = true;
        }, 1500);
      } catch {
        window.prompt(labels.copyResult, latestText);
      }
    });

    const today = dateOnly(todayString());
    startInput.value = dateString(today);
    endInput.value = dateString(addDays(today, 30));
    calculate();
  });
</script>
