---
import type { Locale } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  items: { q: string; a: string }[];
}

const { lang, items } = Astro.props;
const ui = t(lang);
---

{/* FAQPage structured data is intentionally not emitted (Google removed the FAQ rich result in 2026-06). The visible FAQ stays. */}
<section class="faq content-section">
  <h2>{ui.faq}</h2>
  <dl>
    {
      items.map((item) => (
        <>
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </>
      ))
    }
  </dl>
</section>
