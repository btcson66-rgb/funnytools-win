---
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from './BaseLayout.astro';
import { type Locale } from '../config/site';
import { t } from '../i18n/ui';
import { localePath, localeUrlPair } from '../lib/url';
import { breadcrumbJsonLd, webPageJsonLd } from '../lib/seo';

interface PageLink {
  href: string;
  label: string;
  note?: string;
}

interface Props {
  lang: Locale;
  title: string;
  seoTitle: string;
  description: string;
  pageKey: string;
  body: string[];
  extraLinks?: PageLink[];
}

const { lang, title, seoTitle, description, pageKey, body, extraLinks = [] } = Astro.props;
const ui = t(lang);
const sectionHeadings: Record<string, Record<Locale, { index: number; heading: string }[]>> = {
  about: {
    zh: [
      { index: 0, heading: '網站定位與服務範圍' },
      { index: 2, heading: '本機處理與資料原則' },
      { index: 4, heading: '內容維護與編輯標準' },
      { index: 6, heading: '發現錯誤時的處理方式' },
      { index: 10, heading: '廣告、分析與使用界線' },
    ],
    en: [
      { index: 0, heading: 'Purpose and service scope' },
      { index: 2, heading: 'Local processing and data principles' },
      { index: 4, heading: 'How tools are built and checked' },
      { index: 6, heading: 'What happens when something breaks' },
      { index: 10, heading: 'Advertising, analytics, and where the line is' },
    ],
  },
  contact: {
    zh: [
      { index: 0, heading: '聯絡方式與處理時間' },
      { index: 2, heading: '回報工具錯誤時該附什麼' },
      { index: 4, heading: '建議新工具與內容修正' },
      { index: 6, heading: 'GitHub Issues 與商業合作詢問' },
      { index: 8, heading: '安全提醒與本站無法協助的範圍' },
    ],
    en: [
      { index: 0, heading: 'Contact channel and review time' },
      { index: 2, heading: 'What to include when reporting a bug' },
      { index: 4, heading: 'Suggesting a tool or requesting a content fix' },
      { index: 6, heading: 'GitHub Issues and business inquiries' },
      { index: 8, heading: 'Safety reminders and what support cannot do' },
    ],
  },
  privacy: {
    zh: [
      { index: 0, heading: '政策範圍與生效日期' },
      { index: 1, heading: '瀏覽器本機處理' },
      { index: 4, heading: '本機儲存與電子郵件' },
      { index: 7, heading: 'Cookie、廣告與第三方服務' },
      { index: 12, heading: '兒童隱私、使用者權利與安全' },
    ],
    en: [
      { index: 0, heading: 'Policy scope and effective date' },
      { index: 1, heading: 'Local browser processing' },
      { index: 4, heading: 'Local storage and email' },
      { index: 7, heading: 'Cookies, advertising, and third parties' },
      { index: 12, heading: 'Children, user rights, and safety' },
    ],
  },
  terms: {
    zh: [
      { index: 0, heading: '條款適用與服務說明' },
      { index: 2, heading: '使用者責任與查證義務' },
      { index: 5, heading: '擔保與責任限制' },
      { index: 8, heading: '可接受使用與智慧財產權' },
      { index: 11, heading: '第三方服務、變更與準據法' },
    ],
    en: [
      { index: 0, heading: 'Agreement and service scope' },
      { index: 2, heading: 'User responsibility and verification' },
      { index: 5, heading: 'Warranty and liability limits' },
      { index: 8, heading: 'Acceptable use and intellectual property' },
      { index: 11, heading: 'Third parties, changes, and governing law' },
    ],
  },
  disclaimer: {
    zh: [
      { index: 0, heading: '一般聲明與適用範圍' },
      { index: 2, heading: '金錢與估算類工具的限制' },
      { index: 5, heading: '統計與教育類工具的限制' },
      { index: 7, heading: 'PDF、圖片與檔案類工具的限制' },
      { index: 9, heading: '健康、隨機與製圖類工具的限制' },
    ],
    en: [
      { index: 0, heading: 'General disclaimer and scope' },
      { index: 2, heading: 'Financial and estimate-based tools' },
      { index: 5, heading: 'Statistics and education tools' },
      { index: 7, heading: 'PDF, image, and file tools' },
      { index: 9, heading: 'Health, random, and drawing tools' },
    ],
  },
  'about-tools': {
    zh: [
      { index: 0, heading: '工具在瀏覽器中如何運作' },
      { index: 2, heading: '工具怎麼被選進來、怎麼決定要不要做' },
      { index: 4, heading: '圖片、PDF 與本機儲存' },
      { index: 6, heading: '計算結果與正式使用限制' },
      { index: 9, heading: '錯誤回報與新工具建議' },
    ],
    en: [
      { index: 0, heading: 'How tools run in the browser' },
      { index: 2, heading: 'How a tool gets picked, and what stays out of scope' },
      { index: 4, heading: 'Images, PDFs, and local storage' },
      { index: 6, heading: 'Calculation results and their formal-use limits' },
      { index: 9, heading: 'Bug reports and tool suggestions' },
    ],
  },
};
const bodyHeadings = new Map((sectionHeadings[pageKey]?.[lang] ?? []).map((item) => [item.index, item.heading]));
// Built from parts on purpose. Writing the comment inline as
// `set:html="<!--email_off-->"` makes the compiler escape it, so v5.102.1 shipped a
// visible "<!--email_off-->" string on every prose page and Cloudflare never saw a
// real comment. Assembling the string here keeps it out of the template parser.
const EMAIL_OFF = `<!${'--'}email_off${'--'}>`;
const EMAIL_ON = `<!${'--'}email_on${'--'}>`;
const breadcrumbItems = [
  { name: ui.breadcrumbHome, href: localePath(lang) },
  { name: title, href: localePath(lang, pageKey) },
];
const jsonLd = [
  webPageJsonLd(lang, title, description, localePath(lang, pageKey)),
  breadcrumbJsonLd(breadcrumbItems),
];
---

<BaseLayout lang={lang} title={seoTitle} description={description} alternateSegments={[pageKey]} altLang={localeUrlPair(pageKey)} jsonLd={jsonLd}>
  <section class="wrap page-head">
    <Breadcrumb
      items={[
        { label: ui.breadcrumbHome, href: localePath(lang) },
        { label: title },
      ]}
    />
    <h1>{title}</h1>
  </section>
  <section class="wrap prose-page">
    {/*
      Cloudflare Email Obfuscation rewrites any address in this prose into a
      /cdn-cgi/l/email-protection link that only resolves once its decoder script
      runs. Without JS — which includes the raw HTML an AdSense reviewer or a
      crawler reads — the contact address renders as "[email protected]" and the
      link itself returns 404, so the site has no verifiable way to be contacted.
      These are Cloudflare's documented opt-out markers; they must reach the
      served HTML, hence set:html rather than a plain JSX comment.
    */}
    <Fragment set:html={EMAIL_OFF} />
    {body.map((paragraph, index) => (
      <>
        {bodyHeadings.has(index) && <h2>{bodyHeadings.get(index)}</h2>}
        <p>{paragraph}</p>
      </>
    ))}
    <Fragment set:html={EMAIL_ON} />
    {extraLinks.length > 0 && (
      <div class="page-link-list">
        {extraLinks.map((link) => (
          <a href={link.href} rel="noopener">
            <strong>{link.label}</strong>
            {link.note && <span>{link.note}</span>}
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .page-link-list {
    display: grid;
    gap: 10px;
    margin-top: 24px;
  }

  .page-link-list a {
    display: grid;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
  }

  .page-link-list a:hover {
    border-color: var(--brand);
  }

  .page-link-list span {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }
</style>
