---
import ExpansionLayout from './ExpansionLayout.astro';
import { expansionRoutesReviewedAt } from '../i18n/expansionRoutes';

interface InfoPage {
  seoTitle: string;
  seoDescription: string;
  keywords: string[];
  eyebrow: string;
  title: string;
  intro: string;
  directAnswer: string[];
  sections: {
    heading: string;
    paragraphs: string[];
    items?: string[];
    link?: { prefix: string; label: string; href: string; suffix?: string };
    links?: { label: string; description: string; href: string }[];
  }[];
  review: {
    heading: string;
    intro: string;
    checks: { title: string; text: string }[];
  };
  faq: { q: string; a: string }[];
  sources?: { label: string; href: string; note: string }[];
}

interface Props {
  currentKey: string;
  canonicalPath: string;
  content: InfoPage;
  pageType?: 'WebPage' | 'CollectionPage' | 'AboutPage' | 'ContactPage';
  breadcrumbParent?: {
    name: string;
    path: string;
  };
  locale?: 'es' | 'fr';
}

const {
  currentKey,
  canonicalPath,
  content,
  pageType = 'WebPage',
  breadcrumbParent,
  locale = 'es',
} = Astro.props;
const copy = {
  es: {
    language: 'es',
    siteName: 'FunnyTools en español',
    homeUrl: 'https://funnytools.win/es/',
    homePath: '/es/',
    homeLabel: 'Inicio',
    breadcrumb: 'Migas de pan',
    directEyebrow: 'Respuesta directa',
    directHeading: 'Lo esencial en menos de un minuto',
    review: 'Revisión editorial y de funcionamiento',
    faq: 'Preguntas frecuentes',
    sources: 'Fuentes y controles externos',
    sourcesIntro: 'Las fuentes ayudan a comprobar las prácticas de terceros y las obligaciones de información. La descripción del funcionamiento de FunnyTools se basa en la implementación publicada del sitio.',
    updated: 'Última revisión editorial',
  },
  fr: {
    language: 'fr',
    siteName: 'FunnyTools en français',
    homeUrl: 'https://funnytools.win/fr/',
    homePath: '/fr/',
    homeLabel: 'Accueil',
    breadcrumb: 'Fil d’Ariane',
    directEyebrow: 'Réponse directe',
    directHeading: 'L’essentiel en moins d’une minute',
    review: 'Relecture éditoriale et test de fonctionnement',
    faq: 'Questions fréquentes',
    sources: 'Sources et contrôles externes',
    sourcesIntro: 'Ces sources permettent de vérifier les règles et les pratiques de tiers. La description du fonctionnement de FunnyTools repose sur l’implémentation publiée du site.',
    updated: 'Dernière relecture éditoriale',
  },
}[locale];
const absoluteUrl = `https://funnytools.win${canonicalPath}`;
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': pageType,
  name: content.title,
  description: content.seoDescription,
  url: absoluteUrl,
  inLanguage: copy.language,
  dateModified: expansionRoutesReviewedAt,
  isPartOf: {
    '@type': 'WebSite',
    name: 'FunnyTools',
    url: copy.homeUrl,
  },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: copy.siteName,
      item: copy.homeUrl,
    },
    ...(breadcrumbParent ? [{
      '@type': 'ListItem',
      position: 2,
      name: breadcrumbParent.name,
      item: `https://funnytools.win${breadcrumbParent.path}`,
    }] : []),
    {
      '@type': 'ListItem',
      position: breadcrumbParent ? 3 : 2,
      name: content.title,
      item: absoluteUrl,
    },
  ],
};
---

<ExpansionLayout
  currentKey={currentKey}
  canonicalPath={canonicalPath}
  title={content.seoTitle}
  description={content.seoDescription}
  keywords={content.keywords}
  type="article"
  jsonLd={[webPageJsonLd, faqJsonLd, breadcrumbJsonLd]}
  locale={locale}
>
  <article
    class="info-page"
    data-native-locale={locale}
    data-editorial-mode="native-search-intent"
  >
    <section class="wrap page-head">
      <nav class="breadcrumb" aria-label={copy.breadcrumb}>
        <a href={copy.homePath}>{copy.homeLabel}</a>
        <span aria-hidden="true">/</span>
        {breadcrumbParent && (
          <>
            <a href={breadcrumbParent.path}>{breadcrumbParent.name}</a>
            <span aria-hidden="true">/</span>
          </>
        )}
        <span aria-current="page">{content.title}</span>
      </nav>
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <p class="lead">{content.intro}</p>
    </section>

    <section class="wrap content-section answer-panel" aria-labelledby={`${currentKey}-respuesta`}>
      <p class="eyebrow">{copy.directEyebrow}</p>
      <h2 id={`${currentKey}-respuesta`}>{copy.directHeading}</h2>
      {content.directAnswer.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    {content.sections.map((section, index) => (
      <section class="wrap content-section" aria-labelledby={`${currentKey}-seccion-${index}`}>
        <h2 id={`${currentKey}-seccion-${index}`}>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.items && (
          <ul class="check-list">
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
        {section.link && (
          <p class="section-link">
            {section.link.prefix}
            <a href={section.link.href}>{section.link.label}</a>
            {section.link.suffix}
          </p>
        )}
        {section.links && (
          <div class="resource-links">
            {section.links.map((link) => (
              <a href={link.href}>
                <strong>{link.label}</strong>
                <span>{link.description}</span>
              </a>
            ))}
          </div>
        )}
      </section>
    ))}

    <section
      class="wrap content-section review-block"
      data-content-value-review
      data-review-key={currentKey}
      data-reviewed-at={expansionRoutesReviewedAt}
      aria-labelledby={`${currentKey}-revision`}
    >
      <p class="eyebrow">{copy.review}</p>
      <h2 id={`${currentKey}-revision`}>{content.review.heading}</h2>
      <p>{content.review.intro}</p>
      <div class="case-grid">
        {content.review.checks.map((check) => (
          <article class="case-card">
            <h3>{check.title}</h3>
            <p>{check.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="wrap content-section" aria-labelledby={`${currentKey}-faq`}>
      <h2 id={`${currentKey}-faq`}>{copy.faq}</h2>
      <div class="faq-list">
        {content.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    {content.sources && (
      <section class="wrap content-section" aria-labelledby={`${currentKey}-fuentes`}>
        <h2 id={`${currentKey}-fuentes`}>{copy.sources}</h2>
        <p>{copy.sourcesIntro}</p>
        <div class="source-list">
          {content.sources.map((source) => (
            <a href={source.href} rel="noopener noreferrer">
              <strong>{source.label}</strong>
              <span>{source.note}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="wrap updated">
      {copy.updated}: <time datetime={expansionRoutesReviewedAt}>{expansionRoutesReviewedAt}</time>
    </p>
  </article>
</ExpansionLayout>

<style>
  .answer-panel {
    border-left: 4px solid var(--brand);
  }

  .source-list {
    display: grid;
    gap: 12px;
  }

  .source-list a {
    display: grid;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }

  .source-list span {
    color: var(--muted);
  }

  .section-link {
    padding: 14px 16px;
    border-left: 4px solid var(--brand);
    border-radius: 0 10px 10px 0;
    background: color-mix(in srgb, var(--brand) 8%, var(--card));
  }

  .section-link a {
    font-weight: 700;
  }

  .resource-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .resource-links a {
    display: grid;
    gap: 6px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }

  .resource-links a:hover {
    border-color: var(--brand);
  }

  .resource-links strong {
    line-height: 1.35;
  }

  .resource-links span {
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 680px) {
    .resource-links {
      grid-template-columns: 1fr;
    }
  }
</style>
