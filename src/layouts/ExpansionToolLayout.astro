---
import ContentValueReview from '../components/ContentValueReview.astro';
import ExpansionLayout from './ExpansionLayout.astro';
import { absoluteUrl } from '../lib/url';
import { expansionRoutesReviewedAt } from '../i18n/expansionRoutes';
import type { ToolContent } from '../i18n/tools/_types';

interface ReviewContent {
  heading: string;
  intro: string;
  panels: { title: string; text: string }[];
  checklistHeading: string;
  checklist: string[];
}

interface RelatedTool {
  name: string;
  description: string;
  href: string;
}

interface Props {
  routeKey: string;
  canonicalPath: string;
  content: ToolContent;
  categoryLabel: string;
  review: ReviewContent;
  relatedTool?: RelatedTool;
  localOnly?: boolean;
}

const {
  routeKey,
  canonicalPath,
  content,
  categoryLabel,
  review,
  relatedTool,
  localOnly = true,
} = Astro.props;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `Cómo usar ${content.name}`,
  inLanguage: 'es',
  url: absoluteUrl(canonicalPath),
  step: content.instructions.map((text, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    text,
  })),
};
const applicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: content.name,
  url: absoluteUrl(canonicalPath),
  description: content.seoDescription,
  applicationCategory: categoryLabel,
  operatingSystem: 'Cualquier sistema con navegador moderno',
  browserRequirements: 'JavaScript activado en un navegador moderno',
  inLanguage: 'es',
  keywords: content.keywords.join(', '),
  dateModified: expansionRoutesReviewedAt,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Organization',
    name: 'FunnyTools',
    url: 'https://funnytools.win/',
  },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://funnytools.win/es/' },
    { '@type': 'ListItem', position: 2, name: content.name, item: absoluteUrl(canonicalPath) },
  ],
};
---

<ExpansionLayout
  currentKey={routeKey}
  canonicalPath={canonicalPath}
  title={content.seoTitle}
  description={content.seoDescription}
  keywords={content.keywords}
  jsonLd={[applicationJsonLd, howToJsonLd, faqJsonLd, breadcrumbJsonLd]}
  ogImageAlt={content.name}
>
  <article
    class="wrap tool-page"
    data-native-locale="es"
    data-editorial-mode="native-search-intent"
    data-route-key={routeKey}
  >
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/es/">Inicio</a>
      <span aria-hidden="true">›</span>
      <span>{content.name}</span>
    </nav>

    <header class="tool-header tool-header-card">
      <p class="eyebrow">{categoryLabel} · Gratis · Sin registro</p>
      <h1>{content.name}</h1>
      <p class="tool-purpose">{content.short}</p>
      <p class="lead">{content.long}</p>
      {localOnly && <p class="privacy-highlight">🔒 El tratamiento se realiza en este navegador; tus datos no se envían a FunnyTools.</p>}
    </header>

    <section class="content-section tool-interaction" aria-labelledby="zona-herramienta">
      <h2 id="zona-herramienta">Usar la herramienta</h2>
      <slot />
    </section>

    {content.capabilities && content.capabilities.length > 0 && (
      <section class="content-section">
        <h2>Qué puedes hacer aquí</h2>
        <ul class="check-list">
          {content.capabilities.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {content.contentSections?.map((section) => (
      <section class="content-section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.items && section.items.length > 0 && (
          <ul class="check-list">
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
        {section.link && (
          <p class="section-link">
            {section.link.prefix}
            <a href={section.link.href}>{section.link.label}</a>
            {section.link.suffix ?? ''}
          </p>
        )}
      </section>
    ))}

    {content.formula && (
      <section class="content-section formula-panel">
        <h2>Fórmula y criterio de cálculo</h2>
        <p class="formula-expression"><code>{content.formula.expression}</code></p>
        <p>{content.formula.explanation}</p>
      </section>
    )}

    <section class="content-section">
      <h2>Cómo utilizarla paso a paso</h2>
      <ol class="step-list">
        {content.instructions.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section class="content-section">
      <h2>Situaciones en las que resulta útil</h2>
      <ul class="check-list">
        {content.examples.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {content.caseStudies && content.caseStudies.length > 0 && (
      <section class="content-section">
        <h2>Ejemplos completos</h2>
        <div class="case-grid">
          {content.caseStudies.map((item) => (
            <article class="case-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <ContentValueReview
      {...review}
      reviewedLabel="Revisión editorial y de funcionamiento"
      reviewedAt={expansionRoutesReviewedAt}
    />

    {content.notes && content.notes.length > 0 && (
      <section class="content-section">
        <h2>Límites y comprobaciones importantes</h2>
        <ul class="note-list">
          {content.notes.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {content.sources && content.sources.length > 0 && (
      <section class="content-section">
        <h2>Fuentes y documentación para comprobar</h2>
        <ul class="source-list">
          {content.sources.map((source) => (
            <li>
              <a href={source.href} rel="noopener noreferrer">{source.label}</a>
              <span>{source.note}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="content-section">
      <h2>Preguntas frecuentes</h2>
      <div class="faq-list">
        {content.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="content-section privacy-note">
      <h2>Privacidad y tratamiento local</h2>
      <p>{content.privacyNote ?? 'Los datos se procesan en el navegador y no se guardan en servidores de FunnyTools.'}</p>
    </section>

    <section class="content-section trust-note">
      <h2>Uso responsable del resultado</h2>
      <p>{content.disclaimer ?? 'Comprueba el resultado con la fuente, la norma o el documento oficial antes de tomar una decisión importante.'}</p>
    </section>

    {relatedTool && (
      <section class="content-section related-guides">
        <h2>Otra herramienta disponible en español</h2>
        <a href={relatedTool.href}>
          <strong>{relatedTool.name}</strong>
          <span>{relatedTool.description}</span>
        </a>
      </section>
    )}

    <p class="updated">
      Última revisión editorial: <time datetime={expansionRoutesReviewedAt}>{expansionRoutesReviewedAt}</time>
    </p>
  </article>
</ExpansionLayout>

<style>
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 18px 0;
    color: var(--muted);
    font-weight: 750;
  }

  .related-guides a {
    display: grid;
    gap: 5px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }

  .related-guides span {
    color: var(--muted);
  }

  .source-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 1.2rem;
  }

  .source-list li {
    padding-left: 4px;
  }

  .source-list a {
    font-weight: 850;
  }

  .source-list span {
    display: block;
    margin-top: 3px;
    color: var(--muted);
  }
</style>
