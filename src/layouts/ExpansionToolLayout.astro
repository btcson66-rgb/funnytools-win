---
import ContentValueReview from '../components/ContentValueReview.astro';
import ExpansionLayout from './ExpansionLayout.astro';
import { absoluteUrl } from '../lib/url';
import { expansionRoutesReviewedAt } from '../i18n/expansionRoutes';
import type { ToolContent } from '../i18n/tools/_types';

interface ReviewContent {
  heading: string;
  intro: string;
  panels: { title: string; text: string }[];
  checklistHeading: string;
  checklist: string[];
}

interface RelatedTool {
  name: string;
  description: string;
  href: string;
}

interface Props {
  routeKey: string;
  canonicalPath: string;
  content: ToolContent;
  categoryLabel: string;
  review: ReviewContent;
  relatedTool?: RelatedTool;
  localOnly?: boolean;
  locale?: 'es' | 'fr';
}

const {
  routeKey,
  canonicalPath,
  content,
  categoryLabel,
  review,
  relatedTool,
  localOnly = true,
  locale = 'es',
} = Astro.props;
const copy = {
  es: {
    howTo: 'Cómo usar',
    operatingSystem: 'Cualquier sistema con navegador moderno',
    browserRequirements: 'JavaScript activado en un navegador moderno',
    currency: 'EUR',
    homeName: 'Inicio',
    homePath: '/es/',
    breadcrumb: 'Migas de pan',
    freeLine: 'Gratis · Sin registro',
    localNotice: '🔒 El tratamiento se realiza en este navegador; tus datos no se envían a FunnyTools.',
    useTool: 'Usar la herramienta',
    capabilities: 'Qué puedes hacer aquí',
    formula: 'Fórmula y criterio de cálculo',
    steps: 'Cómo utilizarla paso a paso',
    situations: 'Situaciones en las que resulta útil',
    examples: 'Ejemplos completos',
    reviewed: 'Revisión editorial y de funcionamiento',
    limits: 'Límites y comprobaciones importantes',
    sources: 'Fuentes y documentación para comprobar',
    faq: 'Preguntas frecuentes',
    privacy: 'Privacidad y tratamiento local',
    privacyFallback: 'Los datos se procesan en el navegador y no se guardan en servidores de FunnyTools.',
    responsibility: 'Uso responsable del resultado',
    disclaimerFallback: 'Comprueba el resultado con la fuente, la norma o el documento oficial antes de tomar una decisión importante.',
    related: 'Otra herramienta disponible en español',
    updated: 'Última revisión editorial',
  },
  fr: {
    howTo: 'Comment utiliser',
    operatingSystem: 'Tout système équipé d’un navigateur moderne',
    browserRequirements: 'JavaScript activé dans un navigateur moderne',
    currency: 'EUR',
    homeName: 'Accueil',
    homePath: '/fr/',
    breadcrumb: 'Fil d’Ariane',
    freeLine: 'Gratuit · Sans inscription',
    localNotice: '🔒 Le traitement s’effectue dans ce navigateur ; vos données ne sont pas envoyées à FunnyTools.',
    useTool: 'Utiliser l’outil',
    capabilities: 'Ce que vous pouvez faire ici',
    formula: 'Formule et méthode de calcul',
    steps: 'Mode d’emploi étape par étape',
    situations: 'Dans quelles situations cet outil est utile',
    examples: 'Exemples détaillés',
    reviewed: 'Relecture éditoriale et test de fonctionnement',
    limits: 'Limites et vérifications importantes',
    sources: 'Sources et documentation à consulter',
    faq: 'Questions fréquentes',
    privacy: 'Confidentialité et traitement local',
    privacyFallback: 'Les données sont traitées dans le navigateur et ne sont pas enregistrées sur les serveurs de FunnyTools.',
    responsibility: 'Utiliser le résultat avec discernement',
    disclaimerFallback: 'Vérifiez le résultat à l’aide de la règle, du document ou de la source officielle avant toute décision importante.',
    related: 'Un autre outil disponible en français',
    updated: 'Dernière relecture éditoriale',
  },
}[locale];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${copy.howTo} ${content.name}`,
  inLanguage: locale,
  url: absoluteUrl(canonicalPath),
  step: content.instructions.map((text, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    text,
  })),
};
const applicationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: content.name,
  url: absoluteUrl(canonicalPath),
  description: content.seoDescription,
  applicationCategory: categoryLabel,
  operatingSystem: copy.operatingSystem,
  browserRequirements: copy.browserRequirements,
  inLanguage: locale,
  keywords: content.keywords.join(', '),
  dateModified: expansionRoutesReviewedAt,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: copy.currency,
    availability: 'https://schema.org/InStock',
  },
  author: {
    '@type': 'Organization',
    name: 'FunnyTools',
    url: 'https://funnytools.win/',
  },
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: copy.homeName, item: absoluteUrl(copy.homePath) },
    { '@type': 'ListItem', position: 2, name: content.name, item: absoluteUrl(canonicalPath) },
  ],
};
---

<ExpansionLayout
  currentKey={routeKey}
  canonicalPath={canonicalPath}
  title={content.seoTitle}
  description={content.seoDescription}
  keywords={content.keywords}
  jsonLd={[applicationJsonLd, howToJsonLd, faqJsonLd, breadcrumbJsonLd]}
  ogImageAlt={content.name}
  locale={locale}
>
  <article
    class="wrap tool-page"
    data-native-locale={locale}
    data-editorial-mode="native-search-intent"
    data-route-key={routeKey}
  >
    <nav class="breadcrumb" aria-label={copy.breadcrumb}>
      <a href={copy.homePath}>{copy.homeName}</a>
      <span aria-hidden="true">›</span>
      <span>{content.name}</span>
    </nav>

    <header class="tool-header tool-header-card">
      <p class="eyebrow">{categoryLabel} · {copy.freeLine}</p>
      <h1>{content.name}</h1>
      <p class="tool-purpose">{content.short}</p>
      <p class="lead">{content.long}</p>
      {localOnly && <p class="privacy-highlight">{copy.localNotice}</p>}
    </header>

    <section class="content-section tool-interaction" aria-labelledby="zona-herramienta">
      <h2 id="zona-herramienta">{copy.useTool}</h2>
      <slot />
    </section>

    {content.capabilities && content.capabilities.length > 0 && (
      <section class="content-section">
        <h2>{copy.capabilities}</h2>
        <ul class="check-list">
          {content.capabilities.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {content.contentSections?.map((section) => (
      <section class="content-section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.items && section.items.length > 0 && (
          <ul class="check-list">
            {section.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
        {section.link && (
          <p class="section-link">
            {section.link.prefix}
            <a href={section.link.href}>{section.link.label}</a>
            {section.link.suffix ?? ''}
          </p>
        )}
      </section>
    ))}

    {content.formula && (
      <section class="content-section formula-panel">
        <h2>{copy.formula}</h2>
        <p class="formula-expression"><code>{content.formula.expression}</code></p>
        <p>{content.formula.explanation}</p>
      </section>
    )}

    <section class="content-section">
      <h2>{copy.steps}</h2>
      <ol class="step-list">
        {content.instructions.map((item) => <li>{item}</li>)}
      </ol>
    </section>

    <section class="content-section">
      <h2>{copy.situations}</h2>
      <ul class="check-list">
        {content.examples.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {content.caseStudies && content.caseStudies.length > 0 && (
      <section class="content-section">
        <h2>{copy.examples}</h2>
        <div class="case-grid">
          {content.caseStudies.map((item) => (
            <article class="case-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <ContentValueReview
      {...review}
      reviewedLabel={copy.reviewed}
      reviewedAt={expansionRoutesReviewedAt}
    />

    {content.notes && content.notes.length > 0 && (
      <section class="content-section">
        <h2>{copy.limits}</h2>
        <ul class="note-list">
          {content.notes.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {content.sources && content.sources.length > 0 && (
      <section class="content-section">
        <h2>{copy.sources}</h2>
        <ul class="source-list">
          {content.sources.map((source) => (
            <li>
              <a href={source.href} rel="noopener noreferrer">{source.label}</a>
              <span>{source.note}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="content-section">
      <h2>{copy.faq}</h2>
      <div class="faq-list">
        {content.faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="content-section privacy-note">
      <h2>{copy.privacy}</h2>
      <p>{content.privacyNote ?? copy.privacyFallback}</p>
    </section>

    <section class="content-section trust-note">
      <h2>{copy.responsibility}</h2>
      <p>{content.disclaimer ?? copy.disclaimerFallback}</p>
    </section>

    {relatedTool && (
      <section class="content-section related-guides">
        <h2>{copy.related}</h2>
        <a href={relatedTool.href}>
          <strong>{relatedTool.name}</strong>
          <span>{relatedTool.description}</span>
        </a>
      </section>
    )}

    <p class="updated">
      {copy.updated}: <time datetime={expansionRoutesReviewedAt}>{expansionRoutesReviewedAt}</time>
    </p>
  </article>
</ExpansionLayout>

<style>
  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    margin: 18px 0;
    color: var(--muted);
    font-weight: 750;
  }

  .related-guides a {
    display: grid;
    gap: 5px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card);
  }

  .related-guides span {
    color: var(--muted);
  }

  .source-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 1.2rem;
  }

  .source-list li {
    padding-left: 4px;
  }

  .source-list a {
    font-weight: 850;
  }

  .source-list span {
    display: block;
    margin-top: 3px;
    color: var(--muted);
  }
</style>
