---
import '../styles/global.css';
import { SITE, type Locale } from '../config/site';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  fullToolUrl: string;
}

const { lang, title, description, fullToolUrl } = Astro.props;
const ui = t(lang);
const ga4Enabled = !!SITE.ga4MeasurementId;
const contentSecurityPolicy = [
  "default-src 'self'",
  `script-src 'self' 'unsafe-inline'${ga4Enabled ? ' https://www.googletagmanager.com' : ''}`,
  "style-src 'self' 'unsafe-inline'",
  `img-src 'self' data: blob:${ga4Enabled ? ' https://www.googletagmanager.com' : ''}`,
  `connect-src 'self'${ga4Enabled ? ' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://analytics.google.com' : ''}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang={SITE.htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="noindex,follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      ga4Enabled && (
        <>
          <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4MeasurementId}`} />
          <script is:inline define:vars={{ measurementId: SITE.ga4MeasurementId, secondaryMeasurementId: SITE.ga4SecondaryMeasurementId, affiliateMeasurementId: SITE.affiliateGa4MeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            // See BaseLayout: define:vars puts this script in an IIFE, so gtag has to be
            // published onto window explicitly or nothing outside this block can call it.
            window.gtag = gtag;
            window.__ft_existing_ga_ids = secondaryMeasurementId
              ? [measurementId, secondaryMeasurementId]
              : [measurementId];
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              wait_for_update: 500,
            });
            var savedConsent = null;
            try { savedConsent = window.localStorage.getItem('btcson_consent_v1'); } catch {}
            if (savedConsent === 'accepted') {
              gtag('consent', 'update', { analytics_storage: 'granted' });
            }
            gtag('js', new Date());
            // Keep embed page_views explicit for the two existing properties. This
            // prevents a linked Google tag destination from inheriting page_view hits.
            gtag('config', measurementId, { send_page_view: false });
            if (secondaryMeasurementId) gtag('config', secondaryMeasurementId, { send_page_view: false });
            if (affiliateMeasurementId && [measurementId, secondaryMeasurementId].indexOf(affiliateMeasurementId) === -1) {
              gtag('config', affiliateMeasurementId, { send_page_view: false });
            }
            gtag('event', 'page_view', { send_to: measurementId });
            if (secondaryMeasurementId) gtag('event', 'page_view', { send_to: secondaryMeasurementId });
            const initConsentUi = () => {
              if (document.querySelector('[data-consent-widget]')) return;
              const isZh = (document.documentElement.lang || '').toLowerCase().startsWith('zh');
              const widget = document.createElement('div');
              widget.setAttribute('data-consent-widget', '');
              widget.style.cssText = 'position:fixed;right:16px;bottom:16px;z-index:1000;max-width:min(440px,calc(100vw - 32px));color:#172033;font-family:inherit';
              widget.innerHTML = isZh
                ? '<section role="dialog" aria-labelledby="consent-title" aria-describedby="consent-description" style="display:grid;gap:12px;padding:16px;border:1px solid #cbd5e1;border-radius:12px;background:#fff;box-shadow:0 8px 28px rgb(15 23 42 / 18%)"><div><h2 id="consent-title" style="margin:0 0 6px;font-size:1rem">分析與 Cookie 選擇</h2><p id="consent-description" style="margin:0;font-size:.875rem;line-height:1.5">我們使用必要技術維持網站運作；只有在你選擇接受後，才啟用分析儲存。你可以隨時重新修改選擇。</p></div><div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end"><button type="button" data-consent-action="reject">拒絕分析</button><button type="button" data-consent-action="accept" style="border-color:#0f766e;background:#0f766e;color:#fff">接受分析</button></div></section><button type="button" data-consent-action="settings" hidden style="display:block;margin-left:auto;min-height:36px;padding:8px 12px;border:1px solid #94a3b8;border-radius:8px;background:#fff;color:inherit;cursor:pointer;font:inherit;font-weight:700">Cookie 設定</button>'
                : '<section role="dialog" aria-labelledby="consent-title" aria-describedby="consent-description" style="display:grid;gap:12px;padding:16px;border:1px solid #cbd5e1;border-radius:12px;background:#fff;box-shadow:0 8px 28px rgb(15 23 42 / 18%)"><div><h2 id="consent-title" style="margin:0 0 6px;font-size:1rem">Analytics and cookie choices</h2><p id="consent-description" style="margin:0;font-size:.875rem;line-height:1.5">We use essential technology to keep this site working. Analytics storage is enabled only after you choose to accept it. You can change your choice at any time.</p></div><div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end"><button type="button" data-consent-action="reject">Reject analytics</button><button type="button" data-consent-action="accept" style="border-color:#0f766e;background:#0f766e;color:#fff">Accept analytics</button></div></section><button type="button" data-consent-action="settings" hidden style="display:block;margin-left:auto;min-height:36px;padding:8px 12px;border:1px solid #94a3b8;border-radius:8px;background:#fff;color:inherit;cursor:pointer;font:inherit;font-weight:700">Cookie settings</button>';
              const banner = widget.firstElementChild;
              const settings = widget.lastElementChild;
              const readChoice = () => {
                try {
                  const choice = window.localStorage.getItem('btcson_consent_v1');
                  return choice === 'accepted' || choice === 'rejected' ? choice : null;
                } catch { return null; }
              };
              const render = () => {
                const choice = readChoice();
                banner.hidden = Boolean(choice);
                settings.hidden = !choice;
              };
              widget.addEventListener('click', (event) => {
                const action = event.target.closest('[data-consent-action]')?.getAttribute('data-consent-action');
                if (action === 'settings') { banner.hidden = false; settings.hidden = true; return; }
                if (action !== 'accept' && action !== 'reject') return;
                const choice = action === 'accept' ? 'accepted' : 'rejected';
                try { window.localStorage.setItem('btcson_consent_v1', choice); } catch {}
                window.gtag('consent', 'update', { analytics_storage: choice === 'accepted' ? 'granted' : 'denied' });
                render();
              });
              document.body.appendChild(widget);
              render();
            };
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initConsentUi, { once: true });
            else initConsentUi();
          </script>
        </>
      )
    }
  </head>
  <body class="embed-body">
    <main class="embed-shell" aria-label={title}>
      <h1>{title}</h1>
      <slot />
      <p class="embed-powered">
        <a href={fullToolUrl} target="_blank" rel="noopener noreferrer">{ui.embed.poweredBy}</a>
      </p>
    </main>
  </body>
</html>

<style is:global>
  html,
  body.embed-body {
    min-width: 280px;
    margin: 0;
    background: transparent;
  }
</style>

<style>
  .embed-shell {
    width: 100%;
    min-height: 100vh;
    padding: 14px;
    background: #fff;
  }

  h1 {
    margin-bottom: 14px;
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .embed-powered {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.86rem;
    text-align: center;
  }

  .embed-powered a {
    color: var(--brand);
    font-weight: 800;
  }

  :global(.embed-shell .tool-widget) {
    box-shadow: none;
  }
</style>
