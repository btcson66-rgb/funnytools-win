---
import BaseLayout from './BaseLayout.astro';
import LocalizedFooter from '../components/expansion/LocalizedFooter.astro';
import LocalizedNav from '../components/expansion/LocalizedNav.astro';
import FrenchFooter from '../components/expansion/FrenchFooter.astro';
import FrenchNav from '../components/expansion/FrenchNav.astro';

interface Props {
  currentKey: string;
  canonicalPath: string;
  title: string;
  description: string;
  keywords?: string[];
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImageAlt?: string;
  locale?: 'es' | 'fr';
}

const {
  currentKey,
  canonicalPath,
  title,
  description,
  keywords = [],
  type = 'website',
  jsonLd = [],
  ogImageAlt = 'FunnyTools en español',
  locale = 'es',
} = Astro.props;
const localeMeta = {
  es: {
    htmlLanguage: 'es',
    ogLocale: 'es_ES',
    skipLabel: 'Saltar al contenido',
  },
  fr: {
    htmlLanguage: 'fr',
    ogLocale: 'fr_FR',
    skipLabel: 'Aller au contenu',
  },
}[locale];
---

<BaseLayout
  lang="en"
  title={title}
  description={description}
  keywords={keywords}
  type={type}
  jsonLd={jsonLd}
  canonicalPath={canonicalPath}
  htmlLanguage={localeMeta.htmlLanguage}
  ogLocaleOverride={localeMeta.ogLocale}
  ogImageAlt={ogImageAlt}
  skipToContentLabel={localeMeta.skipLabel}
  hasAlternates={true}
>
  {locale === 'fr'
    ? <FrenchNav slot="nav" currentKey={currentKey} />
    : <LocalizedNav slot="nav" currentKey={currentKey} />}
  <slot />
  {locale === 'fr'
    ? <FrenchFooter slot="footer" />
    : <LocalizedFooter slot="footer" />}
</BaseLayout>
