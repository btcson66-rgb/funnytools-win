---
import Breadcrumb from '../components/Breadcrumb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, localeUrlPair } from '../lib/url';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../lib/seo';
import {
  chemistryLine,
  entitleKit,
  learningProducts,
  physicsBundle,
  physicsSingles,
  withUtm,
} from '../data/shop-products';

const lang = 'zh' as const;
const title = 'Btcson Lab 教材商店';
const seoTitle = 'Btcson Lab 教材商店｜自然發音、數學、視覺日程與 STEM 實驗教材';
const description =
  'FunnyTools 自製的可列印學習教材：CVC 自然發音閱讀、數學事實練習、晨間慣例、視覺日程卡、精細動作任務，以及物理與化學動手實驗任務包。PDF 下載、在家即可使用。';
const shopUrl = localePath(lang, 'shop');
const breadcrumbItems = [
  { name: '首頁', href: localePath(lang) },
  { name: '教材商店', href: shopUrl },
];
const jsonLd = [
  collectionPageJsonLd(lang, title, description, shopUrl),
  breadcrumbJsonLd(breadcrumbItems),
];
---

<BaseLayout
  lang={lang}
  title={seoTitle}
  description={description}
  alternateSegments={['shop']}
  altLang={localeUrlPair('shop')}
  robots="index, follow"
  jsonLd={jsonLd}
>
  <div class="shop-wrap">
    <section class="shop-hero">
      <Breadcrumb
        items={[
          { label: '首頁', href: localePath(lang) },
          { label: '教材商店' },
        ]}
      />
      <p class="eyebrow">教材商店</p>
      <h1>{title}</h1>
      <p class="lead">
        Btcson Lab 是 FunnyTools 維護者以個人身分自製的教材品牌：可列印的閱讀、數學、日常慣例教材，
        以及在家就能做的物理、化學動手實驗任務包。全部是 PDF／離線檔案，購買後立即下載。
      </p>
    </section>

    <section class="content-section" aria-labelledby="developer-heading">
      <div class="section-head">
        <p class="shop-kicker">SELF-HOSTED SOURCE KIT</p>
        <h2 id="developer-heading">獨立開發者工具</h2>
        <p>透過 Gumroad 或 Payhip 販售軟體？把付款事件接成可驗證、可撤銷的使用權。</p>
      </div>
      <div class="shop-grid shop-grid-featured">
        <article class="shop-card shop-card-featured">
          <span class="shop-icon" aria-hidden="true">{entitleKit.emoji}</span>
          <h3>{entitleKit.name[lang]}</h3>
          <p class="shop-meta">{entitleKit.meta[lang]}</p>
          <p>{entitleKit.blurb[lang]}</p>
          <p class="shop-price">{entitleKit.price}</p>
          <div class="shop-actions">
            <a
              class="btn"
              href={withUtm(entitleKit.gumroad!, 'entitlekit_card_gumroad')}
              target="_blank"
              rel="noopener"
              data-shop-product={entitleKit.id}
              data-shop-platform="gumroad"
            >在 Gumroad 查看</a>
            <a
              class="btn ghost"
              href={withUtm(entitleKit.payhip!, 'entitlekit_card_payhip')}
              target="_blank"
              rel="noopener"
              data-shop-product={entitleKit.id}
              data-shop-platform="payhip"
            >在 Payhip 查看</a>
          </div>
        </article>
      </div>
    </section>

    <section class="content-section" aria-labelledby="learning-heading">
      <div class="section-head">
        <h2 id="learning-heading">學習教材（4–10 歲）</h2>
        <p>每套教材都含完整課次規劃與家長引導，列印出來就能開始。</p>
      </div>
      <div class="shop-grid">
        {learningProducts.map((p) => (
          <article class="shop-card">
            <span class="shop-icon" aria-hidden="true">{p.emoji}</span>
            <h3>{p.name[lang]}</h3>
            <p class="shop-meta">{p.meta[lang]}</p>
            <p>{p.blurb[lang]}</p>
            <p class="shop-price">{p.price}</p>
            <div class="shop-actions">
              {p.gumroad && (
                <a
                  class="btn"
                  href={withUtm(p.gumroad)}
                  target="_blank"
                  rel="noopener"
                  data-shop-product={p.id}
                  data-shop-platform="gumroad"
                >Gumroad 購買</a>
              )}
              {p.payhip && (
                <a
                  class="btn ghost"
                  href={withUtm(p.payhip)}
                  target="_blank"
                  rel="noopener"
                  data-shop-product={p.id}
                  data-shop-platform="payhip"
                >Payhip 購買</a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" aria-labelledby="stem-heading">
      <div class="section-head">
        <h2 id="stem-heading">STEM 動手實驗任務包（7–15 歲）</h2>
        <p>真材料、真實驗：每包含步驟圖解、家長指南、工作紙、小測驗、證書與離線模擬器。</p>
      </div>
      <div class="shop-grid shop-grid-wide">
        {[physicsBundle, chemistryLine].map((p) => (
          <article class="shop-card">
            <span class="shop-icon" aria-hidden="true">{p.emoji}</span>
            <h3>{p.name[lang]}</h3>
            <p class="shop-meta">{p.meta[lang]}</p>
            <p>{p.blurb[lang]}</p>
            <p class="shop-price">{p.price}</p>
            <div class="shop-actions">
              {p.gumroad && (
                <a
                  class="btn"
                  href={withUtm(p.gumroad)}
                  target="_blank"
                  rel="noopener"
                  data-shop-product={p.id}
                  data-shop-platform="gumroad"
                >Gumroad 購買</a>
              )}
              {p.payhip && (
                <a
                  class="btn ghost"
                  href={withUtm(p.payhip)}
                  target="_blank"
                  rel="noopener"
                  data-shop-product={p.id}
                  data-shop-platform="payhip"
                >Payhip 購買</a>
              )}
            </div>
          </article>
        ))}
      </div>

      <details class="shop-singles">
        <summary>物理任務包也可單包購買（每包 US$3，Payhip）</summary>
        <ul>
          {physicsSingles.map((s) => (
            <li>
              <a
                href={withUtm(s.payhip)}
                target="_blank"
                rel="noopener"
                data-shop-product="physics-single"
                data-shop-platform="payhip"
              >{s.name[lang]}</a>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="content-section shop-disclosure" aria-labelledby="disclosure-heading">
      <h2 id="disclosure-heading">關於這些商品</h2>
      <p>
        本頁商品均由 FunnyTools 維護者以 Btcson Lab 名義自行設計製作的數位教材或軟體原始碼工具，非第三方分潤商品。
        交易與檔案下載在 Gumroad 或 Payhip 平台完成，付款與退款政策以平台頁面為準。
        購買前請先確認商品頁的內容說明與適用年齡。
      </p>
    </section>

    <section class="content-section shop-disclosure" aria-labelledby="revenue-heading">
      <h2 id="revenue-heading">購買與收益怎麼運作</h2>
      <p>這裡的商品跟「支持本站」頁的資源連結不一樣：不是分潤連結，是直接販售的教材與軟體工具包。你在 Gumroad 或 Payhip 完成付款後，檔案由該平台直接提供下載，FunnyTools 拿到的是扣除平台手續費後的實際收入，不是像酷澎或蝦皮那樣的分潤比例。</p>
      <p>退款、發票與付款方式一律依照 Gumroad 或 Payhip 各自的平台規則處理，本站不會另外收款，也不會另外處理退款申請；如果購買後對商品內容有疑問，請先查看該筆訂單在對應平台上的商品頁說明與售後政策。</p>
      <p>這個商店的收入用途很直接：維持 FunnyTools 免費工具的網域、託管與開發時間。免費工具區不會因為你買或不買商店裡的商品而改變功能或出現更多廣告，兩邊是分開運作的收入來源，商店存在與否都不影響工具本身能不能用。</p>
      <p>購買前建議先讀商品頁列出的內容範圍與適用年齡：教材類商品標示的年齡區間是設計參考，不是保證適合每個孩子的程度；STEM 動手實驗包需要準備商品頁列出的材料才能完成任務，購買前請先確認家中是否方便取得。</p>
      <p>本頁商品不使用倒數計時、庫存緊張提示或其他催促購買的手法；價格清楚列出，也沒有「現在不買折扣就消失」這類設計。如果商品頁的說明沒有回答你在意的具體問題，例如檔案格式、可列印頁數，或某個活動是否需要家長陪同，建議購買前先詢問，不要假設答案一定對你有利。</p>
    </section>
  </div>

  <script>
    document.querySelectorAll('[data-shop-product]').forEach((link) => {
      link.addEventListener('click', () => {
        window.__ft_track?.('shop_click', {
          product: link.getAttribute('data-shop-product') || 'unknown',
          platform: link.getAttribute('data-shop-platform') || 'unknown',
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .shop-wrap {
    width: min(100% - 32px, 960px);
    margin-inline: auto;
  }

  .shop-hero {
    margin-top: 20px;
    padding: 28px 24px 30px;
    border: 1px solid rgba(219, 227, 238, 0.72);
    border-radius: 28px;
    background:
      linear-gradient(135deg, rgba(15, 143, 140, 0.12), rgba(62, 99, 221, 0.08) 62%, rgba(242, 107, 79, 0.08)),
      #fff;
  }

  .shop-hero h1 {
    max-width: 760px;
  }

  .shop-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .shop-grid-wide {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .shop-grid-featured {
    grid-template-columns: minmax(0, 1fr);
  }

  .shop-card-featured {
    border-color: rgba(15, 143, 140, 0.35);
    background: linear-gradient(135deg, rgba(15, 143, 140, 0.09), rgba(62, 99, 221, 0.05)), var(--card);
  }

  .shop-card-featured h3 {
    font-size: 1.25rem;
  }

  .shop-kicker {
    margin: 0 0 6px;
    color: var(--brand-2);
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .shop-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    box-shadow: var(--shadow-soft);
  }

  .shop-card h3,
  .shop-card p {
    margin: 0;
  }

  .shop-card h3 {
    margin-top: 12px;
    font-size: 1.08rem;
  }

  .shop-card p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .shop-icon {
    display: inline-grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 13px;
    background: var(--soft);
    font-size: 1.35rem;
  }

  .shop-meta {
    color: var(--brand-2) !important;
    font-size: 0.78rem !important;
    font-weight: 700;
  }

  .shop-price {
    margin-top: 12px !important;
    color: var(--ink) !important;
    font-size: 1.05rem !important;
    font-weight: 900;
  }

  .shop-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    width: 100%;
    margin-top: 12px;
    padding-top: 2px;
  }

  .shop-actions .btn {
    min-height: 40px;
    padding: 8px 10px;
    font-size: 0.88rem;
    text-align: center;
  }

  .shop-singles {
    margin-top: 18px;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
  }

  .shop-singles summary {
    color: var(--ink);
    font-weight: 800;
    cursor: pointer;
  }

  .shop-singles ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 16px;
    margin: 14px 0 0;
    padding: 0 0 0 18px;
  }

  .shop-singles a {
    color: var(--brand-2);
  }

  .shop-disclosure {
    padding: 20px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--brand);
    border-radius: 14px;
    background: var(--soft);
  }

  .shop-disclosure h2,
  .shop-disclosure p {
    margin: 0;
  }

  .shop-disclosure p {
    margin-top: 8px;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .shop-grid,
    .shop-grid-wide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .shop-hero {
      padding: 24px 16px;
      border-radius: 20px;
    }

    .shop-grid,
    .shop-grid-wide {
      grid-template-columns: 1fr;
    }

    .shop-singles ul {
      grid-template-columns: 1fr;
    }
  }
</style>
