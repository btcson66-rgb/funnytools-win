---
import { SITE } from '../../config/site';
import { liveTools, getEmbeddableTools, hasLiveTools } from '../../data/tools';
import { categories } from '../../data/categories';
import { removedRedirects } from '../../data/removedRedirects';

export function getStaticPaths() {
  // A /zh/* alias must land on the final page in one hop. When the page it would normally point
  // at has itself been merged away (a registered stub in removedRedirects.ts), use that stub's
  // target instead, so a stub never points at another stub.
  const finalTarget = (path: string | undefined) => {
    const direct = path ? `/${path}/` : '/';
    return removedRedirects.find((r) => r.from === direct)?.to ?? direct;
  };
  const legalPages = ['about', 'about-tools', 'contact', 'privacy', 'terms', 'disclaimer'];
  const paths: Array<string | undefined> = [
    undefined,
    'tools',
    ...liveTools.map((tool) => `tools/${tool.slug}`),
    // P1: only the statistics category page still existed; since P2 batch 4 it is itself a stub,
    // so /zh/category/statistics/ goes straight to its final page (see finalTarget).
    ...categories.filter((c) => c.id === 'statistics' && hasLiveTools(c.id)).map((c) => `category/${c.id}`),
    ...getEmbeddableTools().map((tool) => `embed/${tool.slug}`),
    ...legalPages,
  ];
  return paths.map((path) => ({ params: { path }, props: { newPath: finalTarget(path) } }));
}

const { newPath } = Astro.props as { newPath: string };
const fullUrl = `${SITE.url}${newPath}`;
// T2 removes the legacy /zh/* aliases from the index set. They stay available
// as compatibility stubs, but must not create a second indexable URL for the
// retained canonical destination.
---
<!--
  2026-07-25 SEO 稽核（CEO 派工）：拿掉大部分 /zh/* stub 的 noindex，只留 canonical +
  meta refresh，讓 Google 能把舊網址的訊號合併到新網址（noindex 頁不會走 index
  pipeline，canonical 提示形同失效）。/zh/embed/* 例外：目標本身就是刻意 noindex
  的內嵌頁，維持 noindex 才不會被 SEO collapse audit 判定為「指到未收錄頁」。
  等 Cloudflare 端把 /zh/* 建成真 301 Bulk Redirect 上線後，這整批 stub 頁面
  （本檔＋ dist/zh/**）就可以整批移除，不再需要這層 Astro fallback。
-->
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={fullUrl} />
  <meta http-equiv="refresh" content={`0; url=${newPath}`} />
  <meta name="robots" content="noindex,follow" />
  <title>Redirecting...</title>
</head>
<body>
  <p>Redirecting to <a href={newPath}>{fullUrl}</a>.</p>
</body>
</html>
