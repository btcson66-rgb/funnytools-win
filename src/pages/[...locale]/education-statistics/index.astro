---
import AuthorByline from '../../../components/AuthorByline.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, type Locale } from '../../../config/site';
import { getLiveToolsForLocale } from '../../../data/tools';
import { t } from '../../../i18n/ui';
import { localePath, localeUrlPair, toolUrl } from '../../../lib/url';
import { authorPersonJsonLd, breadcrumbJsonLd, collectionPageJsonLd, techArticleJsonLd } from '../../../lib/seo';
import { FIRST_PUBLISHED } from '../../../lib/articleDates';
import { isIndexablePath } from '../../../lib/indexPolicy';

// P2 batch 4 (2026-10-17): this hub absorbed /category/statistics/ (now a redirect stub). It is the entry page
// of the site: situations first, then one sentence per tool saying which question it answers.
// 2026-11-08: added the formula comparison table, three verified worked examples, common mix-ups and sources.
const REVIEWED_AT = '2026-11-08';

export function getStaticPaths() {
  return SITE.locales.map((lang) => ({
    params: { locale: lang === SITE.defaultLocale ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const ui = t(lang);
const hubPath = localePath(lang, 'education-statistics');

const copy = {
  zh: {
    title: '成績統計工具：依你的問題找計算器',
    seoTitle: '成績統計工具總覽：T分數計算機、Z分數換算、PR值、標準差與段考加權平均',
    description: '台灣學生與老師的成績統計工具總覽：T分數計算機、Z分數換算、PR值計算機、班排百分比換算、段考加權平均計算機、學期總平均計算、教甄分數換算、標準差計算機與獨立樣本t檢定，每個工具附算例與來源。',
    lead: '先想你手上的問題是什麼，再選工具：想知道分數在一群人裡的位置，用 Z、T、PR 或班排；想把幾項成績合成一個數字，用學期成績、加權平均或教甄成績；想描述或比較資料，用標準差與 t 檢定。每個工具頁都附算例、來源與最後審核日期。',
    breadcrumb: '成績統計工具',
    toolWord: '開啟',
    footer: '所有計算都在你的瀏覽器裡完成，輸入的分數不會上傳。正式成績、簡章與測驗報表以學校或主辦單位公告為準；工具只幫你照規則算、並把算法寫清楚。',
  },
  en: {
    title: 'Score and statistics tools: find the calculator for your question',
    seoTitle: 'Score and statistics tools | T score, PR, SD, weighted average',
    description: 'Entry page for the score and statistics tools: where a score sits in a group, how semester grades combine, whether two means differ, how a teacher-exam total is built.',
    lead: 'Start from the question, then pick the tool: where a score sits in a group (Z, T, PR, class rank), how several scores combine into one number (semester grade, weighted average, teacher exam), or how to describe and compare data (standard deviation, t test). Each tool page has worked examples, sources and a last-reviewed date.',
    breadcrumb: 'Score and statistics tools',
    toolWord: 'Open',
    footer: 'Everything is calculated in your browser and nothing you type is uploaded. Official grade reports and notices from your school or exam body take precedence.',
  },
}[lang];

interface Item { slug: string; asks: Record<Locale, string> }
interface Group { id: string; title: Record<Locale, string>; intro: Record<Locale, string>; items: Item[] }

const groups: Group[] = [
  {
    id: 'position',
    title: { zh: '我的分數在這群人裡站哪裡', en: 'Where does my score sit in the group' },
    intro: {
      zh: 'Z 分數與 T 分數需要這個團體的平均數與標準差；PR 與班排看的是「幾個人比你低、幾個人同分」或名次，不需要平均與標準差。四個都在回答位置，但輸入不同，換算不能混用：T＝50＋10z，T 不是百分制，也不等於 PR。',
      en: 'Z and T scores need the group mean and standard deviation; PR and class rank use counts or rank and do not. All four describe position, but they take different inputs and cannot be swapped: T = 50 + 10z, T is not a percentage and is not PR.',
    },
    items: [
      { slug: 'z-score-calculator', asks: { zh: '這個分數高於平均幾個標準差？在常態假設下大約勝過多少比例的人？', en: 'How many standard deviations above the mean is this score, and about what share of people does it beat if the scores are roughly normal?' } },
      { slug: 't-score-calculator', asks: { zh: '把分數放到平均 50、標準差 10 的尺度上是多少？T 分數怎麼看、換成 PR 大約是多少？', en: 'What is the score on the mean-50, SD-10 scale, how do I read it, and roughly what PR is it?' } },
      { slug: 'percentile-rank-calculator', asks: { zh: '40 人裡有幾人比我低、幾人同分，我的 PR 是多少？為什麼最高只到 99？', en: 'With this many people below me and tied with me, what is my PR, and why does it top out at 99?' } },
      { slug: 'class-rank-percentile-calculator', asks: { zh: '班排第 6 名、全班 40 人，是前百分之幾？PR 是多少？有並列怎麼辦？', en: 'Rank 6 in a class of 40 is the top how many percent, and what PR is that, with ties?' } },
    ],
  },
  {
    id: 'combine',
    title: { zh: '幾項成績怎麼合成一個數字', en: 'How do several scores combine into one number' },
    intro: {
      zh: '平時、段考、期末的占分不同時，簡單平均會算錯；要用占分比例或學分當權重。權重怎麼訂、小數怎麼進位，都以學校評量辦法或簡章為準，工具只照你輸入的規則算。',
      en: 'When coursework, midterms and finals carry different weights, a simple average is wrong; use the weights or credits. How weights are set and how decimals are rounded is up to your school or the exam notice; the tools only apply the rule you enter.',
    },
    items: [
      { slug: 'grade-average', asks: { zh: '平時 30%、段考各 30% 與 40% 時學期成績是多少？期末至少要考幾分？', en: 'What is the semester grade with the given weights, and how many points do I need on the final?' } },
      { slug: 'weighted-average-calculator', asks: { zh: '科目學分不同時，加權平均是多少？和簡單平均差多少？', en: 'With different credits per subject, what is the weighted average and how far is it from the simple one?' } },
      { slug: 'teacher-exam-score-converter', asks: { zh: '筆試、試教、口試依配分加權後，教甄總成績是多少？', en: 'What is the weighted teacher-exam total from written, teaching-demo and interview scores?' } },
    ],
  },
  {
    id: 'describe',
    title: { zh: '這批資料有多分散、兩組有沒有差異', en: 'How spread out is the data, and do two groups differ' },
    intro: {
      zh: '先用標準差看一組分數的分散程度，要比較兩個班或兩種教法時，再把兩組的人數、平均與標準差放進 t 檢定。標準差有母體與樣本兩種，選哪一種取決於你手上的資料是整個群體還是抽樣。',
      en: 'Use the standard deviation to see how spread out one set of scores is; to compare two classes or two methods, put each group’s n, mean and SD into the t test. The SD comes in population and sample versions, depending on whether you hold the whole group or a sample.',
    },
    items: [
      { slug: 'standard-deviation', asks: { zh: '一串分數的母體與樣本標準差各是多少？Excel 該用 STDEV.P 還是 STDEV.S？', en: 'What are the population and sample SD of a list of scores, and should Excel use STDEV.P or STDEV.S?' } },
      { slug: 'independent-samples-t-test-calculator', asks: { zh: '兩個班的平均差 5 分是真的有差，還是抽樣誤差？Welch 與 Student 差在哪？', en: 'Is a 5-point gap between two class means real or sampling noise, and how do Welch and Student differ?' } },
    ],
  },
  {
    id: 'classroom',
    title: { zh: '課堂上抽人、分組、排順序、交換禮物', en: 'Picking, grouping, ordering and gift exchange in class' },
    intro: {
      zh: '這個工具不算成績，只負責用亂數決定「輪到誰」：抽人（可不重複）、依組數或每組人數分組、把報告順序打亂，或做交換禮物配對（保證沒有人抽到自己）。',
      en: 'This tool does not compute grades; it only decides whose turn it is: draw names without repeats, split into groups by number or size, shuffle a presentation order, or match a gift exchange where nobody draws themselves.',
    },
    items: [
      { slug: 'random-name-picker', asks: { zh: '30 人抽 3 位且不重複怎麼抽？38 人每組 4 人怎麼分？交換禮物怎麼配對才不會抽到自己？電腦抽籤的亂數怎麼來？', en: 'How do I draw 3 of 30 without repeats, split 38 people into groups of 4, match a gift exchange so nobody draws themselves, and where does the randomness come from?' } },
    ],
  },
];

interface FormulaRow {
  id: string;
  name: Record<Locale, string>;
  formula: string;
  when: Record<Locale, string>;
  sheet: string;
  tools: { slug: string; label: Record<Locale, string> }[];
}

// Every formula and spreadsheet function below is the one the linked tool page uses and documents with a
// checked example; the worked examples further down were computed with src/lib/educationStats.ts.
const formulaRows: FormulaRow[] = [
  {
    id: 'z',
    name: { zh: 'Z 分數', en: 'Z score' },
    formula: 'Z = (X − M) ÷ SD',
    when: {
      zh: '想知道一個分數高於或低於平均幾個標準差，或要把不同科目放到同一把尺上比。需要「同一個團體」的平均 M 與標準差 SD。',
      en: 'To see how many SDs a score is above or below the mean, or to compare different subjects on one scale. Needs the mean M and SD of the same group.',
    },
    sheet: '=STANDARDIZE(X, 平均, 標準差)',
    tools: [{ slug: 'z-score-calculator', label: { zh: 'Z分數計算機（標準分數與常態位置）', en: 'Z score calculator' } }],
  },
  {
    id: 't',
    name: { zh: 'T 分數', en: 'T score' },
    formula: 'T = 50 + 10 × Z',
    when: {
      zh: '要把分數放到「平均 50、標準差 10」的尺度，讓成績單、簡章或報告更好讀。T 不是百分制，也不等於 PR。',
      en: 'To put a score on the mean-50, SD-10 scale for reports and notices. T is not a percentage and is not PR.',
    },
    sheet: '=50+10*STANDARDIZE(X, 平均, 標準差)',
    tools: [{ slug: 't-score-calculator', label: { zh: 'T分數計算機（標準分數換算）', en: 'T score calculator' } }],
  },
  {
    id: 'pr',
    name: { zh: 'PR 值（百分等級）', en: 'Percentile rank (PR)' },
    formula: 'PR = 100 × (B + 0.5 × E) ÷ N',
    when: {
      zh: '想知道「大約有幾成的人分數比我低」。B 是低於你的人數，E 是同分人數（含你），N 是總人數；只有名次時改用班排換算。',
      en: 'To see roughly what share of people scored below you. B = number below, E = tied (including you), N = total; with only a rank, use the class-rank converter.',
    },
    sheet: '=(COUNTIF(範圍,"<"&X)+0.5*COUNTIF(範圍,X))/COUNT(範圍)*100',
    tools: [
      { slug: 'percentile-rank-calculator', label: { zh: 'PR值計算機（百分等級換算）', en: 'Percentile rank calculator' } },
      { slug: 'class-rank-percentile-calculator', label: { zh: '班級排名PR值計算機（名次換前幾％）', en: 'Class rank percentile calculator' } },
    ],
  },
  {
    id: 'sd',
    name: { zh: '標準差', en: 'Standard deviation' },
    formula: 'σ = √[Σ(x − μ)² ÷ N]　s = √[Σ(x − x̄)² ÷ (n − 1)]',
    when: {
      zh: '描述一組分數有多分散，也是 Z、T 分數的分母。手上是整個群體（全班就是全部）用 σ，把資料當成抽樣用 s。',
      en: 'To describe how spread out scores are; it is also the denominator of Z and T. Use σ when you hold the whole group, s when the data is a sample.',
    },
    sheet: '=STDEV.P(範圍) 或 =STDEV.S(範圍)',
    tools: [{ slug: 'standard-deviation', label: { zh: '標準差計算機（母體與樣本）', en: 'Standard deviation calculator' } }],
  },
  {
    id: 'wm',
    name: { zh: '加權平均', en: 'Weighted average' },
    formula: 'x̄w = Σ(wᵢ × xᵢ) ÷ Σwᵢ',
    when: {
      zh: '各項的重要程度不同時：科目學分不同、平時與段考占分不同、合併人數不同的班級。權重不必加總為 100。',
      en: 'When items carry different weight: credits per subject, coursework vs exam shares, classes of different size. Weights need not sum to 100.',
    },
    sheet: '=SUMPRODUCT(分數範圍, 權重範圍)/SUM(權重範圍)',
    tools: [
      { slug: 'weighted-average-calculator', label: { zh: '加權平均計算機（學分與配分）', en: 'Weighted average calculator' } },
      { slug: 'grade-average', label: { zh: '學期成績計算機（平時段考期末加權）', en: 'Semester grade calculator' } },
    ],
  },
  {
    id: 'teacher',
    name: { zh: '教甄分數換算', en: 'Teacher-exam score conversion' },
    formula: '總成績 = Σ(各項成績 × 簡章配分) ÷ Σ配分',
    when: {
      zh: '筆試、試教、口試依簡章配分合成總成績，再依簡章規定的位數四捨五入。配分與是否標準化（T 分數）以當年度簡章為準。',
      en: 'To combine written, teaching-demo and interview scores by the notice’s weights, rounded as the notice says. Weights and any T-score step follow the notice for that year.',
    },
    sheet: '=ROUND(SUMPRODUCT(成績範圍, 配分範圍)/SUM(配分範圍), 2)',
    tools: [{ slug: 'teacher-exam-score-converter', label: { zh: '教甄分數換算計算機（筆試試教口試）', en: 'Teacher exam score converter' } }],
  },
  {
    id: 'ttest',
    name: { zh: '獨立樣本 t 檢定', en: 'Independent-samples t test' },
    formula: 't = (M₁ − M₂) ÷ √(s₁²÷n₁ + s₂²÷n₂)（Welch）',
    when: {
      zh: '比較兩個互不相干的班級或兩種教法的平均，看差距是真的有差還是抽樣誤差。需要兩組各自的人數、平均與樣本標準差。',
      en: 'To compare the means of two unrelated classes or methods and judge whether the gap is real or sampling noise. Needs each group’s n, mean and sample SD.',
    },
    sheet: '=T.TEST(組1範圍, 組2範圍, 2, 3)（Welch 雙尾 p 值）',
    tools: [{ slug: 'independent-samples-t-test-calculator', label: { zh: '獨立樣本t檢定計算機（Welch與Student）', en: 'Independent-samples t test calculator' } }],
  },
];

interface Example {
  id: string;
  title: Record<Locale, string>;
  setup: Record<Locale, string>;
  steps: Record<Locale, string[]>;
  takeaway: Record<Locale, string>;
  tool: string;
}

// Numbers below were computed with the same functions the tools use (tScoreFrom, describeData, independentTTest
// in src/lib/educationStats.ts). The class data are made-up inputs chosen to show the calculation.
const examples: Example[] = [
  {
    id: 'ex-z-t-pr',
    title: { zh: '驗算一：數學與英文，誰的位置比較前面', en: 'Check 1: maths vs English, which sits higher' },
    setup: {
      zh: '小安數學考 82 分（全班平均 70、標準差 10），英文考 76 分（全班平均 64、標準差 8）。數字是為示範設定的假設值，兩科都假設近似常態分配。',
      en: 'An invented student scores 82 in maths (class mean 70, SD 10) and 76 in English (class mean 64, SD 8); both subjects are assumed roughly normal.',
    },
    steps: {
      zh: [
        '數學：Z＝(82−70)÷10＝1.20；T＝50＋10×1.20＝62；常態假設下 PR 約 88.5（Φ(1.20)＝0.8849）。',
        '英文：Z＝(76−64)÷8＝1.50；T＝50＋10×1.50＝65；常態假設下 PR 約 93.3（Φ(1.50)＝0.9332）。',
      ],
      en: [
        'Maths: Z = (82 − 70) ÷ 10 = 1.20; T = 50 + 10 × 1.20 = 62; under normality PR ≈ 88.5 (Φ(1.20) = 0.8849).',
        'English: Z = (76 − 64) ÷ 8 = 1.50; T = 50 + 10 × 1.50 = 65; under normality PR ≈ 93.3 (Φ(1.50) = 0.9332).',
      ],
    },
    takeaway: {
      zh: '英文原始分數比數學低 6 分，但 T 分數高 3 分，相對位置更前面，因為英文全班的平均與標準差都較低。這個 PR 只在常態假設下成立；用實際人數算的 PR 要改用中點法公式。',
      en: 'English has the lower raw score but a T score 3 points higher, because the class mean and SD are lower. This PR holds only under normality; for a PR from real head counts use the midpoint formula.',
    },
    tool: 't-score-calculator',
  },
  {
    id: 'ex-sd',
    title: { zh: '驗算二：同一組分數，母體與樣本標準差差多少', en: 'Check 2: population vs sample SD on the same scores' },
    setup: {
      zh: '五位學生的小考成績：72、85、68、90、75（假設數字）。',
      en: 'Five quiz scores: 72, 85, 68, 90, 75 (invented).',
    },
    steps: {
      zh: [
        '平均＝(72＋85＋68＋90＋75)÷5＝78；離均差分別是 −6、＋7、−10、＋12、−3，平方和＝36＋49＋100＋144＋9＝338。',
        '母體標準差 σ＝√(338÷5)＝√67.6＝8.22；樣本標準差 s＝√(338÷4)＝√84.5＝9.19。',
        '在試算表中，=STDEV.P(A2:A6) 得 8.22，=STDEV.S(A2:A6) 得 9.19。',
      ],
      en: [
        'Mean = (72 + 85 + 68 + 90 + 75) ÷ 5 = 78; deviations are −6, +7, −10, +12, −3 and the sum of squares is 36 + 49 + 100 + 144 + 9 = 338.',
        'Population SD σ = √(338 ÷ 5) = √67.6 = 8.22; sample SD s = √(338 ÷ 4) = √84.5 = 9.19.',
        'In a spreadsheet, =STDEV.P(A2:A6) gives 8.22 and =STDEV.S(A2:A6) gives 9.19.',
      ],
    },
    takeaway: {
      zh: '同一批資料，除以 n−1 的樣本標準差比較大。全班成績要拿來算全班自己的 Z、T 分數時，這個班就是完整群體，用 σ；想用這 5 人推論更大的群體時才用 s。',
      en: 'The n − 1 version is larger on the same data. Use σ when the class is the whole group for its own Z and T scores; use s only when you are inferring about a larger group.',
    },
    tool: 'standard-deviation',
  },
  {
    id: 'ex-ttest',
    title: { zh: '驗算三：兩班平均差 5 分，算不算真的有差', en: 'Check 3: a 5-point gap between two classes' },
    setup: {
      zh: '甲班 30 人，平均 75，樣本標準差 10；乙班 28 人，平均 70，樣本標準差 12（假設數字）。用 Welch t 檢定，雙尾，α＝.05。',
      en: 'Class A: n = 30, mean 75, sample SD 10. Class B: n = 28, mean 70, sample SD 12 (invented). Welch t test, two-tailed, α = .05.',
    },
    steps: {
      zh: [
        '標準誤＝√(10²÷30＋12²÷28)＝√(3.3333＋5.1429)＝√8.4762＝2.911。',
        't＝(75−70)÷2.911＝1.717；Welch 自由度 df＝52.72；雙尾 p＝.092；平均差的 95% 信賴區間為 −0.84 到 10.84。',
        '對照：若改用假設兩班變異相同的 Student t，t＝1.728、df＝56、p＝.089，結論相同。',
      ],
      en: [
        'Standard error = √(10² ÷ 30 + 12² ÷ 28) = √(3.3333 + 5.1429) = √8.4762 = 2.911.',
        't = (75 − 70) ÷ 2.911 = 1.717; Welch df = 52.72; two-tailed p = .092; 95% CI of the difference is −0.84 to 10.84.',
        'For comparison, Student’s t (equal variances) gives t = 1.728, df = 56, p = .089; same conclusion.',
      ],
    },
    takeaway: {
      zh: 'p＞.05 且信賴區間包含 0，所以在這個樣本大小下，5 分的差距還不能排除抽樣誤差；這不等於「兩班沒有差」，只是證據不足。要報告時寫明人數、平均、標準差與 p 值。',
      en: 'p > .05 and the interval contains 0, so with these sample sizes a 5-point gap cannot be separated from sampling noise. That is not proof of no difference, only insufficient evidence; report n, means, SDs and p.',
    },
    tool: 'independent-samples-t-test-calculator',
  },
];

const mixups: Record<Locale, string[]> = {
  zh: [
    'T 分數不是百分制：T＝62 不是「62 分」，也不是「勝過 62% 的人」，它只是平均 50、標準差 10 的尺度上的位置。',
    'PR 不是答對率：PR 80 的意思是約八成的人分數比你低，與你考幾分無關；PR 也只在同一個參照團體內才能比較。',
    'Z、T 分數需要同一個團體的平均與標準差：拿全班的平均去換算全年級的分數，結果沒有意義。',
    '母體與樣本標準差不能混用：Excel 的 STDEV.P 與 STDEV.S 差在分母是 n 還是 n−1，資料量越少差距越大。',
    '加權平均的權重單位要一致：同一份表格裡不要一格寫 30、一格寫 0.4；也不要把各班平均直接再平均。',
    '教甄與升學的正式成績，配分、標準化與進位方式以當年度簡章和主辦單位公告為準；本站工具只照你輸入的規則算。',
  ],
  en: [
    'A T score is not a percentage: T = 62 is neither “62 points” nor “beats 62% of people”; it is a position on a mean-50, SD-10 scale.',
    'PR is not a percent correct: PR 80 means about 80% of the group scored below you, whatever your raw score, and only compares within one reference group.',
    'Z and T need the mean and SD of the same group; converting a grade-level score with a class mean is meaningless.',
    'Do not mix population and sample SD: STDEV.P divides by n and STDEV.S by n − 1, and the gap grows as the data gets smaller.',
    'Keep weight units consistent: do not write 30 in one cell and 0.4 in another, and do not average class means directly.',
    'For official teacher-exam or admission scores, weights, standardisation and rounding follow that year’s notice; the tools only apply the rule you enter.',
  ],
};

