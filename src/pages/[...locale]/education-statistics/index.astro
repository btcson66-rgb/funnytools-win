const chooser: Record<Locale, { heading: string; intro: string; steps: string[] }> = {
  zh: {
    heading: '四個步驟選對工具',
    intro: '不確定從哪裡開始時，照下面的順序問自己，通常第二步就能決定要用哪一個計算器。',
    steps: [
      '先看手上有什麼資料：只有自己的分數加上全班平均與標準差，用 Z 或 T 分數；有全班每個人的分數，可以算 PR 與標準差；只有名次與全班人數，用班級排名換算。',
      '再看要回答什麼問題：「我站在哪裡」用 Z、T、PR；「幾項成績怎麼合成一個數字」用加權平均、學期成績或教甄換算；「兩組有沒有差」先用標準差看分散，再用 t 檢定。',
      '確認規則的出處：學校的評量辦法、教師甄試簡章或主辦單位公告優先，工具只是照你輸入的權重與進位規則計算。',
      '用試算表對一次：把上面對照表的函數貼進 Excel 或 Google 試算表，與計算機的結果比對，兩邊一致再放進報告或與家長溝通。',
    ],
  },
  en: {
    heading: 'Four steps to the right tool',
    intro: 'If you are unsure where to start, ask yourself these in order; step two usually settles which calculator to use.',
    steps: [
      'Look at what data you hold: your score plus the class mean and SD means Z or T; every student’s score lets you compute PR and SD; only a rank and a head count means the class-rank converter.',
      'Decide the question: “where do I stand” is Z, T or PR; “how do several scores combine” is weighted average, semester grade or teacher-exam conversion; “do two groups differ” is SD first, then the t test.',
      'Confirm where the rule comes from: your school’s grading rules or the exam notice come first; the tools only apply the weights and rounding you enter.',
      'Cross-check in a spreadsheet: paste the functions from the table above into Excel or Google Sheets and compare with the calculator before you quote the result.',
    ],
  },
}[lang];

const sectionCopy = {
  zh: {
    tableHeading: '公式、用途與試算表函數對照表',
    tableIntro: '下表把七個最常被問到的指標放在一起：公式、什麼時候該用、在 Excel 與 Google 試算表怎麼算，以及本站對應的計算機。公式與函數都與各工具頁使用並驗算過的一致；括號裡的 X 是原始分數，範圍指放分數的儲存格。',
    tableCaption: '成績統計指標的公式、適用情境、試算表函數與對應工具',
    cols: ['指標', '公式', '什麼時候用', 'Excel／Google 試算表', '對應工具'],
    examplesHeading: '三個可重現的驗算範例',
    examplesIntro: '下面的班級與分數是為了示範算法而設定的假設數字，不是真實學生的資料。每個數字都用與工具相同的公式算過，你可以在對應的計算機輸入同樣的數字重現。',
    exampleTool: '用計算機重現',
    mixupHeading: '最常見的六個混淆',
    sourcesHeading: '公式與函數的資料來源',
  },
  en: {
    tableHeading: 'Formulas, use cases and spreadsheet functions',
    tableIntro: 'The seven most-asked measures side by side: formula, when to use it, how to compute it in Excel or Google Sheets, and the matching calculator. X is a raw score and a range is the cells holding the scores.',
    tableCaption: 'Formulas, use cases, spreadsheet functions and tools for score statistics',
    cols: ['Measure', 'Formula', 'When to use it', 'Excel / Google Sheets', 'Tool'],
    examplesHeading: 'Three reproducible worked checks',
    examplesIntro: 'The classes and scores below are invented to show the calculation. Each number was computed with the same formula the tools use; enter the same values in the linked calculator to reproduce it.',
    exampleTool: 'Reproduce with the calculator',
    mixupHeading: 'Six common mix-ups',
    sourcesHeading: 'Sources for the formulas and functions',
  },
}[lang];

const live = getLiveToolsForLocale(lang);
const resolved = groups
  .map((group) => ({
    ...group,
    items: group.items
      .map((item) => ({ ...item, tool: live.find((tool) => tool.slug === item.slug) }))
      .filter((item) => item.tool && isIndexablePath(toolUrl('zh', item.slug))),
  }))
  .filter((group) => group.items.length > 0);

const breadcrumbItems = [
  { name: ui.breadcrumbHome, href: localePath(lang) },
  { name: copy.breadcrumb, href: hubPath },
];

const jsonLd = [
  {
    ...collectionPageJsonLd(lang, copy.title, copy.description, hubPath),
    author: authorPersonJsonLd(),
    dateModified: REVIEWED_AT,
  },
  breadcrumbJsonLd(breadcrumbItems),
  techArticleJsonLd(lang, {
    headline: copy.seoTitle,
    description: copy.description,
    path: hubPath,
    datePublished: FIRST_PUBLISHED['/education-statistics/'],
    dateModified: REVIEWED_AT,
    authored: true,
    about: copy.title,
  }),
];
const toolName = (slug: string) => live.find((tool) => tool.slug === slug)?.name[lang] ?? slug;
---

<BaseLayout
  lang={lang}
  title={copy.seoTitle}
  description={copy.description}
  alternateSegments={['education-statistics']}
  altLang={localeUrlPair('education-statistics')}
  jsonLd={jsonLd}
>
  <section class="wrap page-head category-page-head">
    <Breadcrumb
      items={[
        { label: ui.breadcrumbHome, href: localePath(lang) },
        { label: copy.breadcrumb, href: hubPath },
      ]}
    />
    <h1>{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
    <AuthorByline lang={lang} reviewedAt={REVIEWED_AT} />
  </section>

  {resolved.map((group) => (
    <section class="wrap content-section hub-group" id={group.id}>
      <div class="section-head">
        <h2>{group.title[lang]}</h2>
        <p>{group.intro[lang]}</p>
      </div>
      <ul class="hub-tools">
        {group.items.map((item) => (
          <li>
            <a class="hub-tool-name" href={toolUrl(lang, item.slug)}>{item.tool?.name[lang]}</a>
            <span class="hub-tool-asks">{item.asks[lang]}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="wrap content-section" id="choose">
    <div class="section-head">
      <h2>{chooser.heading}</h2>
      <p>{chooser.intro}</p>
    </div>
    <ol class="hub-steps">
      {chooser.steps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section class="wrap content-section hub-formulas" id="formula-table">
    <div class="section-head">
      <h2>{sectionCopy.tableHeading}</h2>
      <p>{sectionCopy.tableIntro}</p>
    </div>
    <div class="hub-table-wrap">
      <table class="hub-table">
        <caption>{sectionCopy.tableCaption}</caption>
        <thead>
          <tr>{sectionCopy.cols.map((col) => <th scope="col">{col}</th>)}</tr>
        </thead>
        <tbody>
          {formulaRows.map((row) => (
            <tr id={`row-${row.id}`}>
              <th scope="row">{row.name[lang]}</th>
              <td><code>{row.formula}</code></td>
              <td>{row.when[lang]}</td>
              <td><code>{row.sheet}</code></td>
              <td>
                <ul class="hub-table-links">
                  {row.tools
                    .filter((tool) => isIndexablePath(toolUrl('zh', tool.slug)))
                    .map((tool) => <li><a href={toolUrl(lang, tool.slug)}>{tool.label[lang]}</a></li>)}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap content-section hub-examples" id="worked-examples">
    <div class="section-head">
      <h2>{sectionCopy.examplesHeading}</h2>
      <p>{sectionCopy.examplesIntro}</p>
    </div>
    {examples.map((example) => (
      <article class="hub-example" id={example.id}>
        <h3>{example.title[lang]}</h3>
        <p>{example.setup[lang]}</p>
        <ol>
          {example.steps[lang].map((step) => <li>{step}</li>)}
        </ol>
        <p class="hub-example-take">{example.takeaway[lang]}</p>
        <p class="hub-example-link"><a href={toolUrl(lang, example.tool)}>{sectionCopy.exampleTool}：{toolName(example.tool)}</a></p>
      </article>
    ))}
  </section>

  <section class="wrap content-section" id="common-mixups">
    <div class="section-head">
      <h2>{sectionCopy.mixupHeading}</h2>
    </div>
    <ul class="hub-mixups">
      {mixups[lang].map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="wrap content-section" id="sources">
    <div class="section-head">
      <h2>{sectionCopy.sourcesHeading}</h2>
    </div>
    <ul class="hub-sources">
      {sources.map((source) => (
        <li><a href={source.href} target="_blank" rel="noopener noreferrer">{source.label}</a>：{source.note[lang]}</li>
      ))}
    </ul>
  </section>

  <section class="wrap content-section">
    <p class="hub-footer">{copy.footer}</p>
  </section>
</BaseLayout>

<style>
  .hub-tools { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .hub-tools li { display: grid; gap: 4px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .hub-tool-name { font-weight: 800; font-size: 1.05rem; color: var(--brand-2, var(--brand)); }
  .hub-tool-name:hover { color: var(--brand); }
  .hub-tool-asks { color: var(--muted); line-height: 1.7; }
  .hub-footer { color: var(--muted); line-height: 1.7; }
  .hub-table-wrap { overflow-x: auto; margin-top: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .hub-table { width: 100%; min-width: 860px; border-collapse: collapse; font-size: 0.95rem; line-height: 1.65; }
  .hub-table caption { padding: 10px 14px; text-align: left; font-weight: 700; color: var(--muted); border-bottom: 1px solid var(--line); }
  .hub-table th, .hub-table td { padding: 10px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .hub-table thead th { color: var(--ink); font-weight: 700; white-space: nowrap; }
  .hub-table tbody th { font-weight: 800; white-space: nowrap; }
  .hub-table tbody tr:last-child > * { border-bottom: none; }
  .hub-table code { font-size: 0.88rem; overflow-wrap: anywhere; }
  .hub-table-links { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .hub-table-links a { font-weight: 700; color: var(--brand-2, var(--brand)); }
  .hub-example { margin-top: 14px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .hub-example h3 { margin: 0 0 8px; font-size: 1.08rem; }
  .hub-example p, .hub-example li { line-height: 1.75; }
  .hub-example ol { margin: 8px 0; padding-left: 1.4em; }
  .hub-example-take { color: var(--muted); }
  .hub-example-link { margin: 8px 0 0; font-weight: 700; }
  .hub-steps { margin: 0; padding-left: 1.4em; display: grid; gap: 8px; line-height: 1.75; }
  .hub-mixups, .hub-sources { margin: 0; padding-left: 1.3em; display: grid; gap: 8px; line-height: 1.75; }
  .hub-sources { color: var(--muted); }
</style>
