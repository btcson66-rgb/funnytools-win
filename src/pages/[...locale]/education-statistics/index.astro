---
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Faq from '../../../components/Faq.astro';
import ToolCard from '../../../components/ToolCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, type Locale } from '../../../config/site';
import { getLiveToolsForLocale, type ToolMeta } from '../../../data/tools';
import { seoGuides, viewSeoGuide, isSeoGuideAvailableInLocale } from '../../../data/seoGuides';
import { t } from '../../../i18n/ui';
import { localePath, localeUrlPair, toolUrl } from '../../../lib/url';
import { breadcrumbJsonLd, collectionPageJsonLd } from '../../../lib/seo';
import { isIndexablePath } from '../../../lib/indexPolicy';

export function getStaticPaths() {
  return SITE.locales.map((lang) => ({
    params: { locale: lang === SITE.defaultLocale ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const ui = t(lang);
const hubPath = localePath(lang, 'education-statistics');

const copy = {
  zh: {
    title: '教育與統計工具中心',
    seoTitle: '教育與統計工具中心 | 成績換算與統計檢定工具',
    description: '免費教育與統計工具中心，整理 T 分數、Z 分數、PR 百分等級、班級排名百分比、加權平均、標準差、獨立樣本 t 檢定與教師甄試成績換算，免註冊、在瀏覽器計算。',
    subtitle: '免費工具，適合台灣的學生、教師與教育考試準備，從學期成績、排名換算到統計檢定逐步整理。',
    breadcrumb: '教育與統計',
  },
  en: {
    title: 'Education & Statistics Tools Center',
    seoTitle: 'Education & Statistics Tools | Score conversion and t test',
    description: 'Free education and statistics tools for T scores, Z scores, percentile rank, class rank, weighted averages, standard deviation, an independent-samples t test and teacher-exam score conversion.',
    subtitle: 'Free tools for students and teachers in Taiwan, from semester grades and rank conversion to statistical tests.',
    breadcrumb: 'Education & Statistics',
  },
}[lang];

const pageSeoTitle = copy.seoTitle;
const pageDescription = copy.description;

const groupCopy = {
  zh: [
    {
      id: 'basic-statistics',
      title: '基礎統計',
      body: [
        '這一組工具適合先整理資料的中心趨勢、離散程度、百分比、標準分數與百分等級。',
        '學生可以用來檢查作業或報告，教師可以用來快速檢視班級分數分布，研究者也能在正式分析前做初步確認。',
        '常見情境包括計算一組測驗分數的標準差、把原始分數轉成 Z 分數或 T 分數，以及估算某個分數約落在第幾百分位。',
      ],
    },
    {
      id: 'research-apa',
      title: '研究與 APA 報告',
      body: [
        '這一組工具協助把統計結果轉成較容易檢查的研究報告文字，特別適合論文、課堂研究與小型研究專案。',
        '目前可產生 APA 7 統計結果句，並支援獨立樣本 t 檢定的摘要統計計算。',
        '說明文字也涵蓋 ANOVA、相關、迴歸與效果量的 APA 寫法，適合在完成正式統計分析後整理報告段落。',
      ],
    },
    {
      id: 'spss-interpretation',
      title: 'SPSS 結果解讀',
      body: [
        '這一組工具適合已經從 SPSS 取得表格，但不確定該看哪一列、如何判斷顯著性或如何寫成結果段落的人。',
        '它會協助整理 t 檢定與 ANOVA 常見輸出，並提醒 Levene 同質性檢定、單純主要效果與事後比較在解讀時的角色。',
        '使用時仍應回到研究設計與課程要求確認最終寫法。',
      ],
    },
    {
      id: 'teacher-score',
      title: '教師考試與教育分數',
      body: [
        '這一組工具聚焦教師甄試、班級排名、常模分數與加權總分等教育現場常見分數問題。',
        '考生可以先估算筆試、口試與試教加權後的總分，教師也可以用來說明排名百分位或標準化分數。',
        '若同時需要 PR、T 分數與 Z 分數，建議先確認原始分數、平均數與標準差來源是否一致。',
        '若要估算期末需要幾分，請先把課程配分確認清楚，再使用期末要考幾分計算器；工具不會替你猜測學校的及格或四捨五入規則。',
      ],
    },
    {
      id: 'semester-grades',
      title: '學期成績與課堂點名',
      body: [
        '這一組放學期成績計算與課堂點名的工具。',
        '學期成績計算器可以算總分、簡單平均與加權平均（學期成績）；隨機姓名抽籤則在你的瀏覽器中從貼上的名單抽出名字，名單不會上傳。',
        '計算學期成績前，請先確認配分與四捨五入規則，並以學校公告為準。',
      ],
    },
  ],
  en: [
    {
      id: 'basic-statistics',
      title: 'Basic Statistics',
      body: [
        'Use these tools to understand spread, percentages, standardized scores, and percentile rank before writing up results.',
        'Students can check homework, teachers can review class score distributions, and researchers can do a quick sanity check before formal analysis.',
        'Example situations include calculating standard deviation for exam scores, converting raw scores to Z or T scores, and estimating where a score sits in a group.',
      ],
    },
    {
      id: 'research-apa',
      title: 'Research & APA Reporting',
      body: [
        'This group helps turn statistical results into clearer report wording for papers, class projects, and small research studies.',
        'It includes APA 7 result sentence generation and an independent-samples t-test calculator based on summary statistics.',
        'The guidance also mentions APA write-ups for ANOVA, correlation, regression, and effect size, so it is useful after your formal analysis is complete.',
      ],
    },
    {
      id: 'spss-interpretation',
      title: 'SPSS Result Interpretation',
      body: [
        'Use this group when you already have SPSS output but need help deciding which row to read and how to explain the result.',
        'The interpreter focuses on common t-test and ANOVA outputs, including Levene\'s test, simple main effects, and post hoc comparisons.',
        'Always check the final wording against your research design, assignment requirements, or supervisor guidance.',
      ],
    },
    {
      id: 'teacher-score',
      title: 'Teacher Exam / Education Score',
      body: [
        'These tools focus on teacher exam scoring, class rank, norm-referenced scores, and weighted totals used in education settings.',
        'Candidates can estimate written, interview, and teaching-demo weighted totals, while teachers can explain rank percentiles and standardized scores.',
        'When using PR, T score, and Z score tools together, make sure the raw score, mean, and standard deviation come from the same reference group.',
      ],
    },
    {
      id: 'semester-grades',
      title: 'Semester grades and classroom picks',
      body: [
        'This group holds the semester-grade and classroom name-picking tools.',
        'The grade average calculator handles totals, simple averages and weighted averages; the random name picker draws names from a pasted list in your browser, and the list is not uploaded.',
        'Before computing semester grades, confirm the weighting and rounding rules against your school\'s announcement.',
      ],
    },
  ],
}[lang];

const groupSlugs = [
  ['standard-deviation', 'percentage-calculator', 'weighted-average-calculator', 'z-score-calculator', 't-score-calculator', 'percentile-rank-calculator', 'standard-error-of-measurement-calculator', 'spearman-brown-calculator', 'learning-gain-calculator', 'weighted-rubric-score-calculator', 'cohen-kappa-calculator'],
  ['apa-7-report-generator', 'independent-samples-t-test-calculator', 'item-analysis-calculator', 'kr20-reliability-calculator'],
  ['spss-result-interpreter'],
  ['teacher-exam-score-converter', 'class-rank-percentile-calculator', 'normalized-score-converter', 'percentile-rank-calculator', 'final-grade-needed-calculator'],
  ['grade-average', 'random-name-picker'],
];

const liveTool = (slug: string): ToolMeta | undefined => {
  return getLiveToolsForLocale(lang).find((tool) => tool.slug === slug);
};

const groups = groupCopy.map((group, index) => ({
  ...group,
  tools: groupSlugs[index]
    .map(liveTool)
    .filter((tool): tool is ToolMeta => Boolean(tool && isIndexablePath(toolUrl(lang, tool.slug)))),
})).filter((group) => group.tools.length > 0);

const resourceCopy = {
  zh: {
    title: '教育統計指南',
    body: '從 T 分數的公式、範例到常見誤解，這篇指南把工具串成可檢查的學習流程。',
    guides: '重點指南',
    viewAllGuides: '閱讀 T 分數教學',
  },
  en: {
    title: 'Education Statistics Guide',
    body: 'From the T-score formula and worked examples to common misreadings, this guide ties the tools into a checkable workflow.',
    guides: 'Featured guide',
    viewAllGuides: 'Read the T-score guide',
  },
}[lang];
const featuredGuides = seoGuides
  .filter((guide) => guide.slug === 't-score-calculator-guide' && isSeoGuideAvailableInLocale(guide, lang))
  .sort((a, b) => a.priority - b.priority)
  .slice(0, 6)
  .map((guide) => viewSeoGuide(guide, lang));
const faqItems = {
  zh: [
    {
      q: 'T 分數和 Z 分數有什麼差別？',
      a: 'Z 分數表示某個分數距離平均數幾個標準差，平均數通常是 0、標準差是 1。T 分數通常把 Z 分數轉成平均數 50、標準差 10 的尺度，較常用於測驗與教育分數報告。',
    },
    {
      q: '什麼時候應該使用 APA 7 統計報告格式？',
      a: '當你在論文、研究報告、課堂作業或投稿稿件中呈現 t 檢定、ANOVA、相關、迴歸或效果量時，可以使用 APA 7 格式整理統計量、自由度、p 值與效果量。',
    },
    {
      q: 'SPSS 的 Levene 檢定要怎麼解讀？',
      a: 'Levene 檢定用來檢查變異數同質性。若結果顯著，通常表示兩組變異數可能不相等，解讀 t 檢定時應考慮使用不假設變異數相等的列，並依課程或研究規範確認寫法。',
    },
    {
      q: '為什麼教師考試會使用加權分數？',
      a: '教師考試常把筆試、口試、試教或其他項目設定不同權重，因為每一項評量重點不同。加權分數能把多個項目依規定比例合成總分，但最後仍應以官方簡章和公告為準。',
    },
  ],
  en: [
    {
      q: 'What is the difference between T-score and Z-score?',
      a: 'A Z-score tells you how many standard deviations a value is from the mean. A T-score is a transformed standard score, commonly using mean 50 and standard deviation 10, which is often easier to read in education and testing contexts.',
    },
    {
      q: 'When should I use APA 7 statistical reporting format?',
      a: 'Use APA 7 reporting when presenting statistical results in papers, research reports, class assignments, or manuscripts, especially for tests such as t tests, ANOVA, correlations, regressions, and effect sizes.',
    },
    {
      q: 'How do I interpret Levene\'s test in SPSS?',
      a: 'Levene\'s test checks whether group variances can be treated as equal. If it is significant, you usually review the row or method that does not assume equal variances, then match the final wording to your research design or assignment rules.',
    },
    {
      q: 'Why are weighted scores used in teacher exams?',
      a: 'Teacher exams often combine written tests, interviews, teaching demonstrations, and other components with different weights. Weighted scores reflect those official proportions, but final decisions should always follow the published exam rules.',
    },
  ],
}[lang];

const breadcrumbItems = [
  { name: ui.breadcrumbHome, href: localePath(lang) },
  { name: copy.breadcrumb, href: hubPath },
];

const jsonLd = [
  collectionPageJsonLd(lang, copy.title, copy.description, hubPath),
  breadcrumbJsonLd(breadcrumbItems)
];
---

<BaseLayout
  lang={lang}
  title={pageSeoTitle}
  description={pageDescription}
  alternateSegments={['education-statistics']}
  altLang={localeUrlPair('education-statistics')}
  jsonLd={jsonLd}
>
  <section class="wrap page-head category-page-head">
    <Breadcrumb
      items={[
        { label: ui.breadcrumbHome, href: localePath(lang) },
        { label: copy.breadcrumb, href: hubPath },
      ]}
    />
    <h1>{copy.title}</h1>
    <p class="lead">{copy.subtitle}</p>
    <div class="education-cta-row" aria-label={lang === 'zh' ? '教育統計常用入口' : 'Education statistics shortcuts'}>
      <a class="btn go" href={localePath(lang, 'tools', 'teacher-exam-score-converter')}>{lang === 'zh' ? '使用教師甄試工具' : 'Use teacher exam tools'}</a>
      <a class="btn ghost" href={localePath(lang, 'tools', 't-score-calculator')}>{lang === 'zh' ? '換算 T / Z / PR' : 'Convert T / Z / PR'}</a>
      <a class="btn ghost" href={localePath(lang, 'guides', 't-score-calculator-guide')}>{lang === 'zh' ? '閱讀 T 分數教學' : 'Read the T-score guide'}</a>
    </div>
  </section>

  {groups.map((group) => (
    <section class="wrap content-section" id={group.id}>
      <div class="section-head">
        <h2>{group.title}</h2>
        {group.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="grid">
        {group.tools.map((tool) => <ToolCard lang={lang} tool={tool} />)}
      </div>
    </section>
  ))}

  <section class="wrap content-section" aria-labelledby="education-resources-title">
    <div class="section-head">
      <h2 id="education-resources-title">{resourceCopy.title}</h2>
      <p>{resourceCopy.body}</p>
    </div>
    <div class="resource-columns">
      <section class="resource-panel" aria-labelledby="education-guides-title">
        <h3 id="education-guides-title">{resourceCopy.guides}</h3>
        <div class="resource-list">
          {featuredGuides.map((guide) => (
            <a href={localePath(lang, 'guides', guide.slug)}>
              <strong>{guide.title}</strong>
              <span>{guide.summary}</span>
            </a>
          ))}
        </div>
        <a class="btn" href={localePath(lang, 'guides', 't-score-calculator-guide')}>{resourceCopy.viewAllGuides}</a>
      </section>
    </div>
  </section>

  <div class="wrap">
    <Faq lang={lang} items={faqItems} />
  </div>
</BaseLayout>

<style>
  .resource-columns { display: grid; grid-template-columns: minmax(0, 1fr); gap: 18px; }
  .education-cta-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .resource-panel { display: grid; align-content: start; gap: 14px; padding: 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--card); box-shadow: var(--shadow-soft); }
  .resource-panel h3 { margin: 0; font-size: 1.18rem; }
  .resource-list { display: grid; gap: 10px; }
  .resource-list a { display: grid; gap: 5px; padding: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .resource-list a:hover strong { color: var(--brand); }
  .resource-list span { color: var(--muted); line-height: 1.6; }
  .resource-panel .btn { justify-self: start; }
  .education-topic-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .education-topic-list span { padding: 5px 9px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--brand-2); font-size: 0.84rem; font-weight: 800; }
  .education-article-sections { display: grid; gap: 22px; margin-bottom: 16px; }
  .education-article-group { display: grid; gap: 12px; }
  .education-article-group-head { display: grid; gap: 5px; }
  .education-article-group-head h3 { margin: 0; font-size: 1.12rem; }
  .education-article-group-head p { margin: 0; color: var(--muted); line-height: 1.6; }
  .education-article-group-head span { justify-self: start; padding: 4px 8px; border: 1px solid var(--line); border-radius: 999px; color: var(--brand-2); font-size: 0.8rem; font-weight: 800; }
  .education-article-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-bottom: 16px; }
  .education-article-grid a { display: grid; gap: 6px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .education-article-grid a:hover { border-color: var(--brand); }
  .education-article-grid span { color: var(--muted); line-height: 1.6; }
  @media (max-width: 760px) { .resource-columns { grid-template-columns: 1fr; } .resource-panel { padding: 18px; } }
  @media (max-width: 760px) { .education-article-grid { grid-template-columns: 1fr; } }
</style>
