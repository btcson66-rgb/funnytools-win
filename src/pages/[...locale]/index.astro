---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { SITE, type Locale } from '../../config/site';
import { getToolBySlug, type ToolMeta } from '../../data/tools';
import { absoluteUrl, localePath, toolUrl } from '../../lib/url';
import { organizationJsonLd, websiteJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return SITE.locales.map((lang) => ({
    params: { locale: lang === SITE.defaultLocale ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const zh = lang === 'zh';

// The ten retained tools, grouped by the question the visitor arrives with. The four groups and their ids are
// the same as the sections of the hub (/education-statistics/#position ...), where each tool also gets a
// "which question does it answer" sentence and a longer note. The home page only routes: one sentence per
// group, then the tools. Slugs must stay in sync with INDEXABLE_PATHS in src/lib/indexPolicy.ts.
const groups = [
  {
    id: 'position',
    start: zh ? '我的分數在班上算哪裡' : 'Where does my score sit in the class',
    title: zh ? '我的分數在這群人裡站哪裡' : 'Where does my score sit in the group',
    body: zh
      ? '有同一次考試的全班平均與標準差，用 Z 分數與 T 分數；只有名次與人數，用班排百分比；想知道有多少比例的人分數比你低，用 PR 值。'
      : 'With the class mean and standard deviation of the same exam, use Z and T scores; with only a rank and a head count, use the class-rank percentage; to see what share of people scored below you, use PR.',
    slugs: ['t-score-calculator', 'percentile-rank-calculator', 'class-rank-percentile-calculator', 'z-score-calculator'],
  },
  {
    id: 'combine',
    start: zh ? '幾項成績合成一個數字' : 'Combine several scores into one',
    title: zh ? '幾項成績怎麼合成一個數字' : 'How do several scores combine into one number',
    body: zh
      ? '平時、段考、期末的占分不同，或各科學分不同，就不能用簡單平均，要乘上占分比例或學分。'
      : 'When coursework, midterm and final carry different weights, or subjects carry different credits, a simple average is wrong; multiply by the weights or credits.',
    slugs: ['grade-average', 'weighted-average-calculator', 'teacher-exam-score-converter'],
  },
  {
    id: 'describe',
    start: zh ? '分數多分散、兩組有沒有差' : 'How spread out, do two groups differ',
    title: zh ? '這批資料有多分散、兩組有沒有差異' : 'How spread out is the data, and do two groups differ',
    body: zh
      ? '一組分數用標準差看分散程度；兩個班或兩種教法要比平均，把兩組的人數、平均與標準差放進 t 檢定。'
      : 'Use the standard deviation for one set of scores; to compare two classes or two methods, put each group’s n, mean and SD into the t test.',
    slugs: ['standard-deviation', 'independent-samples-t-test-calculator'],
  },
  {
    id: 'classroom',
    start: zh ? '課堂抽人、分組、交換禮物' : 'Class picks, groups, gift exchange',
    title: zh ? '課堂上抽人、分組、排順序、交換禮物' : 'Picking, grouping, ordering and gift exchange in class',
    body: zh
      ? '貼上名單，用亂數抽人（可不重複）、分組、排順序，或做交換禮物配對（保證沒有人抽到自己）；全程在你的瀏覽器完成。'
      : 'Paste a list to draw names (no repeats if you like), split into groups, shuffle an order, or match a gift exchange where nobody draws themselves; all in your browser.',
    slugs: ['random-name-picker'],
  },
].map((group) => ({
  ...group,
  tools: group.slugs
    .map(getToolBySlug)
    .filter((tool): tool is ToolMeta => Boolean(tool && tool.status === 'live')),
}));

const retainedTools = groups.flatMap((group) => group.tools);

const quickReferenceRows = [
  {
    slug: 't-score-calculator',
    question: zh ? '不同考卷或跨科分數放在同一尺度比較' : 'Compare scores across exams on a 50/10 scale',
    formula: zh ? 'T ＝ 50 ＋ 10 × (X − M) ÷ SD' : 'T = 50 + 10 × (X − M) / SD',
    inputs: zh ? '原始分數 X、同群體平均 M、標準差 SD' : 'Raw score X, group mean M, SD',
  },
  {
    slug: 'z-score-calculator',
    question: zh ? '看單一分數距離全班平均幾個標準差' : 'Check how many SDs a score sits from the mean',
    formula: zh ? 'Z ＝ (X − M) ÷ SD' : 'Z = (X − M) / SD',
    inputs: zh ? '原始分數 X、同群體平均 M、標準差 SD' : 'Raw score X, group mean M, SD',
  },
  {
    slug: 'percentile-rank-calculator',
    question: zh ? '算自己在全體考生裡贏過多少百分比的人' : 'Find the share of test-takers scored below you',
    formula: zh ? 'PR ＝ ⌊((B ＋ 0.5 × E) ÷ N) × 100⌋（最高 99）' : 'PR = floor(((B + 0.5 × E) / N) × 100), max 99',
    inputs: zh ? '低於自己人數 B、同分人數 E、總人數 N' : 'Count below B, tied count E, total N',
  },
  {
    slug: 'class-rank-percentile-calculator',
    question: zh ? '只有名次與全班人數，換算前幾 % 與 PR' : 'Convert rank and headcount into top % and PR',
    formula: zh ? '前 % ＝ (R ÷ N) × 100%；含同分則取平均名次' : 'Top % = (R / N) × 100%; average rank for ties',
    inputs: zh ? '名次 R、總人數 N（選填同分人數）' : 'Rank R, total N (optional tied count)',
  },
  {
    slug: 'grade-average',
    question: zh ? '平時、段考、期末按占比算學期總成績或反推期末目標分' : 'Combine coursework, midterms and final or solve target final score',
    formula: zh ? '學期成績 ＝ Σ(單項得分 × 占比) ÷ Σ占比' : 'Semester grade = Σ(score × weight) / Σweight',
    inputs: zh ? '各次成績與占分百分比（及目標總分）' : 'Component scores, weights (and target grade)',
  },
  {
    slug: 'weighted-average-calculator',
    question: zh ? '依各科學分數或權重計算學期加權平均' : 'Calculate credit-weighted or ratio-weighted mean',
    formula: zh ? '加權平均 ＝ Σ(xᵢ × wᵢ) ÷ Σwᵢ' : 'Weighted mean = Σ(xᵢ × wᵢ) / Σwᵢ',
    inputs: zh ? '各科分數 xᵢ 與對應學分或權重 wᵢ' : 'Scores xᵢ and credits or weights wᵢ',
  },
  {
    slug: 'teacher-exam-score-converter',
    question: zh ? '教師甄試筆試、試教、口試依簡章配分合成總成績' : 'Combine written, demo and interview scores for teacher exams',
    formula: zh ? '教甄總分 ＝ Σ(各科轉換後分數 × 簡章配分比例)' : 'Total = Σ(converted component score × notice weight)',
    inputs: zh ? '筆試、試教、口試分數與當年度簡章配分' : 'Written, demo, interview scores and notice weights',
  },
  {
    slug: 'standard-deviation',
    question: zh ? '衡量一組分數的離散程度（母體 σ 或樣本 s）' : 'Measure score spread (population σ or sample s)',
    formula: zh ? 'σ ＝ √[Σ(xᵢ−μ)²÷N]；s ＝ √[Σ(xᵢ−x̄)²÷(n−1)]' : 'σ = √[Σ(xᵢ−μ)²/N]; s = √[Σ(xᵢ−x̄)²/(n−1)]',
    inputs: zh ? '一串原始分數（依全班母體或抽樣選 N 或 n−1）' : 'List of scores (choose N or n−1)',
  },
  {
    slug: 'independent-samples-t-test-calculator',
    question: zh ? '檢定兩個獨立班級或兩組平均數差異是否達統計顯著' : 'Test whether two independent group means differ significantly',
    formula: zh ? 'Welch t ＝ (M₁−M₂) ÷ √(s₁²÷n₁ ＋ s₂²÷n₂)' : 'Welch t = (M₁−M₂) / √(s₁²/n₁ + s₂²/n₂)',
    inputs: zh ? '兩組各自的人數 n、平均數 M、樣本標準差 SD' : 'Each group’s sample size n, mean M, sample SD',
  },
  {
    slug: 'random-name-picker',
    question: zh ? '課堂不重複抽人、平均分組、排報告順序與交換禮物錯排配對' : 'No-repeat class draw, balanced groups, order shuffle & derangement gift exchange',
    formula: zh ? 'Fisher–Yates 洗牌；錯排數 D(n) ＝ (n−1)(D(n−1)＋D(n−2))' : 'Fisher–Yates shuffle; derangements D(n) = (n−1)(D(n−1)+D(n−2))',
    inputs: zh ? '候選名單（每行一位）、抽取人數或組數設定' : 'Candidate list (one per line), count or group setting',
  },
].map((row) => ({
  ...row,
  tool: getToolBySlug(row.slug),
}));

const title = zh
  ? 'FunnyTools 成績統計工具｜T 分數、PR 值、標準差、加權平均'
  : 'FunnyTools grade and statistics calculators for students and teachers';
const description = zh
  ? '給台灣學生與老師的成績統計工具：T 分數、Z 分數、PR 百分等級、班級排名、加權平均、標準差與獨立樣本 t 檢定。免註冊，在瀏覽器中計算。'
  : 'Grade and statistics calculators for students and teachers in Taiwan: T score, Z score, percentile rank, class rank, weighted average, standard deviation and t test. No sign-up.';
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: zh ? '台灣學生與老師的成績統計工具清單' : 'Grade and statistics calculators for students and teachers',
  numberOfItems: retainedTools.length,
  itemListElement: retainedTools.map((tool, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: tool.name[lang],
    url: absoluteUrl(toolUrl(lang, tool.slug)),
    description: tool.short[lang],
  })),
};
const jsonLd = [organizationJsonLd(lang), websiteJsonLd(lang), itemListJsonLd];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternateSegments={[]}
  canonicalPath={lang === 'zh' ? '/' : `/${lang}/`}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <section class="hero home-hero">
      <p class="eyebrow">{zh ? '給台灣學生與老師' : 'For students and teachers in Taiwan'}</p>
      <h1>{zh ? '給台灣學生與老師的成績統計工具' : 'Grade and statistics tools for students and teachers'}</h1>
      <p class="lead">
        {zh
          ? 'FunnyTools 是成績計算器：把分數換成 T 分數、PR 值或班排百分比，把平時、段考、期末合成學期成績或教甄總分，算標準差與 t 檢定；另有課堂抽籤與分組。輸入的資料只在你的瀏覽器計算，不會上傳。'
          : 'FunnyTools is a set of grade calculators: turn a score into a T score, PR or class-rank percentage, combine coursework, midterm and final into a semester grade or teacher-exam total, compute standard deviations and t tests, or draw and group names in class. What you type is calculated in your browser and not uploaded.'}
      </p>
      <p class="home-start-label">{zh ? '從你手上的問題開始：' : 'Start from your question:'}</p>
      <div class="hero-actions" role="group" aria-label={zh ? '依問題找工具' : 'Find a tool by question'}>
        {groups.map((group, index) => (
          index === 0
            ? <a class="btn go" href={`#${group.id}`}>{group.start}</a>
            : <a class="btn ghost" href={`#${group.id}`}>{group.start}</a>
        ))}
      </div>
      <p class="home-more">
        <a class="inline-link" href={localePath(lang, 'education-statistics')}>
          {zh ? '每個工具能回答哪些問題，見成績統計工具總覽' : 'What each tool answers: the score and statistics tools overview'}
        </a>
      </p>
    </section>

    {groups.map((group) => (
      <section class="content-section" id={group.id} aria-labelledby={`group-${group.id}`}>
        <h2 id={`group-${group.id}`}>{group.title}</h2>
        <p>{group.body}</p>
        <div class="grid compact">
          {group.tools.map((tool) => <ToolCard lang={lang} tool={tool} />)}
        </div>
        <p class="home-group-more">
          <a class="inline-link" href={`${localePath(lang, 'education-statistics')}#${group.id}`}>
            {zh ? '這一組的工具怎麼選' : 'How to choose within this group'}
          </a>
        </p>
      </section>
    ))}

    <section class="content-section" id="formula-reference" aria-labelledby="home-formula-reference">
      <h2 id="home-formula-reference">
        {zh ? '台灣常見成績計算公式與工具速查表' : 'Quick Formula & Calculator Reference'}
      </h2>
      <p>
        {zh
          ? '不確定該帶入哪一條公式時，先對照手上的輸入值與計算目的：位置指標（T、Z、PR、班排）不能直接當成加權總分，比較兩組平均則需看標準差與樣本數。'
          : 'Match your available inputs to the right formula before calculating: relative position metrics (T, Z, PR, class rank) cannot replace weighted totals, and comparing two group means requires both sample size and SD.'}
      </p>
      <div class="home-table-wrap">
        <table class="home-ref-table">
          <caption>
            {zh ? '10 個成績統計與課堂工具的核心公式、輸入欄位與適用情境對照' : 'Core formulas, required inputs, and calculators for all 10 tools'}
          </caption>
          <thead>
            <tr>
              <th scope="col">{zh ? '計算問題' : 'Question'}</th>
              <th scope="col">{zh ? '核心公式與判準' : 'Core formula & rule'}</th>
              <th scope="col">{zh ? '需要的輸入值' : 'Required inputs'}</th>
              <th scope="col">{zh ? '對應工具' : 'Calculator'}</th>
            </tr>
          </thead>
          <tbody>
            {quickReferenceRows.map((row) => row.tool && (
              <tr>
                <td>{row.question}</td>
                <td><code>{row.formula}</code></td>
                <td>{row.inputs}</td>
                <td>
                  <a class="inline-link" href={toolUrl(lang, row.slug)}>
                    {row.tool.name[lang]}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section">
      <h2>{zh ? '資料與責任界線' : 'Data and limitations'}</h2>
      <p>
        {zh
          ? '工具結果適合自我檢查、教學說明與報告草稿；正式的成績單、甄選與研究仍應以原始資料和官方規則為準。'
          : 'Results are for self-checking, teaching and report drafts; official transcripts, selection and research must follow the source data and official rules.'}
      </p>
      <p>
        <a class="inline-link" href={localePath(lang, 'about')}>{zh ? '關於站長與內容審核' : 'About the site owner and review process'}</a>
        · <a class="inline-link" href={localePath(lang, 'privacy')}>{zh ? '隱私權政策' : 'Privacy'}</a>
        · <a class="inline-link" href={localePath(lang, 'support')}>{zh ? '支持本站' : 'Support'}</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .home-start-label { margin: 18px 0 8px; font-weight: 700; }
  .home-more, .home-group-more { margin: 12px 0 0; }
  .home-table-wrap { overflow-x: auto; margin-top: 12px; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .home-ref-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; line-height: 1.6; }
  .home-ref-table caption { padding: 10px 14px; text-align: left; font-weight: 700; color: var(--muted); border-bottom: 1px solid var(--line); }
  .home-ref-table th, .home-ref-table td { padding: 10px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .home-ref-table th { font-weight: 700; color: var(--ink); }
  .home-ref-table tbody tr:last-child td { border-bottom: none; }
</style>
