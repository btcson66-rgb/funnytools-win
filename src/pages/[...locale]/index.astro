---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { SITE, type Locale } from '../../config/site';
import { getToolBySlug, type ToolMeta } from '../../data/tools';
import { INDEXABLE_TOOL_SLUGS } from '../../lib/indexPolicy';
import { localePath } from '../../lib/url';
import { organizationJsonLd, websiteJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return SITE.locales.map((lang) => ({
    params: { locale: lang === SITE.defaultLocale ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const tools = INDEXABLE_TOOL_SLUGS
  .map(getToolBySlug)
  .filter((tool): tool is ToolMeta => Boolean(tool && tool.status === 'live'));
const zh = lang === 'zh';
const title = zh
  ? 'FunnyTools 教育統計工具｜T 分數、PR、標準差與成績計算'
  : 'FunnyTools education statistics and classroom calculators';
const description = zh
  ? '免費使用 T 分數、Z 分數、百分等級、標準差、加權平均、班級排名、獨立樣本 t 檢定與教師甄試換算工具；另提供課堂隨機抽籤。免註冊、直接在瀏覽器使用，並附公式與解讀提醒。'
  : 'Free education statistics, classroom score, and random name tools. No sign-up required.';
const jsonLd = [organizationJsonLd(lang), websiteJsonLd(lang)];
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternateSegments={[]}
  canonicalPath={lang === 'zh' ? '/' : `/${lang}/`}
  jsonLd={jsonLd}
>
  <main class="wrap">
    <section class="hero home-hero">
      <p class="eyebrow">{zh ? '聚焦教育統計與課堂任務' : 'Focused education statistics tools'}</p>
      <h1>{zh ? '教育統計、成績換算與課堂抽籤工具' : 'Education statistics and classroom tools'}</h1>
      <p class="lead">
        {zh
          ? 'FunnyTools 將索引資源集中在有實際搜尋需求的教育統計工具。所有計算工具可免註冊直接使用，並提供公式、例題與使用限制。'
          : 'FunnyTools now concentrates its searchable collection on education statistics and classroom utilities.'}
      </p>
      <div class="hero-actions">
        <a class="btn go" href={localePath(lang, 'education-statistics')}>{zh ? '進入教育統計中心' : 'Education statistics hub'}</a>
        <a class="btn ghost" href={localePath(lang, 'guides', 't-score-calculator-guide')}>{zh ? '閱讀 T 分數教學' : 'Read the T-score guide'}</a>
      </div>
    </section>

    <section class="content-section" aria-labelledby="focused-tools">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">{zh ? '保留索引工具' : 'Focused tools'}</p>
          <h2 id="focused-tools">{zh ? '教育統計與課堂工具' : 'Education and classroom calculators'}</h2>
        </div>
        <a class="inline-link" href={localePath(lang, 'category', 'statistics')}>{zh ? '查看統計分類' : 'Statistics category'}</a>
      </div>
      <div class="grid compact">
        {tools.map((tool) => <ToolCard lang={lang} tool={tool} />)}
      </div>
    </section>

    <section class="content-section">
      <h2>{zh ? '如何選擇工具' : 'Choose the right tool'}</h2>
      <div class="info-grid">
        <article>
          <h3>{zh ? '標準化與相對位置' : 'Standardization and rank'}</h3>
          <p>{zh ? '用 T 分數、Z 分數、百分等級與班級排名工具比較不同分布中的相對位置。' : 'Use T scores, Z scores, percentiles, and class rank.'}</p>
        </article>
        <article>
          <h3>{zh ? '描述統計與加權成績' : 'Descriptive statistics'}</h3>
          <p>{zh ? '用標準差、加權平均與成績平均工具檢查集中趨勢、離散程度及配分。' : 'Check spread, averages, and weighted scores.'}</p>
        </article>
        <article>
          <h3>{zh ? '推論統計' : 'Inference'}</h3>
          <p>{zh ? '用獨立樣本 t 檢定工具比較兩組平均數，並回到原始假設與資料條件解讀。' : 'Compare two group means with an independent-samples t test.'}</p>
        </article>
      </div>
    </section>

    <section class="content-section">
      <h2>{zh ? '資料與責任界線' : 'Data and limitations'}</h2>
      <p>{zh ? '工具結果適合教學、自我檢查與報告草稿；正式考試、研究與行政文件仍應依原始資料、官方規則與專業判斷確認。' : 'Results support learning and checking, but formal decisions still require source data and professional review.'}</p>
      <p><a class="inline-link" href={localePath(lang, 'about')}>{zh ? '了解 FunnyTools' : 'About FunnyTools'}</a> · <a class="inline-link" href={localePath(lang, 'privacy')}>{zh ? '隱私權政策' : 'Privacy'}</a> · <a class="inline-link" href={localePath(lang, 'support')}>{zh ? '支持本站' : 'Support'}</a></p>
    </section>
  </main>
</BaseLayout>
