---
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ToolCard from '../../../components/ToolCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE, type Locale } from '../../../config/site';
import { categories } from '../../../data/categories';
import { getToolsByCategory } from '../../../data/tools';
import { t } from '../../../i18n/ui';
import { INDEXABLE_TOOL_SLUGS } from '../../../lib/indexPolicy';
import { absoluteUrl, localePath, localeUrlPair } from '../../../lib/url';
import { breadcrumbJsonLd } from '../../../lib/seo';
import { getToolContent } from '../../../lib/toolContent';

// P1 (2026-10-15): this is the single "other tools" page. General-purpose tools
// (PDF, image, text, time, money ...) stay usable for existing direct visitors,
// but the page is noindex, outside the sitemap and not in the main navigation.
export function getStaticPaths() {
  return SITE.locales.map((lang) => ({
    params: { locale: lang === SITE.defaultLocale ? undefined : lang },
    props: { lang },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const ui = t(lang);
const zh = lang === 'zh';
const h1 = zh ? '其他小工具' : 'Other tools';
const title = zh ? '其他小工具｜PDF、圖片、文字、時間與金錢' : 'Other tools: PDF, image, text, time and money';
const description = zh
  ? '給已經在使用的訪客保留的通用小工具，包含 PDF、圖片、文字、時間、金錢與抽籤。教育統計工具請回首頁。'
  : 'General-purpose tools kept for existing visitors: PDF, image, text, time, money and random picks. Education statistics tools are on the home page.';
const intro = zh
  ? '這些通用小工具原本就在本站，功能照常保留，但不是本站的主軸，也不會持續擴充。FunnyTools 目前專注於給台灣學生與老師的成績統計工具，請從首頁開始。'
  : 'These general-purpose tools remain available, but they are not the focus of the site and will not be expanded. FunnyTools now concentrates on grade and statistics calculators for students and teachers in Taiwan; start from the home page.';

// Everything except the retained education-statistics tools, which live on the home page.
const retainedSlugs = new Set<string>(INDEXABLE_TOOL_SLUGS);
const groupedCategories = categories
  .map((category) => ({
    category,
    tools: getToolsByCategory(category.id, lang)
      .filter((tool) => !retainedSlugs.has(tool.slug))
      .map((tool) => ({
        tool,
        search: [
          tool.name[lang],
          tool.name.en,
          tool.short[lang],
          tool.slug,
          getToolContent(tool.slug, lang)?.keywords?.join(' '),
        ].filter(Boolean).join(' ').toLowerCase(),
      })),
  }))
  .filter(({ tools }) => tools.length > 0);

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description: description,
  url: absoluteUrl(localePath(lang, 'tools')),
  inLanguage: SITE.hreflang[lang],
};

const breadcrumbLd = breadcrumbJsonLd([
  { name: ui.breadcrumbHome, href: localePath(lang) },
  { name: h1, href: localePath(lang, 'tools') },
]);
const ga4Enabled = !!SITE.ga4MeasurementId;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternateSegments={['tools']}
  altLang={localeUrlPair('tools')}
  jsonLd={[collectionJsonLd, breadcrumbLd]}
>
  <section class="wrap page-head">
    <Breadcrumb
      items={[
        { label: ui.breadcrumbHome, href: localePath(lang) },
        { label: h1 },
      ]}
    />
    <h1>{h1}</h1>
    <p class="lead">{intro}</p>

    <label class="tools-search">
      <span>{ui.toolsSearch.label}</span>
      <input
        type="search"
        placeholder={ui.toolsSearch.placeholder}
        aria-label={ui.toolsSearch.label}
        autocomplete="off"
        data-tools-search
      />
    </label>
    <nav class="tools-jump" aria-label={zh ? '工具分類' : 'Tool groups'}>
      {groupedCategories.map(({ category }) => <a href={`#${category.id}`}>{category.name[lang]}</a>)}
    </nav>
  </section>

  <section class="wrap tools-list">
    {
      groupedCategories.map(({ category, tools }) => (
        <section class="content-section tool-category-section" id={category.id} data-tool-section>
          <h2>{category.icon} {category.name[lang]}</h2>
          <div class="grid">
            {
              tools.map(({ tool, search }) => (
                <div class="tool-search-item" data-search={search}>
                  <ToolCard lang={lang} tool={tool} />
                </div>
              ))
            }
          </div>
        </section>
      ))
    }
    <p class="empty-state" data-tools-empty aria-live="polite" hidden>{ui.toolsSearch.empty}</p>
  </section>

  <section class="wrap content-section">
    <h2>{ui.toolsPrivacy.heading}</h2>
    <p>{ui.toolsPrivacy.text}</p>
    <p>
      <a href={localePath(lang)}>{zh ? '回首頁看成績統計工具' : 'Back to the statistics tools'}</a>
      · <a href={localePath(lang, 'privacy')}>{ui.footer.privacy}</a>
      · <a href={localePath(lang, 'contact')}>{ui.footer.contact}</a>
    </p>
  </section>

  <!-- Search script -->
  <script is:inline define:vars={{ ga4Enabled }}>
    const searchInput = document.querySelector('[data-tools-search]');
    const emptyState = document.querySelector('[data-tools-empty]');
    const sections = Array.from(document.querySelectorAll('[data-tool-section]'));
    let searchEventTimer = 0;

    const sendSearchEvent = (query, visibleCount) => {
      if (!ga4Enabled || query === '') return;

      const analyticsWindow = window;
      const eventParams = {
        search_term: query,
        results_count: visibleCount,
      };

      if (typeof analyticsWindow.gtag === 'function') {
        analyticsWindow.gtag('event', 'site_search', {
          ...eventParams,
          ...(analyticsWindow.__ft_existing_ga_ids?.length
            ? { send_to: analyticsWindow.__ft_existing_ga_ids }
            : {}),
        });
      } else {
        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
        analyticsWindow.dataLayer.push(['event', 'site_search', eventParams]);
      }
    };

    if (searchInput instanceof HTMLInputElement && emptyState instanceof HTMLElement) {
      const initialQuery = new URLSearchParams(window.location.search).get('q');
      if (initialQuery) {
        searchInput.value = initialQuery;
      }

      const filterTools = () => {
        const query = searchInput.value.trim().toLowerCase();
        let visibleTotal = 0;

        sections.forEach((section) => {
          if (!(section instanceof HTMLElement)) return;

          const items = Array.from(section.querySelectorAll('[data-search]'));
          let visibleInSection = 0;

          items.forEach((item) => {
            if (!(item instanceof HTMLElement)) return;

            const searchText = item.getAttribute('data-search') || '';
            const isVisible = query === '' || searchText.includes(query);
            item.hidden = !isVisible;

            if (isVisible) {
              visibleInSection += 1;
              visibleTotal += 1;
            }
          });

          section.hidden = visibleInSection === 0;
        });

        emptyState.hidden = visibleTotal > 0;
        window.clearTimeout(searchEventTimer);
        searchEventTimer = window.setTimeout(() => {
          sendSearchEvent(query, visibleTotal);
        }, 500);
      };

      searchInput.addEventListener('input', filterTools);
      filterTools();
    }
  </script>
</BaseLayout>

<style>
  .tools-jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .tools-jump a { padding: 5px 10px; border: 1px solid var(--line); border-radius: 999px; background: var(--card); color: var(--brand-2); font-size: 0.9rem; font-weight: 800; }
</style>
