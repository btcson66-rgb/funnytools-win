    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FunnyTools en español',
  alternateName: 'FunnyTools',
  url: 'https://funnytools.win/es/',
