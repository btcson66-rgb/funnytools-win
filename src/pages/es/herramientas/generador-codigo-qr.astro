---
import QrCodeGenerator from '../../../components/tools/QrCodeGenerator.astro';
import ExpansionToolLayout from '../../../layouts/ExpansionToolLayout.astro';
import {
  spanishQrCodeGenerator,
  spanishQrCodeGeneratorReview,
} from '../../../i18n/expansion/es-tools-03';
---

<ExpansionToolLayout
  routeKey="qr-code-generator"
  canonicalPath="/es/herramientas/generador-codigo-qr/"
  content={spanishQrCodeGenerator}
  categoryLabel="Herramienta de imagen"
  review={spanishQrCodeGeneratorReview}
  relatedTool={{
    name: 'Comprimir imágenes online',
    description: 'Reduce el peso de JPG, PNG o WebP y compara el resultado antes de descargar.',
    href: '/es/herramientas/comprimir-imagenes/',
  }}
>
  <QrCodeGenerator labels={spanishQrCodeGenerator.labels} />
</ExpansionToolLayout>
