---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Faq from '../../../components/Faq.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { assetPath, absoluteUrl, localePath } from '../../../lib/url';

const productPath = '/en/transition-pathway-ledger/';
const freeToolPath = `${localePath('en', 'tools', 'postsecondary-transition-action-planner')}?utm_source=funnytools&utm_medium=owned&utm_campaign=product009_launch&utm_content=product_bridge`;
const PAYHIP_URL = import.meta.env.PUBLIC_PRODUCT_009_PAYHIP_URL || '';
const GUMROAD_URL = import.meta.env.PUBLIC_PRODUCT_009_GUMROAD_URL || '';
const marketplacePending = !PAYHIP_URL;
const marketplaceUrl = (base: string, placement: string) => base ? `${base}${base.includes('?') ? '&' : '?'}utm_source=funnytools&utm_medium=owned&utm_campaign=product009_launch&utm_content=${placement}` : '#marketplace-pending';
const productAssetPath = (name: string) => assetPath('assets', 'product-009', name);
const imageNames = ['01-gumroad-hero.png', '04-student-voice.png', '05-evidence-matrix.png', '06-next-step-queue.png', '07-work-experience.png', '08-perspective-matrix.png', '09-transition-timeline.png', '10-local-first.png'];
const imageUrls = imageNames.map((name) => absoluteUrl(productAssetPath(name)));
const faqItems = [
  { q: 'Does Transition Pathway Ledger require a subscription?', a: 'No. It is a one-time purchase with a US$29 launch price and US$49 regular price. The buyer app does not require an account or cloud database.' },
  { q: 'What can I organize in the ledger?', a: 'You can organize student codes, student voice, family and team input, source-attributed evidence, work and community experiences, postsecondary outcomes, action items, meetings, agency contacts, and a descriptive timeline.' },
  { q: 'Does it determine eligibility, compliance, or a transition recommendation?', a: 'No. It is a local organizational workspace. It does not make eligibility, compliance, diagnostic, legal, validated-assessment, or professional recommendation claims.' },
  { q: 'Can I use real student names?', a: 'Use student codes or initials unless your school, district, or organization specifically authorizes identifiable information in this tool. You remain responsible for your local privacy and retention rules.' },
  { q: 'Can I try a transition action plan before buying?', a: 'Yes. The free Postsecondary Transition Action Planner runs locally in your browser and produces a simple user-entered action plan without uploading the fields you type.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Product', name: 'Transition Pathway Ledger', description: 'A local-first transition workspace for organizing student voice, evidence, outcomes, experiences, contacts, meetings, and next steps.', image: imageUrls, brand: { '@type': 'Brand', name: 'FunnyTools' }, ...(PAYHIP_URL ? { offers: { '@type': 'Offer', price: '29', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: PAYHIP_URL } } : {}) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---

<BaseLayout lang="en" title="Transition Pathway Ledger | Transition Planning Tool" description="Organize student voice, evidence, work experiences, outcomes, contacts, meetings, and next steps in one local-first transition pathway ledger." keywords={['transition planning tool', 'postsecondary transition planner', 'special education transition tracker', 'student voice transition planning', 'transition action plan', 'local-first education tool']} type="website" canonicalPath={productPath} hasAlternates={false} jsonLd={jsonLd} ogImage={absoluteUrl('/og/en-study.png')} ogImageAlt="Transition Pathway Ledger — Plan the next step. Track the evidence." automaticAffiliate={false}>
  <article class="product-009-page product-page" data-product-page="product-009">
    <section class="product-hero wrap" aria-labelledby="product-title"><Breadcrumb items={[{ label: 'Home', href: localePath('en') }, { label: 'Transition Pathway Ledger' }]} /><div class="hero-grid"><div class="hero-copy"><p class="eyebrow">ONE-TIME PURCHASE · LOCAL-FIRST · US$29 LAUNCH PRICE</p><h1 id="product-title">Transition Pathway Ledger</h1><p class="hero-message">Plan the next step.<br />Track the evidence.<br />Keep the pathway visible.</p><p class="lead">A calm local workspace for organizing student voice, family and team input, experiences, outcomes, contacts, meetings, and user-defined next steps.</p><div class="cta-row"><a class:list={['btn', 'go', { 'is-pending': marketplacePending }]} data-product-event="product_009_marketplace_click" data-destination="payhip" data-placement="hero" data-marketplace-pending={marketplacePending ? 'true' : undefined} href={marketplaceUrl(PAYHIP_URL, 'hero')} aria-disabled={marketplacePending ? 'true' : undefined}>{marketplacePending ? 'PAYHIP CHECKOUT PENDING' : 'GET TRANSITION PATHWAY LEDGER — $29'}</a><a class="btn ghost" data-product-event="product_009_cta_click" data-destination="free_tool" data-placement="hero" href={freeToolPath}>TRY THE FREE TRANSITION ACTION PLANNER</a></div>{GUMROAD_URL && <p class="secondary-marketplace"><a data-product-event="product_009_marketplace_click" data-destination="gumroad" data-placement="hero" href={marketplaceUrl(GUMROAD_URL, 'hero')}>Prefer Gumroad? View the secondary listing.</a></p>}<p class="privacy-line">No subscription. No account required. No cloud database required for the core buyer app. Use student codes or initials unless authorized otherwise.</p></div><div class="hero-art"><img src={productAssetPath('01-gumroad-hero.png')} alt="Real Transition Pathway Ledger RC1 dashboard with fictional demo records" width="1600" height="1000" loading="eager" decoding="async" /></div></div></section>

    <section class="wrap proof-strip" aria-label="Product promise"><div><strong>Student voice</strong><span>Keep the learner's perspective visible and attributed to its source.</span></div><div><strong>Evidence matrix</strong><span>See recorded, missing, or stale evidence by pathway domain.</span></div><div><strong>Next Step Queue</strong><span>Turn user-entered priorities into clear action ownership and status.</span></div><div><strong>Local-first</strong><span>Your records stay on your device unless you export them.</span></div></section>

    <section class="wrap content-section problem-section" aria-labelledby="problem-title"><div class="section-head narrow"><p class="eyebrow">THE WORK BETWEEN MEETINGS</p><h2 id="problem-title">Transition information should not disappear into separate notes.</h2><p>Student voice may live in a conversation note, work experiences in a spreadsheet, agency contacts in an email thread, and next steps in someone’s memory. The Ledger brings those user-entered records into one reviewable local workspace without pretending that organization is the same thing as compliance or assessment.</p></div><div class="problem-grid"><div class="problem-card"><span>01</span><h3>Listen</h3><p>Record student voice, family input, team perspectives, and the source for each entry.</p></div><div class="problem-card"><span>02</span><h3>Connect</h3><p>Place evidence, experiences, outcomes, meetings, and contacts on a shared timeline.</p></div><div class="problem-card"><span>03</span><h3>Act</h3><p>Keep user-defined next steps visible with owner, status, date, and notes.</p></div></div></section>

    <section class="wrap content-section feature-section" aria-labelledby="voice-title"><div class="feature-copy"><p class="eyebrow">STUDENT VOICE AND PERSPECTIVE</p><h2 id="voice-title">Start with what was actually said.</h2><p>Enter a student code or initials, the student's words or preference, the pathway domain, date, source, and optional context. Family, teacher, related-service, employer, and other perspectives can be recorded separately, so a difference in perspective remains visible instead of being silently merged.</p></div><img src={productAssetPath('04-student-voice.png')} alt="Real RC1 Student voice screen with fictional demo records" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section feature-section reverse" aria-labelledby="evidence-title"><div class="feature-copy"><p class="eyebrow">EVIDENCE AND PERSPECTIVE MATRICES</p><h2 id="evidence-title">See what is recorded and what still needs input.</h2><p>Use evidence rows to record the source, evidence type, date, status, and pathway domain. The matrix labels recorded, missing, and stale entries descriptively. A perspective matrix can show agreement, difference in perspective, or missing input without resolving the disagreement for you.</p></div><img src={productAssetPath('05-evidence-matrix.png')} alt="Real RC1 evidence matrix showing recorded and missing pathway domains" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section feature-section" aria-labelledby="actions-title"><div class="feature-copy"><p class="eyebrow">USER-DEFINED NEXT STEPS</p><h2 id="actions-title">Make the next conversation easier to start.</h2><p>Create an action with a student code, pathway domain, owner, due date, status, priority, and note. Queue views separate do next, waiting, upcoming, and completed items. The app does not create legal deadlines or tell a team what it must do; it keeps the actions the team entered visible.</p></div><img src={productAssetPath('06-next-step-queue.png')} alt="Real RC1 Next Step Queue with fictional action records" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section feature-section reverse" aria-labelledby="experiences-title"><div class="feature-copy"><p class="eyebrow">WORK AND COMMUNITY EXPERIENCES</p><h2 id="experiences-title">Connect experience to the next review.</h2><p>Record work, volunteer, internship, campus, community, travel, or independent-living experiences with a setting, role, date range, support context, and reflection. The descriptive record can preserve what happened and what to revisit; it does not score readiness or issue a placement recommendation.</p></div><img src={productAssetPath('07-work-experience.png')} alt="Real RC1 work and community experience screen" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section gallery-section" aria-labelledby="screenshots-title"><div class="section-head"><p class="eyebrow">REAL RC1 SCREENS</p><h2 id="screenshots-title">A focused workspace for the work between observations and meetings.</h2><p>These are verified screenshots from the frozen Transition Pathway Ledger RC1 buyer build using clearly labelled fictional demo records. They show the actual app, not a concept mockup.</p></div><div class="gallery-grid">{imageNames.slice(5).map((name, index) => <figure><img src={productAssetPath(name)} alt={`Transition Pathway Ledger feature: ${name.replace(/\.png$/, '').replace(/^\d+-/, '').replaceAll('-', ' ')}`} width="1600" height="1000" loading="lazy" decoding="async" /><figcaption>{['Perspective matrix', 'Transition timeline', 'Local-first backup'][index]}</figcaption></figure>)}</div></section>
    <section class="wrap content-section audience-grid" aria-labelledby="audience-title"><div><p class="eyebrow">WHO IT'S FOR</p><h2 id="audience-title">Built for transition teams who need the record to stay connected.</h2><ul class="check-list"><li>Secondary special-education teachers</li><li>Transition coordinators and case managers</li><li>Work-based learning and community-based instruction staff</li><li>School counselors and related-service professionals</li><li>Families organizing their own local planning notes</li><li>Teams coordinating user-defined agency and experience follow-up</li></ul></div><div class="not-for"><p class="eyebrow">KEEP THE BOUNDARY CLEAR</p><h2>Organization, not determination.</h2><p>The Ledger is not a transition assessment, psychometric instrument, IEP writer, Indicator 13 checker, eligibility system, compliance decision, diagnosis tool, legal service, or professional recommendation engine.</p><p>Use it to organize entered information, then apply the procedures, professional judgment, and privacy rules that govern your work.</p></div></section>
    <section class="wrap content-section how-section" aria-labelledby="how-title"><div class="section-head narrow"><p class="eyebrow">HOW IT WORKS</p><h2 id="how-title">A short path from voice to review.</h2></div><ol class="steps"><li><strong>Start empty or load demo data.</strong><span>Demo codes S-01, S-02, and S-03 are visibly labelled as fictional; clear them before entering your own records.</span></li><li><strong>Record perspectives and evidence.</strong><span>Keep sources, dates, domains, and statuses attached to what was entered.</span></li><li><strong>Connect experiences and outcomes.</strong><span>Use the timeline and descriptive reports to prepare for a review or conversation.</span></li><li><strong>Queue the next steps.</strong><span>Assign the actions your team defines, then export a backup or printable snapshot.</span></li></ol></section>
    <section class="wrap content-section bridge-section" aria-labelledby="bridge-title"><div><p class="eyebrow">FREE TRANSITION ACTION PLANNER</p><h2 id="bridge-title">Want to sketch one next step first?</h2><p>Use the free browser tool to define a desired outcome, add a few user-entered actions, and print a simple action plan. It is intentionally smaller than the full ledger and does not upload your fields.</p></div><a class="btn ghost" data-product-event="product_009_cta_click" data-destination="free_tool" data-placement="product_bridge" href={freeToolPath}>TRY THE FREE TRANSITION ACTION PLANNER</a></section>
    <section class="wrap content-section privacy-section" aria-labelledby="privacy-title"><p class="eyebrow">LOCAL-FIRST PRIVACY</p><h2 id="privacy-title">Your records. Your device.</h2><p>The buyer app stores its workspace in browser IndexedDB and works without a runtime network dependency. It includes JSON backup and restore with preview and confirmation, CSV export with spreadsheet-formula safety, printable reports, and a clear-data control. No buyer-app analytics, subscription, required account, AI service, or cloud database is needed for the core workflow. Follow your organization’s rules for authorized data, device security, retention, and backups.</p><div class="privacy-badges"><span>NO SUBSCRIPTION</span><span>NO ACCOUNT</span><span>NO CLOUD REQUIRED</span><span>JSON + CSV EXPORT</span></div></section>
    <div class="wrap"><Faq lang="en" items={faqItems} emitJsonLd={false} /></div>
    <section class="wrap content-section disclaimer-section" aria-labelledby="disclaimer-title"><p class="eyebrow">DISCLAIMER</p><h2 id="disclaimer-title">Keep professional judgment with the professionals.</h2><p>Transition Pathway Ledger organizes information entered by the user. It does not provide legal advice, special-education compliance determinations, diagnosis, eligibility decisions, validated assessment results, placement decisions, or professional recommendations.</p><a href={localePath('en', 'education-statistics')}>Explore more FunnyTools education and statistics tools</a></section>
    <section id="marketplace-pending" class="wrap final-cta" aria-labelledby="final-cta-title"><p class="eyebrow">PLAN THE NEXT STEP. TRACK THE EVIDENCE.</p><h2 id="final-cta-title">Keep the pathway visible without another subscription.</h2><div class="cta-row"><a class:list={['btn', 'go', { 'is-pending': marketplacePending }]} data-product-event="product_009_marketplace_click" data-destination="payhip" data-placement="final_cta" data-marketplace-pending={marketplacePending ? 'true' : undefined} href={marketplaceUrl(PAYHIP_URL, 'final_cta')} aria-disabled={marketplacePending ? 'true' : undefined}>{marketplacePending ? 'PAYHIP CHECKOUT PENDING' : 'GET TRANSITION PATHWAY LEDGER — $29'}</a>{GUMROAD_URL && <a class="btn ghost" data-product-event="product_009_marketplace_click" data-destination="gumroad" data-placement="final_cta" href={marketplaceUrl(GUMROAD_URL, 'final_cta')}>VIEW ON GUMROAD</a>}<a class="btn ghost" data-product-event="product_009_free_to_paid_click" data-destination="free_tool" data-placement="final_cta" href={freeToolPath}>TRY THE FREE PLANNER</a></div><p>One-time purchase · US$29 launch price · US$49 regular price</p></section>
  </article>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      window.__ft_track?.('product_009_view', { product_id: 'PRODUCT-009', placement: 'product_page' });
      document.querySelectorAll('[data-product-event]').forEach((link) => link.addEventListener('click', (event) => {
        if (link.dataset.marketplacePending === 'true') { event.preventDefault(); document.querySelector('#marketplace-pending')?.scrollIntoView({ behavior: 'smooth' }); return; }
        window.__ft_track?.(link.dataset.productEvent, { product_id: 'PRODUCT-009', placement: link.dataset.placement, destination: link.dataset.destination });
      }));
    });
  </script>
</BaseLayout>

<style>
  .product-009-page { --p-ink:#102b3b; --p-teal:#1d7c83; --p-mint:#dcefe9; --p-gold:#d89724; --p-muted:#5d7380; }
  .product-009-page .hero-copy,.product-009-page .hero-art,.product-009-page .feature-copy,.product-009-page .feature-section>img,.product-009-page .audience-grid>div{min-width:0}
  .product-009-page .product-hero{padding-top:24px}.product-009-page .hero-grid{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:30px;align-items:center;margin-top:28px}.product-009-page .hero-copy{padding:32px 0 40px}.product-009-page .hero-copy h1{font-size:clamp(2.5rem,6vw,5.25rem);margin:14px 0 20px;letter-spacing:-.055em;line-height:.96}.product-009-page .hero-message{color:var(--p-ink);font-size:clamp(1.65rem,3.3vw,3rem);line-height:1.02;letter-spacing:-.045em;font-weight:820;margin:0 0 22px}.product-009-page .hero-copy .lead{max-width:620px;font-size:1.18rem;line-height:1.65;color:var(--p-muted)}.product-009-page .hero-art img{width:100%;display:block;border-radius:18px;box-shadow:0 18px 50px rgba(16,43,59,.18)}.product-009-page .eyebrow{color:var(--p-teal);font-size:.79rem;font-weight:850;letter-spacing:.13em;line-height:1.35}.product-009-page .proof-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:20px}.product-009-page .proof-strip div{display:grid;gap:5px;padding:18px;background:var(--card)}.product-009-page .proof-strip span,.product-009-page .problem-card p,.product-009-page .feature-copy p,.product-009-page .audience-grid p,.product-009-page .bridge-section p,.product-009-page .privacy-section p,.product-009-page .disclaimer-section p{color:var(--p-muted);line-height:1.65}.product-009-page .problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}.product-009-page .problem-card{padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:var(--shadow-soft)}.product-009-page .problem-card span{color:var(--p-gold);font-weight:850}.product-009-page .problem-card h3{margin:16px 0 8px}.product-009-page .feature-section{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:32px;align-items:center}.product-009-page .feature-section.reverse{grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr)}.product-009-page .feature-section.reverse .feature-copy{order:2}.product-009-page .feature-section img{width:100%;max-width:520px;justify-self:center;border-radius:18px;box-shadow:0 16px 38px rgba(16,43,59,.14)}.product-009-page .gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.product-009-page .gallery-grid figure{margin:0;display:grid;gap:8px}.product-009-page .gallery-grid img{width:100%;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-soft)}.product-009-page .gallery-grid figcaption{color:var(--p-muted);font-size:.85rem}.product-009-page .audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.product-009-page .audience-grid>div{padding:25px;border:1px solid var(--line);border-radius:14px;background:var(--card)}.product-009-page .not-for{background:linear-gradient(135deg,var(--p-mint),var(--card))!important}.product-009-page .check-list{display:grid;gap:10px;padding-left:1.25rem;color:var(--p-muted);line-height:1.5}.product-009-page .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:0;list-style:none;counter-reset:step}.product-009-page .steps li{counter-increment:step;display:grid;gap:8px;padding:20px;border-top:4px solid var(--p-teal);border-radius:10px;background:var(--card);box-shadow:var(--shadow-soft)}.product-009-page .steps li::before{content:'0' counter(step);color:var(--p-gold);font-weight:850}.product-009-page .steps span{color:var(--p-muted);line-height:1.5;font-size:.93rem}.product-009-page .bridge-section,.product-009-page .final-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:28px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--p-mint),var(--card))}.product-009-page .bridge-section h2,.product-009-page .final-cta h2{margin:8px 0}.product-009-page .privacy-section{border-left:5px solid var(--p-teal);padding-left:24px}.product-009-page .privacy-badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.product-009-page .privacy-badges span{padding:8px 11px;border-radius:999px;background:var(--p-mint);color:var(--p-ink);font-size:.78rem;font-weight:850;letter-spacing:.04em}.product-009-page .final-cta{display:block;text-align:center;margin-bottom:44px}.product-009-page .final-cta .cta-row{justify-content:center}.product-009-page .final-cta>p:last-child{color:var(--p-muted);margin:16px 0 0}.product-009-page .is-pending{opacity:.74;cursor:not-allowed}
  @media(max-width:900px){.product-009-page .hero-grid,.product-009-page .feature-section,.product-009-page .feature-section.reverse{grid-template-columns:1fr}.product-009-page .feature-section.reverse .feature-copy{order:0}.product-009-page .feature-section img{max-width:460px}.product-009-page .proof-strip,.product-009-page .problem-grid,.product-009-page .steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:680px){.product-009-page .proof-strip,.product-009-page .problem-grid,.product-009-page .audience-grid,.product-009-page .steps{grid-template-columns:1fr}.product-009-page .gallery-grid{grid-template-columns:repeat(2,1fr)}.product-009-page .bridge-section{display:block}.product-009-page .bridge-section .btn{margin-top:12px}.product-009-page .final-cta .cta-row .btn{width:100%}}
</style>
