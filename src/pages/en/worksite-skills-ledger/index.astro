---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Faq from '../../../components/Faq.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { assetPath, absoluteUrl, localePath } from '../../../lib/url';

const productPath = '/en/worksite-skills-ledger/';
const freeToolPath = `${localePath('en', 'tools', 'job-task-analysis-tracker')}?utm_source=funnytools&utm_medium=owned&utm_campaign=product011_launch&utm_content=product_bridge`;
const payhipUrl = 'https://payhip.com/b/L46FA';
const gumroadUrl = import.meta.env.PUBLIC_PRODUCT_011_GUMROAD_URL || '';
const marketplaceUrl = (base: string, placement: string) => `${base}${base.includes('?') ? '&' : '?'}utm_source=funnytools&utm_medium=owned&utm_campaign=product011_launch&utm_content=${placement}`;
const assets = ['01-payhip-hero.png', '04-task-analysis.png', '05-quick-worksite.png', '06-support-tracking.png', '07-support-fading.png', '08-generalization.png', '09-time-quality.png', '10-local-first.png'];
const imageUrls = assets.map((name) => absoluteUrl(assetPath('assets', 'product-011', name)));
const faqItems = [
  { q: 'What does Worksite Skills Ledger track?', a: 'It organizes user-defined task analysis, step observations, independence, prompts, support types, task quality, task time, work sessions, hours, worksites, generalization coverage, reports, JSON backup, and CSV export.' },
  { q: 'Does NOT OBSERVED count as an incorrect step?', a: 'No. NOT OBSERVED remains visible and is excluded from the valid observed-step denominator.' },
  { q: 'Does it make employment or placement decisions?', a: 'No. It is an observational and organizational tool. Professional interpretation remains with the responsible team.' },
  { q: 'Does the buyer app require an account or subscription?', a: 'No. The core app runs locally in the browser with IndexedDB, JSON backup, CSV export, and print/PDF.' },
  { q: 'Can I use employer or participant names?', a: 'Use participant and site codes unless your organization authorizes identifiable information. You remain responsible for local privacy, access, retention, and device-security rules.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Product', name: 'Worksite Skills Ledger', description: 'A local-first descriptive work-based learning and task analysis workspace.', image: imageUrls, brand: { '@type': 'Brand', name: 'FunnyTools' }, offers: { '@type': 'Offer', price: '29', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: payhipUrl } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---

<BaseLayout lang="en" title="Worksite Skills Ledger | Job Coach Data Tracker" description="Track user-defined task analysis, supports, independence, task time, quality, hours, and worksite observations in a local-first ledger." keywords={['job coach data tracker', 'vocational skills tracker', 'work based learning data', 'special education job skills tracker', 'worksite task analysis', 'supported employment data tracker', 'job site observation tracker']} type="website" canonicalPath={productPath} hasAlternates={false} jsonLd={jsonLd} ogImage={absoluteUrl(assetPath('assets', 'product-011', '03-og.png'))} ogImageAlt="Worksite Skills Ledger — Observe the work. Track the support. See the independence." automaticAffiliate={false}>
  <article class="product-011-page product-page" data-product-page="product-011">
    <section class="product-011-hero wrap"><Breadcrumb items={[{ label: 'Home', href: localePath('en') }, { label: 'Worksite Skills Ledger' }]} /><div class="product-011-hero-grid"><div><p class="eyebrow">ONE-TIME PURCHASE · LOCAL-FIRST · US$29 LAUNCH PRICE</p><h1>Worksite Skills Ledger</h1><p class="product-011-tagline">Observe the work.<br />Track the support.<br />See the independence.</p><p class="product-011-lead">A calm local workspace for task analysis, worksite observations, support patterns, task time, quality, hours, and descriptive work-experience records.</p><div class="cta-row"><a class="btn go" data-product-event="product_011_marketplace_click" data-destination="payhip" data-placement="hero" href={marketplaceUrl(payhipUrl, 'hero')}>GET WORKSITE SKILLS LEDGER — $29</a><a class="btn ghost" data-product-event="product_011_cta_click" data-destination="free_tool" data-placement="hero" href={freeToolPath}>TRY THE FREE JOB TASK ANALYSIS TRACKER</a></div>{gumroadUrl && <p class="secondary-marketplace">Prefer Gumroad? <a data-product-event="product_011_marketplace_click" data-destination="gumroad" data-placement="hero" href={marketplaceUrl(gumroadUrl, 'hero')}>View the secondary listing</a>.</p>}<p class="privacy-line">No subscription. No account required. No cloud database required for the core buyer app. Use participant and site codes unless authorized otherwise.</p></div><img class="product-011-hero-image" src={assetPath('assets', 'product-011', '01-payhip-hero.png')} alt="Real Worksite Skills Ledger RC1 dashboard with fictional participant and site codes" width="1600" height="1000" loading="eager" decoding="async" /></div></section>
    <section class="wrap product-011-proof" aria-label="Product promise"><div><strong>Task analysis</strong><span>Build reusable work tasks with your own steps.</span></div><div><strong>Support patterns</strong><span>Keep prompts, supports, quality, and independence separate.</span></div><div><strong>Across worksites</strong><span>See recorded task coverage without interpreting blank cells.</span></div><div><strong>Local-first</strong><span>Your records stay on your device unless you export them.</span></div></section>
    <section class="wrap product-011-section"><div class="product-011-copy"><p class="eyebrow">THE WORKSITE PICTURE</p><h2>Track the task, not just the completion.</h2><p>Worksite notes often split task analysis, support levels, quality ratings, time, hours, and work-experience context across paper and spreadsheets. The Ledger keeps those entered dimensions visible without turning organization into an employment conclusion.</p></div><div class="product-011-cards"><div><strong>01</strong><h3>Define</h3><p>Create your own task and steps without claiming an occupational standard.</p></div><div><strong>02</strong><h3>Observe</h3><p>Record independent, prompted, not completed, and not observed steps with support and quality labels.</p></div><div><strong>03</strong><h3>Review</h3><p>Use task progress, support trends, worksite matrices, hours, and printable snapshots.</p></div></div></section>
    <section class="wrap product-011-feature"><div><p class="eyebrow">TASK ANALYSIS</p><h2>Build the steps your team actually observes.</h2><p>Create reusable tasks such as Stock Shelves, Fold Towels, Wipe Tables, Prepare Supply Cart, or a custom task. The app stores your steps; it does not prescribe a work standard.</p></div><img src={assetPath('assets', 'product-011', '04-task-analysis.png')} alt="Worksite Skills Ledger task analysis screen with fictional records" width="1600" height="1000" loading="lazy" /></section>
    <section class="wrap product-011-feature reverse"><img src={assetPath('assets', 'product-011', '05-quick-worksite.png')} alt="Worksite Skills Ledger quick worksite logging screen with fictional records" width="1600" height="1000" loading="lazy" /><div><p class="eyebrow">QUICK WORKSITE MODE</p><h2>Participant → site → task → observe.</h2><p>Use the mobile-first flow to create a session and record each step with minimal taps. Observer code, status, time, and notes remain user-entered context.</p></div></section>
    <section class="wrap product-011-feature"><div><p class="eyebrow">PROMPT / SUPPORT TRACKING</p><h2>See the support that was recorded.</h2><p>Keep prompt level, support type, quality, and independence as separate fields. Editable labels are descriptive categories, not a universal hierarchy.</p></div><img src={assetPath('assets', 'product-011', '06-support-tracking.png')} alt="Worksite Skills Ledger support tracking screen with fictional records" width="1600" height="1000" loading="lazy" /></section>
    <section class="wrap product-011-feature reverse"><img src={assetPath('assets', 'product-011', '07-support-fading.png')} alt="Worksite Skills Ledger support trend screen with fictional records" width="1600" height="1000" loading="lazy" /><div><p class="eyebrow">SUPPORT TREND</p><h2>Review patterns across sessions.</h2><p>See the distribution of entered supports over time. The app does not call a fading plan successful or guarantee a future outcome.</p></div></section>
    <section class="wrap product-011-feature"><div><p class="eyebrow">WORKSITE GENERALIZATION</p><h2>See where a task has been recorded.</h2><p>Task × worksite and independence × worksite matrices show recorded coverage. A blank cell means no entered exposure in that context; it is not a statement about ability.</p></div><img src={assetPath('assets', 'product-011', '08-generalization.png')} alt="Worksite Skills Ledger worksite generalization matrix with fictional records" width="1600" height="1000" loading="lazy" /></section>
    <section class="wrap product-011-feature reverse"><img src={assetPath('assets', 'product-011', '09-time-quality.png')} alt="Worksite Skills Ledger time quality and independence report with fictional records" width="1600" height="1000" loading="lazy" /><div><p class="eyebrow">TIME + QUALITY + INDEPENDENCE</p><h2>Keep the measures separate.</h2><p>Record task duration beside user-defined quality and step independence. A faster task is not automatically better, and a quality label does not replace professional interpretation.</p></div></section>
    <section class="wrap product-011-bridge"><div><p class="eyebrow">FREE JOB TASK ANALYSIS TRACKER</p><h2>Try the task matrix before you buy.</h2><p>Enter a few anonymous task steps in the free browser tool and print a compact snapshot. No participant full name, upload, or professional recommendation.</p></div><a class="btn ghost" data-product-event="product_011_free_to_paid_click" data-destination="free_tool" data-placement="product_bridge" href={freeToolPath}>TRY THE FREE TRACKER</a></section>
    <section class="wrap product-011-related" aria-label="Related ledger"><div><p class="eyebrow">RELATED WORKFLOW</p><h2>Continue from worksite observations to transition planning.</h2><p>If your team also records transition outcomes and next-step actions, the Transition Pathway Ledger keeps that adjacent workflow separate and descriptive.</p></div><a class="btn ghost" data-product-event="product_011_cta_click" data-destination="product_009" data-placement="product009_cross_sell" href={localePath('en', 'transition-pathway-ledger') + '?utm_source=funnytools&utm_medium=owned&utm_campaign=product011_launch&utm_content=product009_cross_sell'}>VIEW TRANSITION PATHWAY LEDGER</a></section>
    <section class="wrap product-011-audience"><div><p class="eyebrow">WHO IT'S FOR</p><h2>Built for teams supporting work-based learning.</h2><ul><li>Transition teachers and special-education teams</li><li>Job coaches and vocational instructors</li><li>Community-based instruction staff</li><li>Supported-employment professionals</li><li>School-to-work coordinators</li></ul></div><div><p class="eyebrow">BOUNDARY</p><h2>Observations, not employment decisions.</h2><p>The Ledger is not a vocational aptitude test, employability assessment, hiring-decision system, disability evaluation, payroll tool, employee surveillance tool, or AI career adviser.</p><p>Professional interpretation remains with the responsible team.</p></div></section>
    <section class="wrap product-011-feature"><div><p class="eyebrow">LOCAL-FIRST PRIVACY</p><h2>Your records. Your device.</h2><p>Use IndexedDB, validated JSON restore, CSV export with formula safety, browser print/PDF, and an offline core. No buyer-app analytics, account, subscription, runtime AI, or cloud database.</p><div class="privacy-badges"><span>NO SUBSCRIPTION</span><span>NO ACCOUNT</span><span>OFFLINE CORE</span><span>JSON + CSV EXPORT</span></div></div><img src={assetPath('assets', 'product-011', '10-local-first.png')} alt="Worksite Skills Ledger local-first backup screen with fictional records" width="1600" height="1000" loading="lazy" /></section>
    <div class="wrap"><Faq lang="en" items={faqItems} emitJsonLd={false} /></div>
    <section class="wrap product-011-disclaimer"><p class="eyebrow">DISCLAIMER</p><h2>Keep professional judgment with the professionals.</h2><p>Worksite Skills Ledger is an observational and organizational tool for work-based learning and supported-employment documentation. It does not provide vocational assessment, employment eligibility decisions, hiring recommendations, medical or disability assessment, legal advice, employment-law compliance, IEP compliance determinations, or placement recommendations.</p></section>
    <section class="wrap final-cta"><p class="eyebrow">TRACK THE FULL WORK EXPERIENCE.</p><h2>Keep task, support, time, and context visible.</h2><div class="cta-row"><a class="btn go" data-product-event="product_011_marketplace_click" data-destination="payhip" data-placement="final_cta" href={marketplaceUrl(payhipUrl, 'final_cta')}>GET WORKSITE SKILLS LEDGER — $29</a>{gumroadUrl && <a class="btn ghost" data-product-event="product_011_marketplace_click" data-destination="gumroad" data-placement="final_cta" href={marketplaceUrl(gumroadUrl, 'final_cta')}>VIEW ON GUMROAD</a>}<a class="btn ghost" data-product-event="product_011_free_to_paid_click" data-destination="free_tool" data-placement="final_cta" href={freeToolPath}>TRY THE FREE TRACKER</a></div><p>One-time purchase · US$29 launch price · US$49 regular price</p></section>
  </article>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => { window.__ft_track?.('product_011_view', { product_id: 'PRODUCT-011', placement: 'product_page' }); document.querySelectorAll('[data-product-event]').forEach((link) => link.addEventListener('click', () => window.__ft_track?.(link.dataset.productEvent, { product_id: 'PRODUCT-011', placement: link.dataset.placement, destination: link.dataset.destination }))); });
  </script>
</BaseLayout>

<style>
  .product-011-page{--ws-ink:#102b3b;--ws-teal:#1d7c83;--ws-mint:#dcefe9;--ws-gold:#d89724;--ws-muted:#5d7380}.product-011-page h1,.product-011-page h2,.product-011-page h3{color:var(--ws-ink)}.product-011-hero{padding-top:24px}.product-011-hero-grid{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:34px;align-items:center;margin-top:28px}.product-011-hero h1{font-size:clamp(2.6rem,6vw,5.2rem);margin:14px 0 20px;letter-spacing:-.055em;line-height:.96}.product-011-tagline{font-size:clamp(1.65rem,3.3vw,3rem);line-height:1.02;letter-spacing:-.045em;font-weight:820;margin:0 0 22px}.product-011-lead{max-width:620px;font-size:1.15rem;line-height:1.65;color:var(--ws-muted)}.product-011-hero-image,.product-011-feature img{width:100%;display:block;border-radius:18px;box-shadow:0 18px 50px rgba(16,43,59,.16)}.product-011-page .eyebrow{color:var(--ws-teal);font-size:.79rem;font-weight:850;letter-spacing:.13em;line-height:1.35}.product-011-proof{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:24px}.product-011-proof div{display:grid;gap:5px;padding:18px;background:var(--card)}.product-011-proof span,.product-011-section p,.product-011-cards p,.product-011-feature p,.product-011-bridge p,.product-011-related p,.product-011-audience p,.product-011-disclaimer p{color:var(--ws-muted);line-height:1.65}.product-011-section,.product-011-audience{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:32px;align-items:start;margin-top:82px}.product-011-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.product-011-cards>div{padding:20px;border:1px solid var(--line);border-radius:14px;background:var(--card)}.product-011-cards strong{color:var(--ws-gold)}.product-011-cards h3{margin:15px 0 6px}.product-011-feature{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:34px;align-items:center;margin-top:82px}.product-011-feature.reverse{grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr)}.product-011-feature.reverse>div{order:2}.product-011-bridge,.product-011-related{display:flex;justify-content:space-between;gap:26px;align-items:center;margin-top:82px;padding:30px;border-radius:18px;background:var(--ws-mint)}.product-011-audience{grid-template-columns:repeat(2,1fr);padding:34px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.product-011-audience ul{padding-left:20px;line-height:1.9}.product-011-disclaimer{margin-top:70px;padding:26px;border-left:4px solid var(--ws-gold);background:#fff8e8;border-radius:10px}.product-011-page .privacy-badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.product-011-page .privacy-badges span{padding:8px 10px;border-radius:999px;background:var(--ws-mint);color:#17645f;font-size:.72rem;font-weight:800}.product-011-page .final-cta{margin-top:82px}.product-011-page .secondary-marketplace{color:var(--ws-muted)}
  @media(max-width:800px){.product-011-hero-grid,.product-011-section,.product-011-feature,.product-011-feature.reverse,.product-011-audience{grid-template-columns:1fr}.product-011-feature.reverse>div{order:0}.product-011-proof,.product-011-cards{grid-template-columns:1fr 1fr}.product-011-bridge{display:block}.product-011-bridge .btn{margin-top:16px}}
  @media(max-width:520px){.product-011-proof,.product-011-cards{grid-template-columns:1fr}.product-011-page .cta-row{display:grid}.product-011-page .cta-row .btn{width:100%}}
</style>
