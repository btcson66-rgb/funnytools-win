---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Faq from '../../../components/Faq.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { localePath } from '../../../lib/url';

const toolPath = '/en/tools/abc-behavior-pattern-summary/';
const productPath = `${localePath('en', 'behavior-observation-ledger')}?utm_source=funnytools&utm_medium=owned&utm_campaign=product008_launch&utm_content=free_tool`;
const faqItems = [
  { q: 'Does this ABC tool upload my observations?', a: 'No. The summary is calculated in your browser. The entered student code and ABC fields are not sent to FunnyTools analytics.' },
  { q: 'What does the summary show?', a: 'It shows the number of entered events, counts by antecedent, consequence, context, weekday, and time block.' },
  { q: 'Does it determine behavioral function?', a: 'No. It summarizes the observations you enter. It does not determine behavioral function or replace a functional behavior assessment.' },
];
---

<BaseLayout
  lang="en"
  title="Free ABC Behavior Pattern Summary | FunnyTools"
  description="Summarize ABC behavior observations locally by event count, antecedent, consequence, context, weekday, and time block."
  keywords={['ABC behavior chart', 'ABC data tracker', 'antecedent behavior consequence tracker', 'ABC behavior pattern chart']}
  type="website"
  canonicalPath={toolPath}
  hasAlternates={false}
  jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Free ABC Behavior Pattern Summary', applicationCategory: '教育應用程式', operatingSystem: 'Any', description: 'A local browser tool for descriptive ABC observation summaries.' }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }]}
  automaticAffiliate={false}
>
  <article class="abc-tool-page" data-tool-page="product-008-free-tool">
    <div class="wrap"><Breadcrumb items={[{ label: 'Home', href: localePath('en') }, { label: 'Tools', href: localePath('en', 'tools') }, { label: 'Free ABC Behavior Pattern Summary' }]} /></div>
    <section class="wrap tool-hero"><div><p class="eyebrow">FREE LOCAL BROWSER TOOL</p><h1>Free ABC Behavior Pattern Summary</h1><p class="lead">Enter multiple observations and see a clear descriptive summary of what was recorded across antecedents, consequences, contexts, weekdays, and time blocks.</p></div><div class="privacy-callout"><strong>No data upload.</strong><span>Use a student code or initials only. The tool summarizes the entries in your browser and does not determine behavioral function.</span></div></section>
    <section class="wrap tool-interaction" aria-labelledby="entry-title"><div class="section-heading"><p class="eyebrow">ABC OBSERVATION ENTRY</p><h2 id="entry-title">Add the observations you want to review.</h2></div><form id="abc-form"><div class="form-grid"><label>Student code (optional)<input id="student-code" type="text" maxlength="40" placeholder="S-01" /></label><label>Default setting (optional)<input id="default-setting" type="text" maxlength="100" placeholder="Classroom" /></label></div><div class="observations-head"><h3>Observation rows <span>Enter at least one row.</span></h3><button class="btn ghost" type="button" id="add-row">ADD OBSERVATION</button></div><div id="observation-rows" class="observation-rows"></div><p id="form-error" class="form-error" role="alert" hidden></p><div class="form-actions"><button class="btn go" type="submit">SUMMARIZE OBSERVATIONS</button><button class="btn ghost" type="button" id="reset-tool">RESET</button></div></form></section>
    <section id="results" class="wrap results-section" hidden aria-labelledby="results-title"><div class="section-heading"><p class="eyebrow">DESCRIPTIVE SUMMARY</p><h2 id="results-title">What was recorded in these rows.</h2></div><div id="result-summary" class="result-summary"></div><div class="summary-grid"><section><h3>Antecedent categories</h3><div id="antecedent-table"></div></section><section><h3>Consequence categories</h3><div id="consequence-table"></div></section><section><h3>Context categories</h3><div id="context-table"></div></section><section><h3>Time-block summary</h3><div id="time-table"></div></section></div><div class="bridge-box"><strong>Need more than an ABC summary?</strong><span>Behavior Observation Ledger adds frequency and rate, duration timers, latency, partial and whole interval, MTS, scatterplots, session comparison, printable reports, and full local backup.</span><a class="btn go" data-product-event="product_008_free_to_paid_click" data-placement="free_tool_result" data-destination="product_page" href={productPath}>TRACK THE FULL PICTURE — $29</a></div><p class="safety-note">This tool summarizes the observations you enter. It does not determine behavioral function or replace a functional behavior assessment.</p></section>
    <section class="wrap content-section tool-notes"><h2>Use the summary as a review aid</h2><p>ABC observations can preserve context that is easy to lose when notes are spread across forms. Enter one row per recorded event and keep category labels consistent enough for the counts to be useful.</p><p>The summary counts what you entered. It does not classify a behavior, explain why an event occurred, or recommend a response. For a larger local-first workflow with frequency, rate, duration, latency, interval methods, printable reports, and backup, see <a href={localePath('en', 'behavior-observation-ledger')}>Behavior Observation Ledger</a>.</p></section>
    <div class="wrap faq-wrap"><Faq lang="en" items={faqItems} emitJsonLd={false} /></div>
  </article>

  <script is:inline>
    const rowsElement = document.querySelector('#observation-rows');
    const form = document.querySelector('#abc-form');
    const errorElement = document.querySelector('#form-error');
    const resultsElement = document.querySelector('#results');
    const track = (name, params = {}) => window.__ft_track?.(name, params);
    const sendAnalyticsEvent = (name, params = {}) => track(name, params);
    const sendCustomToolEvent = (name, params = {}) => track(name, params);
    const requiredAnalyticsEvents = ['tool_view', 'tool_started', 'tool_use_started', 'tool_action', 'tool_completed', 'tool_use_completed', 'result_action', 'file_download', 'tool_error'];
    const PRODUCT_ID = 'PRODUCT-008';
    const TOOL_ID = 'abc-behavior-pattern-summary';
    let toolStarted = false;
    let rows = [
      { dateTime: '2026-09-08T08:15', antecedent: 'Instruction', behavior: 'Leaves assigned area', consequence: 'Adult attention', context: 'Independent work' },
      { dateTime: '2026-09-08T09:05', antecedent: 'Transition', behavior: 'Leaves assigned area', consequence: 'Break', context: 'Classroom' },
      { dateTime: '2026-09-08T10:20', antecedent: 'Instruction', behavior: 'Leaves assigned area', consequence: 'No obvious change', context: 'Classroom' },
    ];
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    const field = (label, className, value, type = 'text') => `<label>${label}<input class="${className}" type="${type}" value="${escapeHtml(value)}" maxlength="160" /></label>`;
    function renderRows() {
      rowsElement.innerHTML = rows.map((row, index) => `<div class="observation-row" data-index="${index}"><div class="row-number">${String(index + 1).padStart(2, '0')}</div><div class="row-fields">${field('Date / time', 'row-date', row.dateTime, 'datetime-local')}${field('Antecedent', 'row-antecedent', row.antecedent)}${field('Recorded behavior', 'row-behavior', row.behavior)}${field('Consequence', 'row-consequence', row.consequence)}${field('Context', 'row-context', row.context)}</div>${rows.length > 1 ? `<button class="remove-row" type="button" aria-label="Remove observation ${index + 1}">Remove</button>` : ''}</div>`).join('');
      rowsElement.querySelectorAll('.remove-row').forEach((button) => button.addEventListener('click', () => { const index = Number(button.closest('.observation-row').dataset.index); rows.splice(index, 1); renderRows(); }));
    }
    function collectRows() { return [...rowsElement.querySelectorAll('.observation-row')].map((row) => ({ dateTime: row.querySelector('.row-date').value, antecedent: row.querySelector('.row-antecedent').value.trim(), behavior: row.querySelector('.row-behavior').value.trim(), consequence: row.querySelector('.row-consequence').value.trim(), context: row.querySelector('.row-context').value.trim() })); }
    function markToolStarted(controlType) { if (toolStarted) return; toolStarted = true; sendAnalyticsEvent('tool_started', { control_type: controlType }); sendCustomToolEvent('tool_use_started', { control_type: controlType }); }
    function showError(message) { errorElement.textContent = message; errorElement.hidden = false; sendAnalyticsEvent('tool_error', { error_type: 'validation_or_processing' }); track('product_008_free_tool_error', { product_id: PRODUCT_ID, tool_id: TOOL_ID, source_page: window.location.pathname }); return null; }
    function counts(list, key) { const map = new Map(); list.forEach((row) => { const label = row[key] || 'Not specified'; map.set(label, (map.get(label) || 0) + 1); }); return [...map.entries()].map(([label, count]) => ({ label, count })).sort((a, b) => b.count - a.count || a.label.localeCompare(b.label)); }
    function timeBlock(value) { const date = new Date(value); if (Number.isNaN(date.valueOf())) return 'Unknown'; const hour = date.getHours(); if (hour < 8) return 'Before 8'; if (hour >= 15) return '3+'; return `${hour}–${hour + 1}`; }
    function renderTable(elementId, data) { const element = document.querySelector(`#${elementId}`); element.innerHTML = data.length ? `<table><thead><tr><th>Category</th><th>Count</th></tr></thead><tbody>${data.map((row) => `<tr><td>${escapeHtml(row.label)}</td><td>${row.count}</td></tr>`).join('')}</tbody></table>` : '<p class="muted">No category entered.</p>'; }
    function renderResult(data) { const values = data.map((row) => row.dateTime).filter(Boolean); const latest = values.slice().sort().at(-1); document.querySelector('#result-summary').innerHTML = `<div><small>Recorded events</small><strong>${data.length}</strong><span>Rows included in this summary</span></div><div><small>Most frequent antecedent</small><strong>${escapeHtml(counts(data, 'antecedent')[0]?.label || '—')}</strong><span>Recorded category</span></div><div><small>Most frequent consequence</small><strong>${escapeHtml(counts(data, 'consequence')[0]?.label || '—')}</strong><span>Recorded category</span></div><div><small>Latest entry</small><strong>${escapeHtml(latest ? new Date(latest).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—')}</strong><span>Local browser time</span></div>`; renderTable('antecedent-table', counts(data, 'antecedent')); renderTable('consequence-table', counts(data, 'consequence')); renderTable('context-table', counts(data, 'context')); renderTable('time-table', counts(data.map((row) => ({ label: timeBlock(row.dateTime) })), 'label')); resultsElement.hidden = false; resultsElement.scrollIntoView({ behavior: 'smooth', block: 'start' }); sendAnalyticsEvent('tool_completed'); sendCustomToolEvent('tool_use_completed'); track('product_008_free_tool_complete', { product_id: PRODUCT_ID, tool_id: TOOL_ID, source_page: window.location.pathname }); }
    rowsElement.addEventListener('input', () => { markToolStarted('input'); rows = collectRows(); });
    document.querySelector('#add-row').addEventListener('click', () => { markToolStarted('button'); if (rows.length >= 20) return; rows = collectRows(); rows.push({ dateTime: '', antecedent: '', behavior: '', consequence: '', context: document.querySelector('#default-setting').value.trim() }); renderRows(); });
    form.addEventListener('submit', (event) => { event.preventDefault(); markToolStarted('submit'); sendAnalyticsEvent('tool_action', { action_name: 'summarize_abc' }); errorElement.hidden = true; const data = collectRows(); if (!data.length) return showError('Add at least one observation row.'); if (data.some((row) => !row.dateTime || !row.antecedent || !row.behavior || !row.consequence || !row.context)) return showError('Complete date/time, antecedent, behavior, consequence, and context for each row.'); renderResult(data); });
    document.querySelector('#reset-tool').addEventListener('click', () => { rows = [{ dateTime: '', antecedent: '', behavior: '', consequence: '', context: '' }]; form.reset(); rowsElement.innerHTML = ''; renderRows(); resultsElement.hidden = true; errorElement.hidden = true; });
    document.querySelectorAll('[data-product-event]').forEach((link) => link.addEventListener('click', () => track(link.dataset.productEvent, { product_id: PRODUCT_ID, tool_id: TOOL_ID, placement: link.dataset.placement, destination: link.dataset.destination, source_page: window.location.pathname })));
    renderRows(); sendAnalyticsEvent('tool_view'); track('product_008_free_tool_view', { product_id: PRODUCT_ID, tool_id: TOOL_ID, source_page: window.location.pathname });
  </script>
</BaseLayout>

<style>
  .abc-tool-page{--p-ink:#102b3b;--p-teal:#1d7c83;--p-mint:#dcefe9;--p-gold:#d89724;--p-muted:#5d7380}.abc-tool-page .tool-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.45fr);gap:20px;align-items:end;margin:24px auto 30px}.abc-tool-page .tool-hero h1{font-size:clamp(2.2rem,5vw,4.4rem);letter-spacing:-.055em;line-height:.98;margin:12px 0 18px}.abc-tool-page .lead{max-width:760px;color:var(--p-muted);font-size:1.14rem;line-height:1.65}.abc-tool-page .eyebrow{color:var(--p-teal);font-size:.79rem;font-weight:850;letter-spacing:.13em}.abc-tool-page .privacy-callout{display:grid;gap:8px;padding:18px;border-left:5px solid var(--p-teal);border-radius:10px;background:var(--p-mint);color:var(--p-muted);line-height:1.5}.abc-tool-page .privacy-callout strong{color:var(--p-ink)}.abc-tool-page .tool-interaction,.abc-tool-page .results-section{padding:28px;border:1px solid var(--line);border-radius:16px;background:var(--card);box-shadow:var(--shadow-soft)}.abc-tool-page .section-heading h2{margin:8px 0 20px;color:var(--p-ink)}.abc-tool-page .form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.abc-tool-page label{display:grid;gap:7px;color:var(--p-ink);font-weight:700;font-size:.92rem}.abc-tool-page input{width:100%;min-height:44px;padding:10px 12px;border:1px solid #b5c8cc;border-radius:8px;background:#fff;color:var(--p-ink);font:inherit}.abc-tool-page input:focus{outline:3px solid rgba(29,124,131,.22);border-color:var(--p-teal)}.abc-tool-page .observations-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:26px}.abc-tool-page .observations-head h3{margin:0;color:var(--p-ink)}.abc-tool-page .observations-head h3 span{color:var(--p-muted);font-size:.9rem;font-weight:500}.abc-tool-page .observation-rows{display:grid;gap:10px;margin-top:12px}.abc-tool-page .observation-row{display:grid;grid-template-columns:42px minmax(0,1fr) auto;gap:12px;align-items:start;padding:14px;border:1px solid var(--line);border-radius:10px;background:#f8fbfa}.abc-tool-page .row-number{padding-top:10px;color:var(--p-gold);font-weight:850}.abc-tool-page .row-fields{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.abc-tool-page .remove-row{min-height:44px;padding:10px 12px;border:1px solid #b5c8cc;border-radius:8px;background:#fff;color:var(--p-teal);font-weight:700;cursor:pointer}.abc-tool-page .form-actions,.abc-tool-page .result-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:20px}.abc-tool-page .form-error{margin:16px 0 0;color:#a33a29;font-weight:700}.abc-tool-page .results-section{margin-top:24px}.abc-tool-page .result-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.abc-tool-page .result-summary>div{display:grid;gap:6px;padding:16px;border:1px solid #cde3dc;border-radius:10px;background:#f4fbf8}.abc-tool-page .result-summary small{color:var(--p-muted)}.abc-tool-page .result-summary strong{color:var(--p-ink);font-size:1.16rem;overflow-wrap:anywhere}.abc-tool-page .result-summary span{color:var(--p-muted);font-size:.85rem;line-height:1.4}.abc-tool-page .summary-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:22px}.abc-tool-page .summary-grid section{padding:18px;border:1px solid var(--line);border-radius:12px;background:#fff}.abc-tool-page table{width:100%;border-collapse:collapse}.abc-tool-page th,.abc-tool-page td{padding:9px;text-align:left;border-bottom:1px solid #e2eaec;font-size:.9rem}.abc-tool-page th{color:var(--p-muted);font-size:.78rem;text-transform:uppercase;letter-spacing:.06em}.abc-tool-page .bridge-box{display:grid;gap:7px;margin-top:20px;padding:20px;border-radius:12px;background:linear-gradient(135deg,var(--p-mint),#fff);color:var(--p-muted);line-height:1.5}.abc-tool-page .bridge-box strong{color:var(--p-ink);font-size:1.1rem}.abc-tool-page .bridge-box .btn{width:max-content;margin-top:8px}.abc-tool-page .safety-note{margin-top:18px;padding:12px;border-left:4px solid var(--p-gold);color:var(--p-muted);line-height:1.55}.abc-tool-page .tool-notes{color:var(--p-muted);line-height:1.6}.abc-tool-page .tool-notes h2{color:var(--p-ink)}.abc-tool-page .tool-notes a{color:var(--p-teal);font-weight:750}.abc-tool-page .muted{color:var(--p-muted)}
  @media(max-width:900px){.abc-tool-page .tool-hero,.abc-tool-page .row-fields{grid-template-columns:1fr 1fr}.abc-tool-page .row-fields label:first-child{grid-column:1/-1}.abc-tool-page .result-summary{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.abc-tool-page .tool-hero,.abc-tool-page .form-grid,.abc-tool-page .summary-grid{grid-template-columns:1fr}.abc-tool-page .tool-interaction,.abc-tool-page .results-section{padding:18px}.abc-tool-page .observation-row{grid-template-columns:30px minmax(0,1fr)}.abc-tool-page .row-fields{grid-template-columns:1fr}.abc-tool-page .remove-row{grid-column:2;width:max-content}.abc-tool-page .result-summary{grid-template-columns:1fr}.abc-tool-page .observations-head{align-items:flex-start;flex-direction:column}.abc-tool-page .form-actions .btn,.abc-tool-page .bridge-box .btn{width:100%;text-align:center}}
</style>
