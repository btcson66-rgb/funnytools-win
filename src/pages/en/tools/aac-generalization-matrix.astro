---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Faq from '../../../components/Faq.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { absoluteUrl, localePath } from '../../../lib/url';

const toolPath = '/en/tools/aac-generalization-matrix/';
const productPath = `${localePath('en', 'aac-implementation-ledger')}?utm_source=funnytools&utm_medium=owned&utm_campaign=product010_launch&utm_content=free_tool`;
const faqItems = [
  { q: 'Does this free tracker upload what I enter?', a: 'No. The observations are kept in this browser page while you use it. The fields are not sent to FunnyTools analytics.' },
  { q: 'What does the matrix show?', a: 'It counts the anonymous observations you enter by communication function, setting, partner category, and independent or prompted coding.' },
  { q: 'Does a blank cell mean the student cannot communicate there?', a: 'No. A blank cell means that no observation was entered in this small local worksheet. It is not a deficit, effectiveness judgment, or clinical conclusion.' },
];
---

<BaseLayout lang="en" title="Free AAC Generalization Matrix | FunnyTools" description="Enter anonymous AAC observations locally and view communication function by setting, partner, and independent-use summaries." keywords={['AAC generalization matrix', 'AAC communication functions tracker', 'AAC data collection', 'AAC across settings']} type="website" canonicalPath={toolPath} hasAlternates={false} ogImage={absoluteUrl('/assets/product-010/03-og.png')} ogImageAlt="Free AAC Generalization Matrix" jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Free AAC Generalization Matrix', applicationCategory: 'EducationApplication', operatingSystem: 'Any', description: 'A local browser worksheet for anonymous AAC observation summaries.' }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }]} automaticAffiliate={false}>
  <article class="aac-free-tool-page" data-tool-page="product-010-free-tool">
    <div class="wrap"><Breadcrumb items={[{ label: 'Home', href: localePath('en') }, { label: 'Tools', href: localePath('en', 'tools') }, { label: 'Free AAC Generalization Matrix' }]} /></div>
    <section class="wrap tool-hero"><div><p class="eyebrow">FREE LOCAL BROWSER TOOL</p><h1>Free AAC Generalization Matrix</h1><p class="lead">Enter a few anonymous observations and see where communication functions have been recorded across settings and partner categories.</p></div><div class="privacy-callout"><strong>No data upload.</strong><span>Use a function, setting, partner category, and independence code. Do not enter a student full name or notes that identify a person.</span></div></section>
    <section class="wrap tool-interaction" aria-labelledby="entry-title"><div class="section-heading"><p class="eyebrow">ANONYMOUS OBSERVATIONS</p><h2 id="entry-title">Build a small descriptive matrix.</h2></div><p class="form-help">This free worksheet is intentionally smaller than the full ledger. It does not create a student profile, store a name, infer spontaneity, or provide clinical interpretation.</p><form id="aac-matrix-form"><div id="observation-rows" class="observation-rows"></div><div class="actions-head"><button class="btn ghost" type="button" id="add-observation">ADD OBSERVATION</button><span class="row-limit">Up to 12 observations in this page</span></div><p id="form-error" class="form-error" role="alert" hidden></p><div class="form-actions"><button class="btn go" type="submit">BUILD MATRIX</button><button class="btn ghost" type="button" id="reset-tool">RESET</button></div></form></section>
    <section id="results" class="wrap results-section" hidden aria-labelledby="results-title"><div class="section-heading"><p class="eyebrow">LOCAL SUMMARY</p><h2 id="results-title">Recorded observations by context.</h2></div><div id="result-summary" class="result-summary"></div><div id="function-setting" class="matrix-card"></div><div id="function-partner" class="matrix-card"></div><div class="bridge-box"><strong>Need to track full AAC implementation over time?</strong><span>AAC Implementation Ledger adds sessions, prompt levels, spontaneity, partners, settings, reporting periods, generalization trends, backup, and export in a local-first buyer app.</span><div class="result-actions"><a class="btn go" data-product-event="product_010_free_to_paid_click" data-placement="free_tool_result" data-destination="product_page" href={productPath}>GET AAC IMPLEMENTATION LEDGER — $29</a><button class="btn ghost" type="button" id="print-result">PRINT MATRIX</button></div></div><p class="safety-note">This matrix describes only the anonymous observations entered on this page. It does not determine generalization, effectiveness, mastery, treatment, diagnosis, or device suitability.</p></section>
    <section class="wrap content-section tool-notes"><h2>Use the matrix as a conversation starter</h2><p>A communication function may be recorded in one setting and not yet entered in another. That difference can guide what a team chooses to observe next, but this free page does not infer why a cell is empty or whether communication is possible there. Record the setting and partner category that were actually present, then interpret the record with the professional and local procedures that apply to your work.</p><p>Independence is displayed separately from the number of observations and from whether a message was understood. A prompted turn can be successful. A missed or unobserved opportunity is not automatically a no-communication turn. Keep the labels descriptive and avoid putting identifiable student information into this worksheet.</p><p>Because this worksheet only summarizes what you enter, keep the original observation source and professional interpretation in the records and procedures your team already uses.</p><h2>What this free worksheet is for</h2><p>This page is a small, quick way to organize a few observations before a team discussion. It can help you notice which communication functions have been recorded with a particular setting or partner category. It is useful when you want a compact visual prompt for deciding what to document next, when you are explaining the difference between independent and prompted use, or when you want to try the matrix format before using a fuller implementation ledger.</p><p>The worksheet is deliberately anonymous and temporary. It does not create a learner profile, store a student code, attach a date, collect a target, or preserve a session history. If you need a longitudinal record, use the buyer app or the organization-approved system that already governs your work. Keep the source notes and context needed for responsible interpretation in that system rather than treating this page as the official record.</p><h2>A simple recording workflow</h2><p>Start with the communication function that was actually observed, such as requesting, commenting, greeting, answering, repairing a message, asking for help, or another label your team uses. Choose the setting where the observation occurred and the broad partner category that was present. Then choose independent, prompted, or unclear / not coded. Add another row for another observation, or leave the row limit unused when a smaller sample is enough for the conversation.</p><p>When the rows are complete, build the matrix and read the result as a count of entries. The same function can appear in more than one cell because each row represents a separate observation. A repeated cell means more entries were recorded there; it does not by itself establish a stable pattern. If an entry is incomplete, the worksheet excludes it from the context tables and tells you that the view has no complete observation for that combination.</p><h2>How to read the results carefully</h2><p>The function by setting table shows where the functions in your entered rows were recorded. The function by partner table shows the same idea using partner categories. The independent-use summary is calculated only from rows coded independent or prompted. Rows marked unclear / not coded remain visible as observations but are not forced into the independent denominator. This keeps missing coding separate from a negative conclusion.</p><p>A blank cell has a narrow meaning: no complete row was entered for that function and context in this page. It does not mean the person cannot communicate in that setting, that a partner was ineffective, or that generalization failed. Likewise, a populated cell does not prove mastery, effectiveness, preference, or readiness for a device or intervention. Use the display to choose a next observation and then apply professional judgment, consent, local policy, and the relevant assessment or support process.</p><h2>Privacy and boundary reminders</h2><p>Do not enter full names, birth dates, contact details, diagnoses, insurance information, or free-text notes that identify a person. The page does not upload the fields to FunnyTools analytics, but browser-local processing is not a substitute for device security, organizational retention rules, or an approved record system. Close the page when finished on a shared device and follow your organization’s rules for any separate notes or exports.</p><p>This free tool is descriptive software, not an AAC assessment, communication device, treatment planner, diagnosis, IEP compliance determination, legal opinion, or professional recommendation. It does not choose a vocabulary system, reproduce proprietary symbols, infer prompt fading, or decide what a learner should do next. The person using the tool remains responsible for the accuracy, context, privacy, and professional interpretation of any observation they enter.</p></section>
    <div class="wrap faq-wrap"><Faq lang="en" items={faqItems} emitJsonLd={false} /></div>
  </article>
  <script is:inline>
    const form = document.querySelector('#aac-matrix-form'); const rowsElement = document.querySelector('#observation-rows'); const errorElement = document.querySelector('#form-error'); const resultsElement = document.querySelector('#results'); const PRODUCT_ID = 'PRODUCT-010'; const TOOL_ID = 'aac-generalization-matrix'; const track = (name, params = {}) => window.__ft_track?.(name, params); const sendAnalyticsEvent = (name, params = {}) => track(name, params); const sendCustomToolEvent = (name, params = {}) => track(name, params); const requiredAnalyticsEvents = ['tool_view', 'tool_started', 'tool_use_started', 'tool_action', 'tool_completed', 'tool_use_completed', 'result_action', 'file_download', 'tool_error']; let toolStarted = false;
    let rows = [{ functionName: '', setting: '', partner: '', independence: 'UNCLEAR / NOT CODED' }];
    const functions = ['REQUEST', 'COMMENT', 'PROTEST / REJECT', 'GREET', 'ANSWER', 'ASK', 'SOCIAL', 'REQUEST HELP', 'REPAIR', 'SHARE INFORMATION', 'OTHER']; const settings = ['Therapy', 'Classroom', 'Lunch', 'Recess', 'Community', 'Home Report', 'Work Setting', 'Other']; const partners = ['SLP', 'Teacher', 'Paraprofessional', 'Peer', 'Family', 'Unfamiliar Adult', 'Other']; const independence = ['INDEPENDENT', 'PROMPTED', 'UNCLEAR / NOT CODED'];
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char])); const select = (label, className, values, selected) => `<label>${label}<select class="${className}"><option value="">Choose</option>${values.map((value) => `<option${value === selected ? ' selected' : ''}>${esc(value)}</option>`).join('')}</select></label>`;
    function renderRows() { rowsElement.innerHTML = rows.map((row, index) => `<div class="observation-row" data-index="${index}"><div class="row-number">${String(index + 1).padStart(2, '0')}</div><div class="row-fields">${select('Communication function', 'row-function', functions, row.functionName)}${select('Setting', 'row-setting', settings, row.setting)}${select('Partner category', 'row-partner', partners, row.partner)}${select('Independence', 'row-independence', independence, row.independence)}</div>${rows.length > 1 ? `<button class="remove-row" type="button" aria-label="Remove observation ${index + 1}">Remove</button>` : ''}</div>`).join(''); rowsElement.querySelectorAll('.remove-row').forEach((button) => button.addEventListener('click', () => { rows.splice(Number(button.closest('.observation-row').dataset.index), 1); renderRows(); })); }
    function collectRows() { return [...rowsElement.querySelectorAll('.observation-row')].map((row) => ({ functionName: row.querySelector('.row-function').value, setting: row.querySelector('.row-setting').value, partner: row.querySelector('.row-partner').value, independence: row.querySelector('.row-independence').value })); }
    function matrixHtml(title, rowKey, columnKey, data) { const rowValues = [...new Set(data.map((row) => row[rowKey]).filter(Boolean))]; const columnValues = [...new Set(data.map((row) => row[columnKey]).filter(Boolean))]; if (!rowValues.length || !columnValues.length) return `<section><h3>${title}</h3><p class="muted">No complete observations for this view.</p></section>`; return `<section><h3>${title}</h3><div class="table-wrap"><table><thead><tr><th>Function</th>${columnValues.map((value) => `<th>${esc(value)}</th>`).join('')}</tr></thead><tbody>${rowValues.map((rowValue) => `<tr><th>${esc(rowValue)}</th>${columnValues.map((columnValue) => { const cell = data.filter((row) => row[rowKey] === rowValue && row[columnKey] === columnValue); const independent = cell.filter((row) => row.independence === 'INDEPENDENT').length; return `<td>${cell.length ? `<strong>${cell.length}</strong><small>Independent: ${independent}</small>` : '<span class="muted">—</span>'}</td>`; }).join('')}</tr>`).join('')}</tbody></table></div></section>`; }
    function markToolStarted(controlType) { if (toolStarted) return; toolStarted = true; sendAnalyticsEvent('tool_started', { control_type: controlType }); sendCustomToolEvent('tool_use_started', { control_type: controlType }); }
    function showError(message) { errorElement.textContent = message; errorElement.hidden = false; sendAnalyticsEvent('tool_error', { error_type: 'validation_or_processing' }); track('product_010_free_tool_error', { product_id: PRODUCT_ID, tool_id: TOOL_ID, source_page: window.location.pathname }); return null; }
    function renderResult(data) { const complete = data.filter((row) => row.functionName && row.setting && row.partner); const coded = complete.filter((row) => row.independence === 'INDEPENDENT' || row.independence === 'PROMPTED'); const independent = coded.filter((row) => row.independence === 'INDEPENDENT').length; const functionCounts = [...new Set(complete.map((row) => row.functionName))].map((value) => ({ value, count: complete.filter((row) => row.functionName === value).length })).sort((a, b) => b.count - a.count); document.querySelector('#result-summary').innerHTML = `<div><small>Complete observations</small><strong>${complete.length}</strong></div><div><small>Settings recorded</small><strong>${new Set(complete.map((row) => row.setting)).size}</strong></div><div><small>Partners recorded</small><strong>${new Set(complete.map((row) => row.partner)).size}</strong></div><div><small>Independent use</small><strong>${coded.length ? `${Math.round(independent / coded.length * 100)}%` : '—'}</strong></div><div class="distribution"><small>Recorded communication distribution</small>${functionCounts.map((row) => `<span>${esc(row.value)} · ${row.count}</span>`).join('') || '<span>—</span>'}</div>`; document.querySelector('#function-setting').innerHTML = matrixHtml('Communication function × setting', 'functionName', 'setting', complete); document.querySelector('#function-partner').innerHTML = matrixHtml('Communication function × partner', 'functionName', 'partner', complete); resultsElement.hidden = false; resultsElement.scrollIntoView({ behavior: 'smooth', block: 'start' }); sendAnalyticsEvent('tool_completed'); sendCustomToolEvent('tool_use_completed'); track('product_010_free_tool_complete', { product_id: PRODUCT_ID, tool_id: TOOL_ID }); }
    rowsElement.addEventListener('change', () => { markToolStarted('input'); rows = collectRows(); }); document.querySelector('#add-observation').addEventListener('click', () => { markToolStarted('button'); if (rows.length >= 12) return; rows = collectRows(); rows.push({ functionName: '', setting: '', partner: '', independence: 'UNCLEAR / NOT CODED' }); renderRows(); }); form.addEventListener('submit', (event) => { event.preventDefault(); markToolStarted('submit'); sendAnalyticsEvent('tool_action', { action_name: 'build_aac_matrix' }); errorElement.hidden = true; rows = collectRows(); if (!rows.some((row) => row.functionName && row.setting && row.partner)) return showError('Add at least one complete observation with function, setting, and partner.'); renderResult(rows); }); document.querySelector('#reset-tool').addEventListener('click', () => { rows = [{ functionName: '', setting: '', partner: '', independence: 'UNCLEAR / NOT CODED' }]; renderRows(); resultsElement.hidden = true; errorElement.hidden = true; sendAnalyticsEvent('result_action', { result_action: 'reset' }); }); document.querySelector('#print-result').addEventListener('click', () => { sendAnalyticsEvent('result_action', { result_action: 'print' }); sendAnalyticsEvent('file_download', { download_action: 'print_result' }); window.print(); }); document.querySelectorAll('[data-product-event]').forEach((link) => link.addEventListener('click', () => track(link.dataset.productEvent, { product_id: PRODUCT_ID, tool_id: TOOL_ID, placement: link.dataset.placement, destination: link.dataset.destination }))); renderRows(); sendAnalyticsEvent('tool_view'); track('product_010_free_tool_view', { product_id: PRODUCT_ID, tool_id: TOOL_ID });
  </script>
</BaseLayout>

<style>
  .aac-free-tool-page{--p-ink:#102b3b;--p-teal:#1d7c83;--p-mint:#dcefe9;--p-gold:#d89724;--p-muted:#5d7380}.aac-free-tool-page .tool-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.45fr);gap:20px;align-items:end;margin:24px auto 30px}.aac-free-tool-page .tool-hero h1{font-size:clamp(2.2rem,5vw,4.4rem);letter-spacing:-.055em;line-height:.98;margin:12px 0 18px}.aac-free-tool-page .lead{max-width:760px;color:var(--p-muted);font-size:1.14rem;line-height:1.65}.aac-free-tool-page .eyebrow{color:var(--p-teal);font-size:.79rem;font-weight:850;letter-spacing:.13em}.aac-free-tool-page .privacy-callout{display:grid;gap:8px;padding:18px;border-left:5px solid var(--p-teal);border-radius:10px;background:var(--p-mint);color:var(--p-muted);line-height:1.5}.aac-free-tool-page .privacy-callout strong{color:var(--p-ink)}.aac-free-tool-page .tool-interaction,.aac-free-tool-page .results-section{padding:28px;border:1px solid var(--line);border-radius:16px;background:var(--card);box-shadow:var(--shadow-soft)}.aac-free-tool-page .section-heading h2{margin:8px 0 20px;color:var(--p-ink)}.aac-free-tool-page .observation-rows{display:grid;gap:10px}.aac-free-tool-page .observation-row{display:grid;grid-template-columns:42px minmax(0,1fr) auto;gap:12px;align-items:start;padding:14px;border:1px solid var(--line);border-radius:10px;background:#f8fbfa}.aac-free-tool-page .row-number{padding-top:10px;color:var(--p-gold);font-weight:850}.aac-free-tool-page .row-fields{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.aac-free-tool-page label{display:grid;gap:7px;color:var(--p-ink);font-weight:700;font-size:.92rem}.aac-free-tool-page select{width:100%;min-height:44px;padding:10px 12px;border:1px solid #b5c8cc;border-radius:8px;background:#fff;color:var(--p-ink);font:inherit}.aac-free-tool-page select:focus{outline:3px solid rgba(29,124,131,.22);border-color:var(--p-teal)}.aac-free-tool-page .remove-row{min-height:44px;padding:10px 12px;border:1px solid #b5c8cc;border-radius:8px;background:#fff;color:var(--p-teal);font-weight:700;cursor:pointer}.aac-free-tool-page .actions-head{display:flex;align-items:center;gap:14px;margin-top:14px}.aac-free-tool-page .row-limit{color:var(--p-muted);font-size:.86rem}.aac-free-tool-page .form-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:20px}.aac-free-tool-page .form-error{margin:16px 0 0;color:#a33a29;font-weight:700}.aac-free-tool-page .results-section{margin-top:24px}.aac-free-tool-page .result-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:22px}.aac-free-tool-page .result-summary>div{display:grid;gap:6px;padding:16px;border:1px solid #cde3dc;border-radius:10px;background:#f4fbf8}.aac-free-tool-page .result-summary small{color:var(--p-muted)}.aac-free-tool-page .result-summary strong{color:var(--p-ink);font-size:1.05rem}.aac-free-tool-page .result-summary .distribution{grid-column:1/-1}.aac-free-tool-page .distribution span{display:inline-block;margin:8px 14px 0 0;color:var(--p-ink);font-size:.9rem}.aac-free-tool-page .matrix-card{margin-top:18px}.aac-free-tool-page .matrix-card section{padding-top:8px}.aac-free-tool-page .matrix-card h3{color:var(--p-ink)}.aac-free-tool-page .table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px}.aac-free-tool-page table{width:100%;min-width:600px;border-collapse:collapse}.aac-free-tool-page th,.aac-free-tool-page td{padding:10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}.aac-free-tool-page th{background:#f7faf9;color:var(--p-ink);font-size:.78rem;text-transform:uppercase}.aac-free-tool-page td{text-align:center}.aac-free-tool-page td small{display:block;color:var(--p-muted);margin-top:3px}.aac-free-tool-page .bridge-box{display:grid;gap:7px;margin-top:24px;padding:20px;border-radius:12px;background:linear-gradient(135deg,var(--p-mint),#fff);color:var(--p-muted);line-height:1.5}.aac-free-tool-page .bridge-box strong{color:var(--p-ink);font-size:1.1rem}.aac-free-tool-page .bridge-box .btn{width:max-content;margin-top:8px}.aac-free-tool-page .safety-note{margin-top:18px;padding:12px;border-left:4px solid var(--p-gold);color:var(--p-muted);line-height:1.55}.aac-free-tool-page .tool-notes{color:var(--p-muted);line-height:1.6}.aac-free-tool-page .tool-notes h2{color:var(--p-ink)}
  @media(max-width:900px){.aac-free-tool-page .tool-hero{grid-template-columns:1fr}.aac-free-tool-page .row-fields{grid-template-columns:repeat(2,1fr)}.aac-free-tool-page .result-summary{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.aac-free-tool-page .form-grid,.aac-free-tool-page .result-summary{grid-template-columns:1fr}.aac-free-tool-page .tool-interaction,.aac-free-tool-page .results-section{padding:18px}.aac-free-tool-page .observation-row{grid-template-columns:30px minmax(0,1fr)}.aac-free-tool-page .row-fields{grid-template-columns:1fr}.aac-free-tool-page .remove-row{grid-column:2;width:max-content}.aac-free-tool-page .form-actions .btn,.aac-free-tool-page .bridge-box .btn{width:100%;text-align:center}}
</style>
