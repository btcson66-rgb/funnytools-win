---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Faq from '../../../components/Faq.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { absoluteUrl, localePath } from '../../../lib/url';

const toolPath = '/en/tools/postsecondary-transition-action-planner/';
const productPath = `${localePath('en', 'transition-pathway-ledger')}?utm_source=funnytools&utm_medium=owned&utm_campaign=product009_launch&utm_content=free_tool`;
const faqItems = [
  { q: 'Does this planner upload what I type?', a: 'No. The action plan is rendered in your browser. The fields you enter are not sent to FunnyTools analytics.' },
  { q: 'What does this free planner produce?', a: 'It produces a simple user-entered plan with a desired outcome, pathway domain, target date, and action rows with owner, timing, and status.' },
  { q: 'Does it determine transition services or compliance?', a: 'No. It is a planning aid. It does not determine eligibility, compliance, service requirements, readiness, placement, or professional recommendations.' },
];
---

<BaseLayout lang="en" title="Free Postsecondary Transition Action Planner | FunnyTools" description="Build a simple local transition action plan with a desired outcome, pathway domain, target date, owners, and next steps." keywords={['postsecondary transition action plan', 'transition planning worksheet', 'free transition planner', 'special education transition next steps']} type="website" canonicalPath={toolPath} hasAlternates={false} ogImage={absoluteUrl('/og/en-study.png')} ogImageAlt="Free Postsecondary Transition Action Planner" jsonLd={[{ '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Free Postsecondary Transition Action Planner', applicationCategory: 'EducationApplication', operatingSystem: 'Any', description: 'A local browser tool for organizing user-entered transition next steps.' }, { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }]} automaticAffiliate={false}>
  <article class="transition-tool-page" data-tool-page="product-009-free-tool">
    <div class="wrap"><Breadcrumb items={[{ label: 'Home', href: localePath('en') }, { label: 'Tools', href: localePath('en', 'tools') }, { label: 'Free Postsecondary Transition Action Planner' }]} /></div>
    <section class="wrap tool-hero"><div><p class="eyebrow">FREE LOCAL BROWSER TOOL</p><h1>Free Postsecondary Transition Action Planner</h1><p class="lead">Turn one desired outcome into a small, reviewable list of user-defined next steps. Enter only what you are comfortable keeping in this browser session.</p></div><div class="privacy-callout"><strong>No data upload.</strong><span>Use a student code or initials only. This page renders your plan locally and does not send the entered fields to analytics.</span></div></section>
    <section class="wrap tool-interaction" aria-labelledby="entry-title"><div class="section-heading"><p class="eyebrow">ACTION PLAN BUILDER</p><h2 id="entry-title">Define the next step your team wants to revisit.</h2></div><form id="transition-form"><div class="form-grid"><label>Student code (optional)<input id="student-code" type="text" maxlength="40" placeholder="S-01" /></label><label>Desired outcome<input id="desired-outcome" type="text" maxlength="180" placeholder="Explore a campus-based training program" required /></label><label>Pathway domain<select id="domain"><option>Education / Training</option><option>Employment</option><option>Independent Living</option><option>Community Participation</option><option>Self-Determination</option></select></label><label>Target review date<input id="target-date" type="date" /></label></div><div class="actions-head"><h3>Next-step rows <span>Add up to five actions.</span></h3><button class="btn ghost" type="button" id="add-action">ADD ACTION</button></div><div id="action-rows" class="action-rows"></div><p id="form-error" class="form-error" role="alert" hidden></p><div class="form-actions"><button class="btn go" type="submit">BUILD ACTION PLAN</button><button class="btn ghost" type="button" id="reset-tool">RESET</button></div></form></section>
    <section id="results" class="wrap results-section" hidden aria-labelledby="results-title"><div class="section-heading"><p class="eyebrow">LOCAL ACTION PLAN</p><h2 id="results-title">A clear list to bring to the next review.</h2></div><div id="result-summary" class="result-summary"></div><div id="result-actions" class="result-actions"></div><div class="bridge-box"><strong>Need the full pathway record?</strong><span>Transition Pathway Ledger adds student voice, family and team perspectives, evidence and perspective matrices, work and community experiences, outcomes, agency contacts, meetings, timeline review, JSON backup, CSV export, and printable reports in one local-first buyer app.</span><a class="btn go" data-product-event="product_009_free_to_paid_click" data-placement="free_tool_result" data-destination="product_page" href={productPath}>GET TRANSITION PATHWAY LEDGER — $29</a><button class="btn ghost" type="button" id="print-plan">PRINT ACTION PLAN</button></div><p class="safety-note">This tool organizes the fields you enter. It does not determine eligibility, compliance, services, readiness, placement, or a professional recommendation.</p></section>
    <section class="wrap content-section tool-notes"><h2>Use a small plan to prepare a better conversation</h2><p>A transition action plan is often most useful when it is concrete enough to revisit. Start with one outcome or question rather than trying to summarize every possibility at once. A short phrase such as “compare two training options” or “practice a community travel route” gives the team something observable to discuss while leaving the decision with the people involved.</p><p>The planner keeps the outcome separate from the action rows because they answer different questions. The outcome describes what the student or team wants to explore. An action row describes a next move, who will take it, when it should be revisited, and whether it is still open. Separating those fields helps a meeting distinguish an unfinished action from a change in the desired direction.</p><h3>Keep the source of the plan visible</h3><p>This free page is intentionally limited. It does not collect a complete student profile, assessment record, family perspective, experience history, agency contact list, or official plan. If you use it for a meeting, bring the source notes and local procedures that your team is expected to follow. Use a student code or initials unless identifiable information is specifically authorized, and clear the browser when you are finished on a shared device.</p><p>The full Transition Pathway Ledger is designed for teams that need those connected records in one local-first workspace. It lets users attribute entries to a student, family, teacher, related service, employer or job coach, or another source. It also supports evidence status, perspective differences, outcome notes, work and community experiences, agency contacts, meetings, a descriptive timeline, JSON backup, CSV export, and printable reports. Those features organize what a user enters; they do not turn the app into a legal, compliance, assessment, diagnostic, eligibility, or placement system.</p><h3>Read the plan as a queue, not a verdict</h3><p>An open action is not proof that a student is unprepared, and a completed action is not proof that a pathway is appropriate. Use the rows to ask what was tried, what the student said, what support or context was present, and what information is still missing. A different perspective should remain a topic for conversation rather than being silently converted into a score. This approach keeps the tool useful while preserving professional judgment and the student's voice.</p><p>When a date is entered, it is a user-defined review date for this local plan. It is not a legal deadline or a district requirement. When an owner is entered, it is the person or group the user chose for follow-up. Review the wording, privacy, and retention of any exported or printed copy according to the rules that apply to your setting.</p></section>
    <div class="wrap faq-wrap"><Faq lang="en" items={faqItems} emitJsonLd={false} /></div>
    <section class="wrap content-section tool-notes"><h2>Make the next action easy to revisit</h2><p>A good action row says what will be done in language the team can recognize later. It can be a call, a comparison, a practice opportunity, a question for a meeting, or a request for information. Keep it small enough to review without turning the free planner into a complete record. The full ledger is available when you need source-attributed evidence, perspectives, experiences, contacts, meetings, and a longer timeline in one local workspace.</p></section>
  </article>
  <script is:inline>
    const form = document.querySelector('#transition-form'); const rowsElement = document.querySelector('#action-rows'); const errorElement = document.querySelector('#form-error'); const resultsElement = document.querySelector('#results'); const track = (name, params = {}) => window.__ft_track?.(name, params); const PRODUCT_ID = 'PRODUCT-009'; const TOOL_ID = 'postsecondary-transition-action-planner'; let toolStarted = false; let actions = [{ title: '', owner: '', reviewDate: '', status: 'Not started' }];
    const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
    const field = (label, className, value, type = 'text', placeholder = '') => `<label>${label}<input class="${className}" type="${type}" value="${escapeHtml(value)}" maxlength="180" placeholder="${placeholder}" /></label>`;
    function renderRows() { rowsElement.innerHTML = actions.map((row, index) => `<div class="action-row" data-index="${index}"><div class="row-number">${String(index + 1).padStart(2, '0')}</div><div class="row-fields">${field('Action', 'row-title', row.title, 'text', 'Call the training program')}${field('Owner', 'row-owner', row.owner, 'text', 'Team member')}${field('Review date', 'row-date', row.reviewDate, 'date')}<label>Status<select class="row-status"><option${row.status === 'Not started' ? ' selected' : ''}>Not started</option><option${row.status === 'In progress' ? ' selected' : ''}>In progress</option><option${row.status === 'Waiting' ? ' selected' : ''}>Waiting</option><option${row.status === 'Complete' ? ' selected' : ''}>Complete</option></select></label></div>${actions.length > 1 ? `<button class="remove-row" type="button" aria-label="Remove action ${index + 1}">Remove</button>` : ''}</div>`).join(''); rowsElement.querySelectorAll('.remove-row').forEach((button) => button.addEventListener('click', () => { actions.splice(Number(button.closest('.action-row').dataset.index), 1); renderRows(); })); }
    function collectRows() { return [...rowsElement.querySelectorAll('.action-row')].map((row) => ({ title: row.querySelector('.row-title').value.trim(), owner: row.querySelector('.row-owner').value.trim(), reviewDate: row.querySelector('.row-date').value, status: row.querySelector('.row-status').value })); }
    function markStarted(controlType) { if (toolStarted) return; toolStarted = true; track('tool_started', { product_id: PRODUCT_ID, tool_id: TOOL_ID, control_type: controlType }); }
    function showError(message) { errorElement.textContent = message; errorElement.hidden = false; track('tool_error', { product_id: PRODUCT_ID, tool_id: TOOL_ID, error_type: 'validation_or_processing' }); }
    function renderResult(rows) { const outcome = document.querySelector('#desired-outcome').value.trim(); const code = document.querySelector('#student-code').value.trim() || 'Not specified'; const domain = document.querySelector('#domain').value; const target = document.querySelector('#target-date').value || 'Not specified'; document.querySelector('#result-summary').innerHTML = `<div><small>Student code</small><strong>${escapeHtml(code)}</strong></div><div><small>Pathway domain</small><strong>${escapeHtml(domain)}</strong></div><div><small>Desired outcome</small><strong>${escapeHtml(outcome)}</strong></div><div><small>Review date</small><strong>${escapeHtml(target)}</strong></div>`; document.querySelector('#result-actions').innerHTML = `<h3>Actions to revisit</h3><ol>${rows.map((row) => `<li><strong>${escapeHtml(row.title)}</strong><span>Owner: ${escapeHtml(row.owner || 'Not specified')} · Review: ${escapeHtml(row.reviewDate || 'Not specified')} · Status: ${escapeHtml(row.status)}</span></li>`).join('')}</ol>`; resultsElement.hidden = false; resultsElement.scrollIntoView({ behavior: 'smooth', block: 'start' }); track('product_009_free_tool_complete', { product_id: PRODUCT_ID, tool_id: TOOL_ID, action_count: rows.length }); }
    rowsElement.addEventListener('input', () => { markStarted('input'); actions = collectRows(); }); document.querySelector('#add-action').addEventListener('click', () => { markStarted('button'); if (actions.length >= 5) return; actions = collectRows(); actions.push({ title: '', owner: '', reviewDate: '', status: 'Not started' }); renderRows(); }); form.addEventListener('submit', (event) => { event.preventDefault(); markStarted('submit'); errorElement.hidden = true; actions = collectRows(); const outcome = document.querySelector('#desired-outcome').value.trim(); if (!outcome) return showError('Enter a desired outcome.'); if (!actions.length || actions.some((row) => !row.title)) return showError('Add a short title for each action.'); renderResult(actions); }); document.querySelector('#reset-tool').addEventListener('click', () => { actions = [{ title: '', owner: '', reviewDate: '', status: 'Not started' }]; form.reset(); renderRows(); resultsElement.hidden = true; errorElement.hidden = true; }); document.querySelector('#print-plan').addEventListener('click', () => { track('result_action', { product_id: PRODUCT_ID, tool_id: TOOL_ID, action_name: 'print' }); window.print(); }); document.querySelectorAll('[data-product-event]').forEach((link) => link.addEventListener('click', () => track(link.dataset.productEvent, { product_id: PRODUCT_ID, tool_id: TOOL_ID, placement: link.dataset.placement, destination: link.dataset.destination }))); renderRows(); track('product_009_free_tool_view', { product_id: PRODUCT_ID, tool_id: TOOL_ID });
    const sendAnalyticsEvent = (name, params = {}) => track(name, { product_id: PRODUCT_ID, tool_id: TOOL_ID, ...params });
    const requiredAnalyticsEvents = ['tool_view', 'tool_started', 'tool_use_started', 'tool_action', 'tool_completed', 'tool_use_completed', 'result_action', 'file_download', 'tool_error'];
    sendAnalyticsEvent('tool_view');
    rowsElement.addEventListener('focusin', () => sendAnalyticsEvent('tool_use_started', { control_type: 'field' }), { once: true });
    form.addEventListener('submit', () => { sendAnalyticsEvent('tool_action', { action_name: 'build_transition_action_plan' }); window.setTimeout(() => { if (!resultsElement.hidden) { sendAnalyticsEvent('tool_completed'); sendAnalyticsEvent('tool_use_completed'); } }, 0); });
    document.querySelector('#print-plan').addEventListener('click', () => { sendAnalyticsEvent('result_action', { result_action: 'print' }); sendAnalyticsEvent('file_download', { download_action: 'print_action_plan' }); });
  </script>
</BaseLayout>

<style>
  .transition-tool-page{--p-ink:#102b3b;--p-teal:#1d7c83;--p-mint:#dcefe9;--p-gold:#d89724;--p-muted:#5d7380}.transition-tool-page .tool-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,.45fr);gap:20px;align-items:end;margin:24px auto 30px}.transition-tool-page .tool-hero h1{font-size:clamp(2.2rem,5vw,4.4rem);letter-spacing:-.055em;line-height:.98;margin:12px 0 18px}.transition-tool-page .lead{max-width:760px;color:var(--p-muted);font-size:1.14rem;line-height:1.65}.transition-tool-page .eyebrow{color:var(--p-teal);font-size:.79rem;font-weight:850;letter-spacing:.13em}.transition-tool-page .privacy-callout{display:grid;gap:8px;padding:18px;border-left:5px solid var(--p-teal);border-radius:10px;background:var(--p-mint);color:var(--p-muted);line-height:1.5}.transition-tool-page .privacy-callout strong{color:var(--p-ink)}.transition-tool-page .tool-interaction,.transition-tool-page .results-section{padding:28px;border:1px solid var(--line);border-radius:16px;background:var(--card);box-shadow:var(--shadow-soft)}.transition-tool-page .section-heading h2{margin:8px 0 20px;color:var(--p-ink)}.transition-tool-page .form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.transition-tool-page label{display:grid;gap:7px;color:var(--p-ink);font-weight:700;font-size:.92rem}.transition-tool-page input,.transition-tool-page select{width:100%;min-height:44px;padding:10px 12px;border:1px solid #b5c8cc;border-radius:8px;background:#fff;color:var(--p-ink);font:inherit}.transition-tool-page input:focus,.transition-tool-page select:focus{outline:3px solid rgba(29,124,131,.22);border-color:var(--p-teal)}.transition-tool-page .actions-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:26px}.transition-tool-page .actions-head h3{margin:0;color:var(--p-ink)}.transition-tool-page .actions-head h3 span{color:var(--p-muted);font-size:.9rem;font-weight:500}.transition-tool-page .action-rows{display:grid;gap:10px;margin-top:12px}.transition-tool-page .action-row{display:grid;grid-template-columns:42px minmax(0,1fr) auto;gap:12px;align-items:start;padding:14px;border:1px solid var(--line);border-radius:10px;background:#f8fbfa}.transition-tool-page .row-number{padding-top:10px;color:var(--p-gold);font-weight:850}.transition-tool-page .row-fields{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:10px}.transition-tool-page .remove-row{min-height:44px;padding:10px 12px;border:1px solid #b5c8cc;border-radius:8px;background:#fff;color:var(--p-teal);font-weight:700;cursor:pointer}.transition-tool-page .form-actions,.transition-tool-page .result-actions{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:20px}.transition-tool-page .form-error{margin:16px 0 0;color:#a33a29;font-weight:700}.transition-tool-page .results-section{margin-top:24px}.transition-tool-page .result-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.transition-tool-page .result-summary>div{display:grid;gap:6px;padding:16px;border:1px solid #cde3dc;border-radius:10px;background:#f4fbf8}.transition-tool-page .result-summary small{color:var(--p-muted)}.transition-tool-page .result-summary strong{color:var(--p-ink);font-size:1.05rem;overflow-wrap:anywhere}.transition-tool-page .result-actions{display:block}.transition-tool-page .result-actions h3{color:var(--p-ink)}.transition-tool-page .result-actions ol{display:grid;gap:9px;padding-left:1.35rem;color:var(--p-ink)}.transition-tool-page .result-actions li{padding:12px;border-bottom:1px solid #e2eaec}.transition-tool-page .result-actions li span{display:block;color:var(--p-muted);font-size:.9rem;margin-top:4px}.transition-tool-page .bridge-box{display:grid;gap:7px;margin-top:20px;padding:20px;border-radius:12px;background:linear-gradient(135deg,var(--p-mint),#fff);color:var(--p-muted);line-height:1.5}.transition-tool-page .bridge-box strong{color:var(--p-ink);font-size:1.1rem}.transition-tool-page .bridge-box .btn{width:max-content;margin-top:8px}.transition-tool-page .safety-note{margin-top:18px;padding:12px;border-left:4px solid var(--p-gold);color:var(--p-muted);line-height:1.55}.transition-tool-page .tool-notes{color:var(--p-muted);line-height:1.6}.transition-tool-page .tool-notes h2{color:var(--p-ink)}.transition-tool-page .tool-notes a{color:var(--p-teal);font-weight:750}
  @media(max-width:900px){.transition-tool-page .tool-hero,.transition-tool-page .row-fields{grid-template-columns:1fr 1fr}.transition-tool-page .row-fields label:first-child{grid-column:1/-1}.transition-tool-page .result-summary{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:600px){.transition-tool-page .tool-hero,.transition-tool-page .form-grid,.transition-tool-page .result-summary{grid-template-columns:1fr}.transition-tool-page .tool-interaction,.transition-tool-page .results-section{padding:18px}.transition-tool-page .action-row{grid-template-columns:30px minmax(0,1fr)}.transition-tool-page .row-fields{grid-template-columns:1fr}.transition-tool-page .remove-row{grid-column:2;width:max-content}.transition-tool-page .form-actions .btn,.transition-tool-page .bridge-box .btn{width:100%;text-align:center}}
  @media print{.transition-tool-page>*:not(#results),.transition-tool-page #results .bridge-box,.transition-tool-page #results .safety-note{display:none!important}.transition-tool-page #results{display:block!important;box-shadow:none;border:0}}
</style>
