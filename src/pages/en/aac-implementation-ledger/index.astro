---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Faq from '../../../components/Faq.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { assetPath, absoluteUrl, localePath } from '../../../lib/url';

const productPath = '/en/aac-implementation-ledger/';
const freeToolPath = `${localePath('en', 'tools', 'aac-generalization-matrix')}?utm_source=funnytools&utm_medium=owned&utm_campaign=product010_launch&utm_content=product_bridge`;
const PAYHIP_URL = import.meta.env.PUBLIC_PRODUCT_010_PAYHIP_URL || 'https://payhip.com/b/0iqnT';
const GUMROAD_URL = import.meta.env.PUBLIC_PRODUCT_010_GUMROAD_URL || '';
const marketplacePending = !PAYHIP_URL;
const marketplaceUrl = (base: string, placement: string) => base ? `${base}${base.includes('?') ? '&' : '?'}utm_source=funnytools&utm_medium=owned&utm_campaign=product010_launch&utm_content=${placement}` : '#marketplace-pending';
const productAssetPath = (name: string) => assetPath('assets', 'product-010', name);
const imageNames = ['01-payhip-hero.png', '04-communication-functions.png', '05-independence-prompting.png', '06-generalization-matrix.png', '07-partners-settings.png', '08-prompt-profile.png', '09-reporting-period.png', '10-local-first.png'];
const imageUrls = imageNames.map((name) => absoluteUrl(productAssetPath(name)));
const faqItems = [
  { q: 'What does AAC Implementation Ledger track?', a: 'It organizes user-entered communication functions, independence, prompt levels, communication modes, partners, settings, spontaneity, sessions, opportunities, generalization views, reporting periods, JSON backup, and CSV export.' },
  { q: 'Is successful communication the same as independent communication?', a: 'No. The buyer app stores successful-message status separately from independence. A message may be understood while the turn is still prompted.' },
  { q: 'Does it recommend an AAC device or treatment?', a: 'No. It does not select AAC systems, reproduce proprietary vocabulary layouts, conduct assessments, diagnose, make IEP decisions, or provide treatment recommendations.' },
  { q: 'Does the buyer app require an account or subscription?', a: 'No. The core app is a local-first static app with IndexedDB storage, JSON backup, CSV export, and browser print/PDF. It has no required login, subscription, cloud database, or buyer-app analytics.' },
  { q: 'Can I use real student names?', a: 'Use student codes or initials unless your school, district, or organization authorizes identifiable information. You remain responsible for local privacy, retention, access, and device-security rules.' },
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Product', name: 'AAC Implementation Ledger', description: 'A local-first descriptive communication tracking workspace for AAC implementation data.', image: imageUrls, brand: { '@type': 'Brand', name: 'FunnyTools' }, ...(PAYHIP_URL ? { offers: { '@type': 'Offer', price: '29', priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: PAYHIP_URL } } : {}) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
];
---

<BaseLayout lang="en" title="AAC Implementation Ledger | AAC Data Tracker" description="Track AAC communication functions, independence, prompts, partners, settings, spontaneity, and generalization in a local-first implementation ledger." keywords={['AAC data collection tool', 'AAC progress tracking', 'AAC implementation tracker', 'AAC prompting tracker', 'AAC generalization data', 'AAC communication functions', 'AAC independence tracker']} type="website" canonicalPath={productPath} hasAlternates={false} jsonLd={jsonLd} ogImage={absoluteUrl(productAssetPath('03-og.png'))} ogImageAlt="AAC Implementation Ledger — Track communication, not just accuracy." automaticAffiliate={false}>
  <article class="product-010-page product-page" data-product-page="product-010">
    <section class="product-hero wrap" aria-labelledby="product-title"><Breadcrumb items={[{ label: 'Home', href: localePath('en') }, { label: 'AAC Implementation Ledger' }]} /><div class="hero-grid"><div class="hero-copy"><p class="eyebrow">ONE-TIME PURCHASE · LOCAL-FIRST · US$29 LAUNCH PRICE</p><h1 id="product-title">AAC Implementation Ledger</h1><p class="hero-message">Track communication,<br />not just accuracy.</p><p class="lead">A calm local workspace for organizing communication functions, independence, prompts, partners, settings, spontaneity, sessions, and generalization without another subscription.</p><div class="cta-row"><a class:list={['btn', 'go', { 'is-pending': marketplacePending }]} data-product-event="product_010_marketplace_click" data-destination="payhip" data-placement="hero" data-marketplace-pending={marketplacePending ? 'true' : undefined} href={marketplaceUrl(PAYHIP_URL, 'hero')} aria-disabled={marketplacePending ? 'true' : undefined}>{marketplacePending ? 'PAYHIP CHECKOUT PENDING' : 'GET AAC IMPLEMENTATION LEDGER — $29'}</a><a class="btn ghost" data-product-event="product_010_cta_click" data-destination="free_tool" data-placement="hero" href={freeToolPath}>TRY THE FREE AAC GENERALIZATION TRACKER</a></div>{GUMROAD_URL && <p class="secondary-marketplace"><a data-product-event="product_010_marketplace_click" data-destination="gumroad" data-placement="hero" href={marketplaceUrl(GUMROAD_URL, 'hero')}>Prefer Gumroad? View the secondary listing.</a></p>}<p class="privacy-line">No subscription. No account required. No cloud database required for the core buyer app. Use student codes or initials unless authorized otherwise.</p></div><div class="hero-art"><img src={productAssetPath('01-payhip-hero.png')} alt="Real AAC Implementation Ledger RC1 dashboard with fictional demo records" width="1600" height="1000" loading="eager" decoding="async" /></div></div></section>
    <section class="wrap proof-strip" aria-label="Product promise"><div><strong>Communication functions</strong><span>Record requesting, commenting, repair, social interaction, and user-defined functions.</span></div><div><strong>Independence vs prompting</strong><span>Keep independent, prompted, and uncoded turns separate from message success.</span></div><div><strong>Generalization matrix</strong><span>See recorded functions by setting and partner category.</span></div><div><strong>Local-first</strong><span>Your records stay on your device unless you export them.</span></div></section>
    <section class="wrap content-section problem-section" aria-labelledby="problem-title"><div class="section-head narrow"><p class="eyebrow">THE IMPLEMENTATION PICTURE</p><h2 id="problem-title">Communication progress is more than correct or incorrect.</h2><p>AAC implementation records may need to preserve the communication function, who was present, where the turn happened, how much prompting was used, whether the message was understood, and whether the turn was spontaneous or elicited. The Ledger keeps those dimensions visible without turning organization into a clinical conclusion.</p></div><div class="problem-grid"><div class="problem-card"><span>01</span><h3>Record</h3><p>Move from student code and target to a fast communication turn while the context is still available.</p></div><div class="problem-card"><span>02</span><h3>Separate</h3><p>Store independence, prompt level, successful message, and spontaneity as distinct fields.</p></div><div class="problem-card"><span>03</span><h3>Review</h3><p>Use descriptive function balance, prompt profile, reporting periods, and matrices across settings and partners.</p></div></div></section>
    <section class="wrap content-section feature-section" aria-labelledby="functions-title"><div class="feature-copy"><p class="eyebrow">COMMUNICATION FUNCTIONS</p><h2 id="functions-title">Track more than requesting.</h2><p>Create user-defined targets and editable function labels for requesting, commenting, protesting, greeting, answering, asking, social interaction, repair, sharing information, help, or other communication. The tool does not prescribe which functions every learner must use.</p></div><img src={productAssetPath('04-communication-functions.png')} alt="Real AAC Implementation Ledger communication functions screen with fictional demo records" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section feature-section reverse" aria-labelledby="independence-title"><div class="feature-copy"><p class="eyebrow">INDEPENDENCE VS PROMPTING</p><h2 id="independence-title">A successful message can still be prompted.</h2><p>Store independent, prompted, and uncoded turns separately from whether the message was understood. Prompt labels remain editable demonstration categories; the app does not present a universal hierarchy or infer prompt fading.</p></div><img src={productAssetPath('05-independence-prompting.png')} alt="Real AAC Implementation Ledger turn log showing independence and prompt distinctions" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section feature-section" aria-labelledby="matrix-title"><div class="feature-copy"><p class="eyebrow">GENERALIZATION MATRIX</p><h2 id="matrix-title">See where a function has been recorded.</h2><p>Review communication function × setting, function × partner, and independence × setting. Cells show recorded counts and independent counts. A blank cell means not recorded in the selected period; it is not a deficit or automatic generalization judgment.</p></div><img src={productAssetPath('06-generalization-matrix.png')} alt="Real AAC Implementation Ledger generalization matrix with fictional records" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section feature-section reverse" aria-labelledby="context-title"><div class="feature-copy"><p class="eyebrow">PARTNERS AND SETTINGS</p><h2 id="context-title">Keep the context with the turn.</h2><p>Use generic partner categories and editable settings such as therapy, classroom, lunch, recess, community, home report, or work setting. No real partner name is required.</p></div><img src={productAssetPath('07-partners-settings.png')} alt="Real AAC Implementation Ledger partners and settings view with fictional demo records" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section feature-section" aria-labelledby="reporting-title"><div class="feature-copy"><p class="eyebrow">PROMPT PROFILE AND REPORTING PERIOD</p><h2 id="reporting-title">Prepare a descriptive snapshot.</h2><p>Filter by a user-defined reporting period, review function distribution, prompt levels, independence, spontaneity, partners, settings, and a deterministic summary. Print or export the records you choose; no automatic IEP progress decision is generated.</p></div><img src={productAssetPath('09-reporting-period.png')} alt="Real AAC Implementation Ledger reporting period screen with fictional demo records" width="1600" height="1000" loading="lazy" decoding="async" /></section>
    <section class="wrap content-section gallery-section" aria-labelledby="screenshots-title"><div class="section-head"><p class="eyebrow">REAL RC1 SCREENS</p><h2 id="screenshots-title">The buyer app is the product.</h2><p>These are deterministic commercial assets generated from the frozen RC1 UI using fictional S-01, S-02, and S-03 demo records.</p></div><div class="gallery-grid">{imageNames.slice(5).map((name, index) => <figure><img src={productAssetPath(name)} alt={`AAC Implementation Ledger feature: ${name.replace(/\.png$/, '').replace(/^\d+-/, '').replaceAll('-', ' ')}`} width="1600" height="1000" loading="lazy" decoding="async" /><figcaption>{['Prompt profile', 'Reporting period', 'Local-first backup'][index]}</figcaption></figure>)}</div></section>
    <section class="wrap content-section audience-grid" aria-labelledby="audience-title"><div><p class="eyebrow">WHO IT'S FOR</p><h2 id="audience-title">Built for teams supporting AAC users.</h2><ul class="check-list"><li>School SLPs and SLPAs</li><li>Special-education teachers and classroom teams</li><li>AAC specialists and related-service professionals</li><li>Teams reviewing communication across settings and partners</li><li>Professionals who need local, descriptive records between sessions</li></ul></div><div class="not-for"><p class="eyebrow">KEEP THE BOUNDARY CLEAR</p><h2>Implementation data, not device selection.</h2><p>The Ledger is not an AAC communication device, symbol app, AAC assessment, diagnostic tool, device-selection tool, IEP writer, or automated therapy recommendation system.</p><p>It does not reproduce proprietary symbols, layouts, or vocabulary systems and does not claim affiliation with an AAC vendor.</p></div></section>
    <section class="wrap content-section how-section" aria-labelledby="how-title"><div class="section-head narrow"><p class="eyebrow">HOW IT WORKS</p><h2 id="how-title">A short path from turn to review.</h2></div><ol class="steps"><li><strong>Start empty or load demo data.</strong><span>Fictional S-01, S-02, and S-03 records are clearly labelled and can be cleared before your own work.</span></li><li><strong>Select a student and target.</strong><span>Use a fast mobile-first tally form with editable categories.</span></li><li><strong>Log communication turns.</strong><span>Record independence, prompt, mode, partner, setting, spontaneity, and optional latency.</span></li><li><strong>Review and export.</strong><span>Use matrices, reports, JSON backup, CSV export, and browser print/PDF.</span></li></ol></section>
    <section class="wrap content-section bridge-section" aria-labelledby="bridge-title"><div><p class="eyebrow">FREE AAC GENERALIZATION TRACKER</p><h2 id="bridge-title">Try the matrix before you buy.</h2><p>Enter anonymous observations in the free browser tool and see function × setting, function × partner, and independent-use summaries. No student full name, upload, or clinical interpretation.</p></div><a class="btn ghost" data-product-event="product_010_free_to_paid_click" data-destination="free_tool" data-placement="product_bridge" href={freeToolPath}>TRY THE FREE AAC GENERALIZATION TRACKER</a></section>
    <section class="wrap content-section privacy-section" aria-labelledby="privacy-title"><p class="eyebrow">LOCAL-FIRST PRIVACY</p><h2 id="privacy-title">Your records. Your device.</h2><p>The buyer app uses browser IndexedDB, works offline, and includes validated JSON backup/restore, CSV export with formula safety, printable reports, editable categories, and a clear-data control. It has no buyer-app analytics, account requirement, subscription, AI API, runtime CDN, or cloud database.</p><div class="privacy-badges"><span>NO SUBSCRIPTION</span><span>NO ACCOUNT</span><span>OFFLINE CORE</span><span>JSON + CSV EXPORT</span></div></section>
    <div class="wrap"><Faq lang="en" items={faqItems} emitJsonLd={false} /></div>
    <section class="wrap content-section disclaimer-section" aria-labelledby="disclaimer-title"><p class="eyebrow">DISCLAIMER</p><h2 id="disclaimer-title">Keep professional judgment with the professionals.</h2><p>AAC Implementation Ledger is an organizational and observational data tool. It does not select AAC systems, conduct AAC assessments, provide speech-language diagnoses, replace professional evaluation, make IEP decisions, or provide legal or medical advice.</p></section>
    <section id="marketplace-pending" class="wrap final-cta" aria-labelledby="final-cta-title"><p class="eyebrow">TRACK COMMUNICATION, NOT JUST ACCURACY.</p><h2 id="final-cta-title">Keep implementation visible without another subscription.</h2><div class="cta-row"><a class:list={['btn', 'go', { 'is-pending': marketplacePending }]} data-product-event="product_010_marketplace_click" data-destination="payhip" data-placement="final_cta" data-marketplace-pending={marketplacePending ? 'true' : undefined} href={marketplaceUrl(PAYHIP_URL, 'final_cta')} aria-disabled={marketplacePending ? 'true' : undefined}>{marketplacePending ? 'PAYHIP CHECKOUT PENDING' : 'GET AAC IMPLEMENTATION LEDGER — $29'}</a>{GUMROAD_URL && <a class="btn ghost" data-product-event="product_010_marketplace_click" data-destination="gumroad" data-placement="final_cta" href={marketplaceUrl(GUMROAD_URL, 'final_cta')}>VIEW ON GUMROAD</a>}<a class="btn ghost" data-product-event="product_010_free_to_paid_click" data-destination="free_tool" data-placement="final_cta" href={freeToolPath}>TRY THE FREE TRACKER</a></div><p>One-time purchase · US$29 launch price · US$49 regular price</p></section>
  </article>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => { window.__ft_track?.('product_010_view', { product_id: 'PRODUCT-010', placement: 'product_page' }); document.querySelectorAll('[data-product-event]').forEach((link) => link.addEventListener('click', (event) => { if (link.dataset.marketplacePending === 'true') { event.preventDefault(); document.querySelector('#marketplace-pending')?.scrollIntoView({ behavior: 'smooth' }); return; } window.__ft_track?.(link.dataset.productEvent, { product_id: 'PRODUCT-010', placement: link.dataset.placement, destination: link.dataset.destination }); })); });
  </script>
</BaseLayout>

<style>
  .product-010-page { --p-ink:#102b3b; --p-teal:#1d7c83; --p-mint:#dcefe9; --p-gold:#d89724; --p-muted:#5d7380; }
  .product-010-page .hero-copy,.product-010-page .hero-art,.product-010-page .feature-copy,.product-010-page .feature-section>img,.product-010-page .audience-grid>div{min-width:0}
  .product-010-page .product-hero{padding-top:24px}.product-010-page .hero-grid{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:30px;align-items:center;margin-top:28px}.product-010-page .hero-copy{padding:32px 0 40px}.product-010-page .hero-copy h1{font-size:clamp(2.5rem,6vw,5.25rem);margin:14px 0 20px;letter-spacing:-.055em;line-height:.96}.product-010-page .hero-message{color:var(--p-ink);font-size:clamp(1.65rem,3.3vw,3rem);line-height:1.02;letter-spacing:-.045em;font-weight:820;margin:0 0 22px}.product-010-page .hero-copy .lead{max-width:620px;font-size:1.18rem;line-height:1.65;color:var(--p-muted)}.product-010-page .hero-art img{width:100%;display:block;border-radius:18px;box-shadow:0 18px 50px rgba(16,43,59,.18)}.product-010-page .eyebrow{color:var(--p-teal);font-size:.79rem;font-weight:850;letter-spacing:.13em;line-height:1.35}.product-010-page .proof-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:20px}.product-010-page .proof-strip div{display:grid;gap:5px;padding:18px;background:var(--card)}.product-010-page .proof-strip span,.product-010-page .problem-card p,.product-010-page .feature-copy p,.product-010-page .audience-grid p,.product-010-page .bridge-section p,.product-010-page .privacy-section p,.product-010-page .disclaimer-section p{color:var(--p-muted);line-height:1.65}.product-010-page .problem-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}.product-010-page .problem-card{padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--card);box-shadow:var(--shadow-soft)}.product-010-page .problem-card span{color:var(--p-gold);font-weight:850}.product-010-page .problem-card h3{margin:16px 0 8px}.product-010-page .feature-section{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:32px;align-items:center}.product-010-page .feature-section.reverse{grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr)}.product-010-page .feature-section.reverse .feature-copy{order:2}.product-010-page .feature-section img{width:100%;max-width:520px;justify-self:center;border-radius:18px;box-shadow:0 16px 38px rgba(16,43,59,.14)}.product-010-page .gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.product-010-page .gallery-grid figure{margin:0;display:grid;gap:8px}.product-010-page .gallery-grid img{width:100%;border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow-soft)}.product-010-page .gallery-grid figcaption{color:var(--p-muted);font-size:.85rem}.product-010-page .audience-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.product-010-page .audience-grid>div{padding:25px;border:1px solid var(--line);border-radius:14px;background:var(--card)}.product-010-page .not-for{background:linear-gradient(135deg,var(--p-mint),var(--card))!important}.product-010-page .check-list{display:grid;gap:10px;padding-left:1.25rem;color:var(--p-muted);line-height:1.5}.product-010-page .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;padding:0;list-style:none;counter-reset:step}.product-010-page .steps li{counter-increment:step;display:grid;gap:8px;padding:20px;border-top:4px solid var(--p-teal);border-radius:10px;background:var(--card);box-shadow:var(--shadow-soft)}.product-010-page .steps li::before{content:'0' counter(step);color:var(--p-gold);font-weight:850}.product-010-page .steps span{color:var(--p-muted);line-height:1.5;font-size:.93rem}.product-010-page .bridge-section,.product-010-page .final-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:28px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--p-mint),var(--card))}.product-010-page .bridge-section h2,.product-010-page .final-cta h2{margin:8px 0}.product-010-page .privacy-section{border-left:5px solid var(--p-teal);padding-left:24px}.product-010-page .privacy-badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.product-010-page .privacy-badges span{padding:8px 11px;border-radius:999px;background:var(--p-mint);color:var(--p-ink);font-size:.78rem;font-weight:850;letter-spacing:.04em}.product-010-page .final-cta{display:block;text-align:center;margin-bottom:44px}.product-010-page .final-cta .cta-row{justify-content:center}.product-010-page .final-cta>p:last-child{color:var(--p-muted);margin:16px 0 0}.product-010-page .is-pending{opacity:.74;cursor:not-allowed}
  @media(max-width:900px){.product-010-page .hero-grid,.product-010-page .feature-section,.product-010-page .feature-section.reverse{grid-template-columns:1fr}.product-010-page .feature-section.reverse .feature-copy{order:0}.product-010-page .feature-section img{max-width:520px}.product-010-page .proof-strip,.product-010-page .problem-grid,.product-010-page .steps{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:680px){.product-010-page .proof-strip,.product-010-page .problem-grid,.product-010-page .audience-grid,.product-010-page .steps{grid-template-columns:1fr}.product-010-page .gallery-grid{grid-template-columns:repeat(2,1fr)}.product-010-page .bridge-section{display:block}.product-010-page .bridge-section .btn{margin-top:12px}.product-010-page .final-cta .cta-row .btn{width:100%}}
</style>
