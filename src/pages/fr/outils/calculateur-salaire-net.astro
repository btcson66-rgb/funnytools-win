---
import NetSalary from '../../../components/tools/NetSalary.astro';
import ExpansionToolLayout from '../../../layouts/ExpansionToolLayout.astro';
import {
  frenchNetSalary,
  frenchNetSalaryReview,
} from '../../../i18n/expansion/fr-tools-20';
---

<ExpansionToolLayout
  routeKey="net-salary"
  canonicalPath="/fr/outils/calculateur-salaire-net/"
  locale="fr"
  content={frenchNetSalary}
  categoryLabel="Salaire et travail"
  review={frenchNetSalaryReview}
  relatedTool={{
    name: 'Calculateur d’heures supplémentaires',
    description: 'Décomposez les heures et coefficients avant de les additionner.',
    href: '/fr/outils/calculateur-heures-supplementaires/',
  }}
>
  <NetSalary labels={frenchNetSalary.labels} />
</ExpansionToolLayout>
