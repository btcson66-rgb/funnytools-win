---
import Stopwatch from '../../../components/tools/Stopwatch.astro';
import ExpansionToolLayout from '../../../layouts/ExpansionToolLayout.astro';
import {
  frenchStopwatch,
  frenchStopwatchReview,
} from '../../../i18n/expansion/fr-tools-18';
---

<ExpansionToolLayout
  routeKey="stopwatch"
  canonicalPath="/fr/outils/chronometre-en-ligne/"
  content={frenchStopwatch}
  categoryLabel="Temps et organisation"
  review={frenchStopwatchReview}
  locale="fr"
  relatedTool={{
    name: 'Minuteur en ligne',
    description: 'Lancez un compte à rebours lorsque vous connaissez la durée ou l’échéance à atteindre.',
    href: '/fr/outils/minuteur-en-ligne/',
  }}
>
  <Stopwatch labels={frenchStopwatch.labels} />
</ExpansionToolLayout>
