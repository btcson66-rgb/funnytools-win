---
import { SITE } from '../config/site';
import { removedRedirects } from '../data/removedRedirects';

// Redirect stubs for removed URLs that map onto a retained page (see
// src/data/removedRedirects.ts). Every other removed URL is simply a 404.
export function getStaticPaths() {
  return removedRedirects.map(({ from, to }) => ({
    params: { removed: from.replace(/^\/|\/$/g, '') },
    props: { to },
  }));
}

const { to } = Astro.props as { to: string };
const fullUrl = `${SITE.url}${to}`;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={fullUrl} />
  <meta http-equiv="refresh" content={`0; url=${to}`} />
  <meta name="robots" content="noindex,follow" />
  <title>Redirecting...</title>
</head>
<body>
  <p>Redirecting to <a href={to}>{fullUrl}</a>.</p>
</body>
</html>
